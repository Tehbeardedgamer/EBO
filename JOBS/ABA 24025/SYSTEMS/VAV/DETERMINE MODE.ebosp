NUMERIC INPUT OCC_C_SP, OCC_H_SP,UNOCC_C_SP, UNOCC_H_SP, OCC_DB,UNOCC_DB, SPACE_TEMP, OCCUPIED,UNOCC_CO2_SP, OCC_CO2_SP, SPACE_CO2
NUMERIC OUTPUT COOLING_SP, HEATING_SP, CO2_SP
STRING OUTPUT MODE
GOTO DETERMINE_MODE

' Determine the operating mode based on current conditions
DETERMINE_MODE:
WHILE OCCUPIED  = TRUE
COOLING_SP = OCC_C_SP + OCC_DB
HEATING_SP = OCC_H_SP - OCC_DB
WAIT 10
SELECT CASE TRUE
    CASE ((SPACE_TEMP < COOLING_SP) & (SPACE_TEMP > HEATING_SP) & (SPACE_CO2 < OCC_CO2_SP))
        MODE = "SATISFIED"
    
    CASE ((SPACE_TEMP > COOLING_SP) OR (SPACE_TEMP < HEATING_SP) AND (SPACE_CO2 < OCC_CO2_SP))
        MODE = "TEMPATURE CONTROL"

		CASE  (SPACE_CO2 > CO2_SP)
        MODE = "CO2 CONTROL"
    CASE ELSE
        MODE = "IDLE"
ENDSELECT
ENDWHILE


WHILE OCCUPIED = FALSE
COOLING_SP = UNOCC_C_SP + UNOCC_DB
HEATING_SP = UNOCC_H_SP - UNOCC_DB
WAIT 10
SELECT CASE TRUE
    CASE ((SPACE_TEMP < COOLING_SP) & (SPACE_TEMP > HEATING_SP) & (SPACE_CO2 < UNOCC_CO2_SP))
        MODE = "SATISFIED"
    
    CASE ((SPACE_TEMP > COOLING_SP) OR (SPACE_TEMP < HEATING_SP) AND (SPACE_CO2 < UNOCC_CO2_SP))
        MODE = "TEMPATURE CONTROL"

		CASE  (SPACE_CO2 > CO2_SP)
        MODE = "CO2 CONTROL"
    CASE ELSE
        MODE = "IDLE"
ENDSELECT
ENDWHILE


'==============================================================================
' AHU_HUMIDITY_CONTROL
'
' PURPOSE:
'   Modulate the humidification valve to maintain return air humidity and issue
'   humidifier enable command when permitted.
'
' SEQUENCE:
'   - In occupied normal mode, humidifier may enable and the humidity valve
'     modulates to maintain RH_SP.
'   - In dehumidification mode, MAT low protection, smoke override, safety
'     shutdown, OAT lockout, unoccupied mode, or system disable, humidifier is
'     disabled and valve goes to HUM_VALVE_OFF_POS.
'   - If humidifier low-pressure safety is active, humidifier is disabled and
'     valve goes to HUM_VALVE_OFF_POS.
'
' NOTES:
'   - This script does not own alarms.
'   - PIDControl function is assumed to already exist in the project.
'   - PID output is expected to be 0-100%.
'==============================================================================

'-----------------------------
' FUNCTIONS
'-----------------------------
FUNCTION PIDControl

'-----------------------------
' MODE INPUTS
'-----------------------------
NUMERIC INPUT UNIT_AVAILABLE
NUMERIC INPUT OCC_MODE
NUMERIC INPUT UNOCC_MODE
NUMERIC INPUT DEHUM_ENABLE
NUMERIC INPUT SMOKE_OVERRIDE
NUMERIC INPUT SAFETY_LOCKOUT
NUMERIC INPUT MAT_LOW
NUMERIC INPUT HUM_ENABLE_PERMIT

'-----------------------------
' PROCESS INPUTS
'-----------------------------
NUMERIC INPUT RA_HUMIDITY
NUMERIC INPUT RH_SP
NUMERIC INPUT OA_TEMP

'-----------------------------
' HARDWIRED / SAFETY INPUTS
'-----------------------------
NUMERIC INPUT HUMDIFIER_LP_SAFETY
NUMERIC INPUT HUMIDIFIER_ENABLE_CMD

'-----------------------------
' ADJUSTABLE INPUTS
'-----------------------------
NUMERIC INPUT HUM_PID_P
NUMERIC INPUT HUM_PID_I
NUMERIC INPUT HUM_PID_D
NUMERIC INPUT HUM_VALVE_MIN_POS
NUMERIC INPUT HUM_VALVE_MAX_POS
NUMERIC INPUT HUM_VALVE_OFF_POS
NUMERIC INPUT HUM_ENABLE_ON_POS
NUMERIC INPUT HUM_OAT_LOCKOUT_SP

'-----------------------------
' OUTPUTS
'-----------------------------
NUMERIC OUTPUT HUMIDITY_VALVE_CMD
NUMERIC OUTPUT HUMIDIFIER_ENABLE
NUMERIC OUTPUT HUM_VALVE_PID_OUT
NUMERIC OUTPUT HUM_MODE_CODE

'-----------------------------
' INTERNAL VARIABLES
'-----------------------------
NUMERIC HUM_PID_I_TERM
NUMERIC HUM_PID_OLD_ERR
NUMERIC HUM_ACTIVE_CMD

'==============================================================================
' DEFAULTS EACH PASS
'==============================================================================

HUM_ACTIVE_CMD = HUM_VALVE_OFF_POS
HUMIDIFIER_ENABLE = 0
HUM_VALVE_PID_OUT = 0
HUM_MODE_CODE = 0

'==============================================================================
' MODE-BASED COMMAND SELECTION
' PRIORITY:
'   1. SAFETY LOCKOUT
'   2. SMOKE OVERRIDE
'   3. MAT LOW PROTECTION
'   4. DEHUMIDIFICATION
'   5. OAT LOCKOUT
'   6. DISABLED / UNOCCUPIED
'   7. LP SAFETY
'   8. OCCUPIED NORMAL HUMIDITY CONTROL
'==============================================================================

IF SAFETY_LOCKOUT = 1 THEN
  HUM_ACTIVE_CMD = HUM_VALVE_OFF_POS
  HUMIDIFIER_ENABLE = 0
  HUM_MODE_CODE = 6
ENDIF

IF SAFETY_LOCKOUT = 0 THEN

  IF SMOKE_OVERRIDE = 1 THEN
    HUM_ACTIVE_CMD = HUM_VALVE_OFF_POS
    HUMIDIFIER_ENABLE = 0
    HUM_MODE_CODE = 5
  ENDIF

  IF SMOKE_OVERRIDE = 0 THEN

    IF MAT_LOW = 1 THEN
      HUM_ACTIVE_CMD = HUM_VALVE_OFF_POS
      HUMIDIFIER_ENABLE = 0
      HUM_MODE_CODE = 4
    ENDIF

    IF MAT_LOW = 0 THEN

      IF DEHUM_ENABLE = 1 THEN
        HUM_ACTIVE_CMD = HUM_VALVE_OFF_POS
        HUMIDIFIER_ENABLE = 0
        HUM_MODE_CODE = 3
      ENDIF

      IF DEHUM_ENABLE = 0 THEN

        IF OA_TEMP > HUM_OAT_LOCKOUT_SP THEN
          HUM_ACTIVE_CMD = HUM_VALVE_OFF_POS
          HUMIDIFIER_ENABLE = 0
          HUM_MODE_CODE = 8
        ENDIF

        IF OA_TEMP <= HUM_OAT_LOCKOUT_SP THEN

          IF UNIT_AVAILABLE = 0 THEN
            HUM_ACTIVE_CMD = HUM_VALVE_OFF_POS
            HUMIDIFIER_ENABLE = 0
            HUM_MODE_CODE = 0
          ENDIF

          IF UNIT_AVAILABLE = 1 THEN

            IF UNOCC_MODE = 1 THEN
              HUM_ACTIVE_CMD = HUM_VALVE_OFF_POS
              HUMIDIFIER_ENABLE = 0
              HUM_MODE_CODE = 0
            ENDIF

            IF UNOCC_MODE = 0 THEN

              IF HUMDIFIER_LP_SAFETY = 1 THEN
                HUM_ACTIVE_CMD = HUM_VALVE_OFF_POS
                HUMIDIFIER_ENABLE = 0
                HUM_MODE_CODE = 7
              ENDIF

              IF HUMDIFIER_LP_SAFETY = 0 THEN

                IF OCC_MODE = 1 THEN
                  IF HUM_ENABLE_PERMIT = 1 THEN
                    IF HUMIDIFIER_ENABLE_CMD = 1 THEN
                      HUM_VALVE_PID_OUT = PIDControl(1, RA_HUMIDITY, RH_SP, HUM_PID_I_TERM, HUM_PID_P, HUM_PID_I, HUM_PID_D, HUM_PID_OLD_ERR)
                      HUM_ACTIVE_CMD = HUM_VALVE_PID_OUT
                      HUM_MODE_CODE = 1
                    ENDIF
                  ENDIF
                ENDIF

                IF OCC_MODE = 0 THEN
                  HUM_ACTIVE_CMD = HUM_VALVE_OFF_POS
                  HUMIDIFIER_ENABLE = 0
                  HUM_MODE_CODE = 0
                ENDIF

              ENDIF

            ENDIF

          ENDIF

        ENDIF

      ENDIF

    ENDIF

  ENDIF

ENDIF

'==============================================================================
' NORMAL CONTROL CLAMPS
'==============================================================================

IF HUM_MODE_CODE = 1 THEN

  IF HUM_ACTIVE_CMD < HUM_VALVE_MIN_POS THEN
    HUM_ACTIVE_CMD = HUM_VALVE_MIN_POS
  ENDIF

  IF HUM_ACTIVE_CMD > HUM_VALVE_MAX_POS THEN
    HUM_ACTIVE_CMD = HUM_VALVE_MAX_POS
  ENDIF

ENDIF

'==============================================================================
' FINAL OUTPUT CLAMPS
'==============================================================================

IF HUM_ACTIVE_CMD < 0 THEN
  HUM_ACTIVE_CMD = 0
ENDIF

IF HUM_ACTIVE_CMD > 100 THEN
  HUM_ACTIVE_CMD = 100
ENDIF

'==============================================================================
' HUMIDIFIER ENABLE LOGIC
'==============================================================================

IF HUM_MODE_CODE = 1 THEN
  IF HUM_ACTIVE_CMD >= HUM_ENABLE_ON_POS THEN
    HUMIDIFIER_ENABLE = 1
  ENDIF

  IF HUM_ACTIVE_CMD < HUM_ENABLE_ON_POS THEN
    HUMIDIFIER_ENABLE = 0
  ENDIF
ENDIF

'==============================================================================
' FINAL OUTPUTS
'==============================================================================

HUMIDITY_VALVE_CMD = HUM_ACTIVE_CMD

WAIT 1
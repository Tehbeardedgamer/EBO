'======================================================================
'  PROGRAM: DOAS_CRITICAL_DAMPER_TRACK
'  PURPOSE: Determine the highest (worst-case) enabled damper position
'           across all OVAVs and regular VAVs, and expose which one is
'           driving the static pressure reset.
'
'  FEATURES:
'   - Per-terminal enable flags (1=include, 0=exclude)
'   - Tracks OVAV group max and VAV group max
'   - Tracks overall critical position and an ID for graphics
'
'  OUTPUTS:
'   - CRITICAL_DMP_POS   (%)
'   - CRITICAL_ID        (numeric mapping below)
'   - CRITICAL_GROUP     (1=OVAV, 2=VAV)
'   - OVAV_CRITICAL_POS  (%)
'   - VAV_CRITICAL_POS   (%)
'
'  ID MAPPING:
'   1..22  = OVAV list (in order shown below)
'   23..31 = VAV  list (in order shown below)
'======================================================================

'====================== OVAV DAMPER POSITIONS (% OPEN) =================
NUMERIC INPUT OVAV_12_203
NUMERIC INPUT OVAV_06_205
NUMERIC INPUT OVAV_06_206
NUMERIC INPUT OVAV_08_209
NUMERIC INPUT OVAV_08_215
NUMERIC INPUT OVAV_08_216
NUMERIC INPUT OVAV_05_217
NUMERIC INPUT OVAV_05_218
NUMERIC INPUT OVAV_05_219
NUMERIC INPUT OVAV_05_220
NUMERIC INPUT OVAV_05_221
NUMERIC INPUT OVAV_05_222
NUMERIC INPUT OVAV_05_223
NUMERIC INPUT OVAV_05_225
NUMERIC INPUT OVAV_05_226
NUMERIC INPUT OVAV_08_228
NUMERIC INPUT OVAV_08_229
NUMERIC INPUT OVAV_05_230
NUMERIC INPUT OVAV_05_235
NUMERIC INPUT OVAV_05_236
NUMERIC INPUT OVAV_05_238
NUMERIC INPUT OVAV_08_240

'====================== VAV DAMPER POSITIONS (% OPEN) ==================
NUMERIC INPUT VAV_08_217
NUMERIC INPUT VAV_08_218
NUMERIC INPUT VAV_06_219
NUMERIC INPUT VAV_06_220
NUMERIC INPUT VAV_08_221
NUMERIC INPUT VAV_08_222
NUMERIC INPUT VAV_08_223
NUMERIC INPUT VAV_06_225
NUMERIC INPUT VAV_06_226

'====================== ENABLE FLAGS (1=INCLUDE / 0=EXCLUDE) ============
NUMERIC INPUT EN_OVAV_12_203
NUMERIC INPUT EN_OVAV_06_205
NUMERIC INPUT EN_OVAV_06_206
NUMERIC INPUT EN_OVAV_08_209
NUMERIC INPUT EN_OVAV_08_215
NUMERIC INPUT EN_OVAV_08_216
NUMERIC INPUT EN_OVAV_05_217
NUMERIC INPUT EN_OVAV_05_218
NUMERIC INPUT EN_OVAV_05_219
NUMERIC INPUT EN_OVAV_05_220
NUMERIC INPUT EN_OVAV_05_221
NUMERIC INPUT EN_OVAV_05_222
NUMERIC INPUT EN_OVAV_05_223
NUMERIC INPUT EN_OVAV_05_225
NUMERIC INPUT EN_OVAV_05_226
NUMERIC INPUT EN_OVAV_08_228
NUMERIC INPUT EN_OVAV_08_229
NUMERIC INPUT EN_OVAV_05_230
NUMERIC INPUT EN_OVAV_05_235
NUMERIC INPUT EN_OVAV_05_236
NUMERIC INPUT EN_OVAV_05_238
NUMERIC INPUT EN_OVAV_08_240

NUMERIC INPUT EN_VAV_08_217
NUMERIC INPUT EN_VAV_08_218
NUMERIC INPUT EN_VAV_06_219
NUMERIC INPUT EN_VAV_06_220
NUMERIC INPUT EN_VAV_08_221
NUMERIC INPUT EN_VAV_08_222
NUMERIC INPUT EN_VAV_08_223
NUMERIC INPUT EN_VAV_06_225
NUMERIC INPUT EN_VAV_06_226

'====================== OUTPUTS ========================================
NUMERIC OUTPUT CRITICAL_DMP_POS      ' overall max damper position (%)
NUMERIC OUTPUT CRITICAL_ID           ' numeric ID (mapping in header)
NUMERIC OUTPUT CRITICAL_GROUP        ' 1=OVAV, 2=VAV

NUMERIC OUTPUT OVAV_CRITICAL_POS     ' max of OVAVs only
NUMERIC OUTPUT VAV_CRITICAL_POS      ' max of VAVs only

'====================== INTERNALS ======================================
NUMERIC POS[31]
NUMERIC i
NUMERIC MAX_ALL, MAX_OVAV, MAX_VAV
NUMERIC MAX_ALL_ID, MAX_OVAV_ID, MAX_VAV_ID

GOTO INIT

INIT:
    CRITICAL_DMP_POS = 0
    CRITICAL_ID = 0
    CRITICAL_GROUP = 0
    OVAV_CRITICAL_POS = 0
    VAV_CRITICAL_POS = 0
    GOTO MAIN

MAIN:
    '----------------- LOAD OVAV POSITIONS WITH ENABLE GATING -----------
    IF EN_OVAV_12_203 = 1 THEN POS[1] = OVAV_12_203 ELSE POS[1] = 0
    IF EN_OVAV_06_205 = 1 THEN POS[2] = OVAV_06_205 ELSE POS[2] = 0
    IF EN_OVAV_06_206 = 1 THEN POS[3] = OVAV_06_206 ELSE POS[3] = 0
    IF EN_OVAV_08_209 = 1 THEN POS[4] = OVAV_08_209 ELSE POS[4] = 0
    IF EN_OVAV_08_215 = 1 THEN POS[5] = OVAV_08_215 ELSE POS[5] = 0
    IF EN_OVAV_08_216 = 1 THEN POS[6] = OVAV_08_216 ELSE POS[6] = 0
    IF EN_OVAV_05_217 = 1 THEN POS[7] = OVAV_05_217 ELSE POS[7] = 0
    IF EN_OVAV_05_218 = 1 THEN POS[8] = OVAV_05_218 ELSE POS[8] = 0
    IF EN_OVAV_05_219 = 1 THEN POS[9] = OVAV_05_219 ELSE POS[9] = 0
    IF EN_OVAV_05_220 = 1 THEN POS[10] = OVAV_05_220 ELSE POS[10] = 0
    IF EN_OVAV_05_221 = 1 THEN POS[11] = OVAV_05_221 ELSE POS[11] = 0
    IF EN_OVAV_05_222 = 1 THEN POS[12] = OVAV_05_222 ELSE POS[12] = 0
    IF EN_OVAV_05_223 = 1 THEN POS[13] = OVAV_05_223 ELSE POS[13] = 0
    IF EN_OVAV_05_225 = 1 THEN POS[14] = OVAV_05_225 ELSE POS[14] = 0
    IF EN_OVAV_05_226 = 1 THEN POS[15] = OVAV_05_226 ELSE POS[15] = 0
    IF EN_OVAV_08_228 = 1 THEN POS[16] = OVAV_08_228 ELSE POS[16] = 0
    IF EN_OVAV_08_229 = 1 THEN POS[17] = OVAV_08_229 ELSE POS[17] = 0
    IF EN_OVAV_05_230 = 1 THEN POS[18] = OVAV_05_230 ELSE POS[18] = 0
    IF EN_OVAV_05_235 = 1 THEN POS[19] = OVAV_05_235 ELSE POS[19] = 0
    IF EN_OVAV_05_236 = 1 THEN POS[20] = OVAV_05_236 ELSE POS[20] = 0
    IF EN_OVAV_05_238 = 1 THEN POS[21] = OVAV_05_238 ELSE POS[21] = 0
    IF EN_OVAV_08_240 = 1 THEN POS[22] = OVAV_08_240 ELSE POS[22] = 0

    '----------------- LOAD VAV POSITIONS WITH ENABLE GATING ------------
    IF EN_VAV_08_217 = 1 THEN POS[23] = VAV_08_217 ELSE POS[23] = 0
    IF EN_VAV_08_218 = 1 THEN POS[24] = VAV_08_218 ELSE POS[24] = 0
    IF EN_VAV_06_219 = 1 THEN POS[25] = VAV_06_219 ELSE POS[25] = 0
    IF EN_VAV_06_220 = 1 THEN POS[26] = VAV_06_220 ELSE POS[26] = 0
    IF EN_VAV_08_221 = 1 THEN POS[27] = VAV_08_221 ELSE POS[27] = 0
    IF EN_VAV_08_222 = 1 THEN POS[28] = VAV_08_222 ELSE POS[28] = 0
    IF EN_VAV_08_223 = 1 THEN POS[29] = VAV_08_223 ELSE POS[29] = 0
    IF EN_VAV_06_225 = 1 THEN POS[30] = VAV_06_225 ELSE POS[30] = 0
    IF EN_VAV_06_226 = 1 THEN POS[31] = VAV_06_226 ELSE POS[31] = 0

    '----------------- CALCULATE GROUP MAXIMA ---------------------------
    MAX_OVAV = 0
    MAX_OVAV_ID = 0
    FOR i = 1 TO 22
        IF POS[i] > MAX_OVAV THEN
            MAX_OVAV = POS[i]
            MAX_OVAV_ID = i
        ENDIF
    NEXT i
    OVAV_CRITICAL_POS = MAX_OVAV

    MAX_VAV = 0
    MAX_VAV_ID = 0
    FOR i = 23 TO 31
        IF POS[i] > MAX_VAV THEN
            MAX_VAV = POS[i]
            MAX_VAV_ID = i
        ENDIF
    NEXT i
    VAV_CRITICAL_POS = MAX_VAV

    '----------------- CALCULATE OVERALL MAX ----------------------------
    MAX_ALL = 0
    MAX_ALL_ID = 0
    FOR i = 1 TO 31
        IF POS[i] > MAX_ALL THEN
            MAX_ALL = POS[i]
            MAX_ALL_ID = i
        ENDIF
    NEXT i

    CRITICAL_DMP_POS = MAX_ALL
    CRITICAL_ID = MAX_ALL_ID

    IF MAX_ALL_ID >= 1 AND MAX_ALL_ID <= 22 THEN
        CRITICAL_GROUP = 1   ' OVAV
    ELSE
        IF MAX_ALL_ID >= 23 AND MAX_ALL_ID <= 31 THEN
            CRITICAL_GROUP = 2   ' VAV
        ELSE
            CRITICAL_GROUP = 0
        ENDIF
    ENDIF

    GOTO MAIN

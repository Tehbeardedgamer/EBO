'==============================================================================
' AHU_MODE_DETERMINATION
'
' PURPOSE:
'   Determine the active operating mode for the AHU and publish clean mode flags
'   for all downstream scripts.
'
' MODES HANDLED:
'   - Safety Shutdown
'   - Smoke Override
'   - System Disabled
'   - Unoccupied
'   - MAT Low Protection
'   - Occupied Normal
'   - Occupied Dehumidification
'
' NOTES:
'   - SYSTEM_ENABLE is the master BAS enable.
'   - OCC_CMD is intended to come from a schedule or operator command.
'   - DEHUM_ENABLE turns on only after RA humidity stays above the high limit
'     for DEHUM_ENABLE_DELAY seconds using SecTimer.
'   - DEHUM_ENABLE turns off when RA humidity falls below DEHUM_LOW_LIMIT.
'   - MAT_LOW turns on at <= 38°F and releases at >= 40°F.
'   - Safety and smoke take priority over all normal operating modes.
'   - MAT low protection has priority over disabled and unoccupied states so the
'     unit can still respond to freeze conditions.
'==============================================================================

'-----------------------------
' FUNCTIONS
'-----------------------------
FUNCTION SecTimer

'-----------------------------
' INPUTS
'-----------------------------
NUMERIC INPUT SYSTEM_ENABLE
NUMERIC INPUT OCC_CMD
NUMERIC INPUT FIRE_ALARM
NUMERIC INPUT SAFETY_SHUTDOWN
NUMERIC INPUT RA_HUMIDITY
NUMERIC INPUT MA_TEMP

'-----------------------------
' ADJUSTABLE INPUTS
'-----------------------------
NUMERIC INPUT DEHUM_HIGH_LIMIT
NUMERIC INPUT DEHUM_LOW_LIMIT
NUMERIC INPUT DEHUM_ENABLE_DELAY
NUMERIC INPUT MAT_LOW_ON_SP
NUMERIC INPUT MAT_LOW_OFF_SP

'-----------------------------
' OUTPUTS
'-----------------------------
NUMERIC OUTPUT UNIT_AVAILABLE
NUMERIC OUTPUT OCC_MODE
NUMERIC OUTPUT UNOCC_MODE
NUMERIC OUTPUT DEHUM_ENABLE
NUMERIC OUTPUT SMOKE_OVERRIDE
NUMERIC OUTPUT SAFETY_LOCKOUT
NUMERIC OUTPUT MAT_LOW
NUMERIC OUTPUT HUM_ENABLE_PERMIT
NUMERIC OUTPUT NORMAL_MODE
NUMERIC OUTPUT MODE_CODE
STRING OUTPUT CURRENT_MODE_TEXT

'-----------------------------
' INTERNAL VARIABLES
'-----------------------------
NUMERIC DEHUM_TIMER
NUMERIC DEHUM_TIMER_DONE
NUMERIC DEHUM_CONDITION


GOTO INI
'-----------------------------
' DEFAULT OUTPUTS
'-----------------------------

INI:
UNIT_AVAILABLE = 0
OCC_MODE = 0
UNOCC_MODE = 0
SMOKE_OVERRIDE = 0
SAFETY_LOCKOUT = 0
NORMAL_MODE = 0
HUM_ENABLE_PERMIT = 0
MODE_CODE = 0
CURRENT_MODE_TEXT = ""
GOTO MAIN

MAIN:
'==============================================================================
' STEP 1 - DETERMINE LATCHED SUB-MODES
'==============================================================================

'-----------------------------
' MAT LOW WITH HYSTERESIS
'-----------------------------
IF MA_TEMP <= MAT_LOW_ON_SP THEN
  MAT_LOW = 1
ENDIF

IF MA_TEMP >= MAT_LOW_OFF_SP THEN
  MAT_LOW = 0
ENDIF

'-----------------------------
' DEHUM ENABLE USING SECTIMER
' Siemens used high humidity timing plus switch thresholds before enabling
' dehumidification mode. This follows that same concept.
'-----------------------------
DEHUM_CONDITION = 0

IF RA_HUMIDITY > DEHUM_HIGH_LIMIT THEN
  DEHUM_CONDITION = 1
ENDIF

DEHUM_TIMER_DONE = SecTimer(DEHUM_CONDITION, DEHUM_ENABLE_DELAY, DEHUM_TIMER)

IF DEHUM_TIMER_DONE = 1 THEN
  DEHUM_ENABLE = 1
ENDIF

IF RA_HUMIDITY < DEHUM_LOW_LIMIT THEN
  DEHUM_ENABLE = 0
ENDIF

'==============================================================================
' STEP 2 - MODE PRIORITY DECISION
'==============================================================================

IF SAFETY_SHUTDOWN = 1 THEN
  SAFETY_LOCKOUT = 1
  SMOKE_OVERRIDE = 0
  UNIT_AVAILABLE = 0
  OCC_MODE = 0
  UNOCC_MODE = 0
  NORMAL_MODE = 0
  HUM_ENABLE_PERMIT = 0
  MODE_CODE = 6
  CURRENT_MODE_TEXT = "SAFETY SHUTDOWN"
  GOTO MODE_DONE
ENDIF

IF FIRE_ALARM = 1 THEN
  SAFETY_LOCKOUT = 0
  SMOKE_OVERRIDE = 1
  UNIT_AVAILABLE = 0
  OCC_MODE = 0
  UNOCC_MODE = 0
  NORMAL_MODE = 0
  HUM_ENABLE_PERMIT = 0
  MODE_CODE = 5
  CURRENT_MODE_TEXT = "SMOKE OVERRIDE"
  GOTO MODE_DONE
ENDIF

IF MAT_LOW = 1 THEN
  SAFETY_LOCKOUT = 0
  SMOKE_OVERRIDE = 0
  UNIT_AVAILABLE = 1
  OCC_MODE = 0
  UNOCC_MODE = 0
  NORMAL_MODE = 0
  HUM_ENABLE_PERMIT = 0
  MODE_CODE = 4
  CURRENT_MODE_TEXT = "FREEZE PROTECTION"
  GOTO MODE_DONE
ENDIF

IF SYSTEM_ENABLE = 0 THEN
  SAFETY_LOCKOUT = 0
  SMOKE_OVERRIDE = 0
  UNIT_AVAILABLE = 0
  OCC_MODE = 0
  UNOCC_MODE = 1
  NORMAL_MODE = 0
  HUM_ENABLE_PERMIT = 0
  MODE_CODE = 0
  CURRENT_MODE_TEXT = "SYSTEM DISABLED"
  GOTO MODE_DONE
ENDIF

IF OCC_CMD = 0 THEN
  SAFETY_LOCKOUT = 0
  SMOKE_OVERRIDE = 0
  UNIT_AVAILABLE = 0
  OCC_MODE = 0
  UNOCC_MODE = 1
  NORMAL_MODE = 0
  HUM_ENABLE_PERMIT = 0
  MODE_CODE = 1
  CURRENT_MODE_TEXT = "UNOCCUPIED"
  GOTO MODE_DONE
ENDIF

IF DEHUM_ENABLE = 1 THEN
  SAFETY_LOCKOUT = 0
  SMOKE_OVERRIDE = 0
  UNIT_AVAILABLE = 1
  OCC_MODE = 1
  UNOCC_MODE = 0
  NORMAL_MODE = 0
  HUM_ENABLE_PERMIT = 0
  MODE_CODE = 3
  CURRENT_MODE_TEXT = "DEHUMIDIFICATION"
  GOTO MODE_DONE
ENDIF

SAFETY_LOCKOUT = 0
SMOKE_OVERRIDE = 0
UNIT_AVAILABLE = 1
OCC_MODE = 1
UNOCC_MODE = 0
NORMAL_MODE = 1
HUM_ENABLE_PERMIT = 1
MODE_CODE = 2
CURRENT_MODE_TEXT = "OCCUPIED NORMAL"

MODE_DONE:

IF SAFETY_LOCKOUT = 1 THEN
  HUM_ENABLE_PERMIT = 0
ENDIF

IF SMOKE_OVERRIDE = 1 THEN
  HUM_ENABLE_PERMIT = 0
ENDIF

IF UNOCC_MODE = 1 THEN
  HUM_ENABLE_PERMIT = 0
ENDIF

IF MAT_LOW = 1 THEN
  HUM_ENABLE_PERMIT = 0
ENDIF

IF DEHUM_ENABLE = 1 THEN
  HUM_ENABLE_PERMIT = 0
ENDIF

WAIT 1
GOTO MAIN
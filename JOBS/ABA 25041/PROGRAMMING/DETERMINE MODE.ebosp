'============================
' Script: AHU_Control
' Purpose: Decide AHU operating mode
'============================

NUMERIC INPUT OCC_MODE, SPACE_TEMP, SPACE_TEMP_SP, SPACE_HUMIDITY, SPACE_HUMIDITY_SP
NUMERIC OUTPUT MODE_COOL, MODE_HEAT, MODE_DEHUM

INI:
  MODE_COOL = 0
  MODE_HEAT = 0
  MODE_DEHUM = 0
  GOTO CONTROL_LOOP

CONTROL_LOOP:

' Reset at start of each cycle
MODE_COOL = 0
MODE_HEAT = 0
MODE_DEHUM = 0

IF OCC_MODE = 0 THEN GOTO UNOCCUPIED

' --- Priority order: Dehum > Cooling > Heating ---
IF SPACE_HUMIDITY > SPACE_HUMIDITY_SP THEN GOTO DEHUMID
IF SPACE_TEMP > SPACE_TEMP_SP THEN GOTO COOLING
IF SPACE_TEMP < SPACE_TEMP_SP THEN GOTO HEATING
GOTO NEUTRAL

'----------------------
DEHUMID:
  MODE_DEHUM = 1
  GOTO ENDLOOP

COOLING:
  MODE_COOL = 1
  GOTO ENDLOOP

HEATING:
  MODE_HEAT = 1
  GOTO ENDLOOP

NEUTRAL:
  MODE_COOL = 0
  MODE_HEAT = 0
  MODE_DEHUM = 0
  GOTO ENDLOOP

UNOCCUPIED:
  MODE_COOL = 0
  MODE_HEAT = 0
  MODE_DEHUM = 0
  GOTO ENDLOOP

ENDLOOP:
WAIT 10
GOTO CONTROL_LOOP

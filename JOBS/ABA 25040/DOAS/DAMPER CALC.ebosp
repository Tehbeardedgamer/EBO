'=========================================================
' DOAS_DAMPER_CONTROLLER_GOLD (PATCHED FOR TRUE DOAS)
'
' PURPOSE:
'   - Control OA and EA dampers for a 100% OA DOAS
'   - Hold minimum ventilation whenever unit is running
'   - Modulate above minimum only when economizer is allowed
'
' IMPORTANT:
'   - No return air damper exists
'   - No mixed air logic
'   - "100% return air" in sequence = economizer disabled
'
'=========================================================

'---------------- INPUTS ----------------
NUMERIC INPUT DOAS_MODE        ' From DETERMINE_MODE
NUMERIC INPUT SAFETY_OK        ' 1=OK, 0=Trip
NUMERIC INPUT FREEZE_LATCH     ' 1=Freeze active

NUMERIC INPUT ECON_AVAILABLE  ' From DETERMINE_ECONOMIZER
NUMERIC INPUT RECOVERY_ENABLE  ' From DETERMINE_ECONOMIZER

NUMERIC INPUT SA_TEMP         ' Supply Air Temp (°F)
NUMERIC INPUT SA_SP           ' Supply Air Temp Setpoint (°F)

'---------------- OUTPUTS ----------------
NUMERIC OUTPUT OA_DAMPER_CMD  ' % to OA damper
NUMERIC OUTPUT EA_DAMPER_CMD  ' % to EA damper
NUMERIC OUTPUT OA_BYPASS_CMD
NUMERIC OUTPUT EA_BYPASS_CMD

'---------------- PUBLIC TUNABLES ----------------
NUMERIC INPUT OA_MIN_POS     ' Minimum OA position (%)
NUMERIC INPUT OA_MAX_POS     ' Maximum OA position (%)
NUMERIC INPUT EA_MIN_POS     ' Minimum EA position (%)
NUMERIC INPUT EA_MAX_POS     ' Maximum EA position (%)

NUMERIC INPUT ECON_GAIN      ' % damper change per °F error
NUMERIC INPUT ECON_DB        ' Deadband around SA_SP (°F)

'---------------- INTERNALS ----------------
NUMERIC ERR
NUMERIC D_MOD

GOTO INIT

'=========================================================
INIT:

OA_DAMPER_CMD = 0
EA_DAMPER_CMD = 0

GOTO MAIN
  
'=========================================================
MAIN:

'---------------------------------------------------------
' 1) HARD OFF / SAFETY
'---------------------------------------------------------
IF (SAFETY_OK = 0) OR (FREEZE_LATCH = 1) THEN
    OA_DAMPER_CMD = 0
    EA_DAMPER_CMD = 0
    WAIT 1
    GOTO MAIN
ENDIF

'---------------------------------------------------------
' 2) UNIT NOT RUNNING
'   (OFF / PRESTART / UNOCC-PROTECT)
'---------------------------------------------------------
IF DOAS_MODE = 0 THEN
    OA_DAMPER_CMD = 0
    EA_DAMPER_CMD = 0
    WAIT 1
    GOTO MAIN
ENDIF

IF DOAS_MODE = 1 THEN
    OA_DAMPER_CMD = 0
    EA_DAMPER_CMD = 0
    WAIT 1
    GOTO MAIN
ENDIF

IF DOAS_MODE = 5 THEN
    OA_DAMPER_CMD = 0
    EA_DAMPER_CMD = 0
    WAIT 1
    GOTO MAIN
ENDIF

'---------------------------------------------------------
' 3) UNIT RUNNING (WARMUP / COOLDOWN / OCCUPIED)
'   ? Hold minimum ventilation by default
'---------------------------------------------------------
OA_DAMPER_CMD = OA_MIN_POS
EA_DAMPER_CMD = EA_MIN_POS

'---------------------------------------------------------
' 4) ECONOMIZER MODULATION (ONLY WHEN AVAILABLE)
'---------------------------------------------------------
IF ECON_AVAILABLE = 1 THEN

    ' Positive error = SA too warm ? need more cooling
    ERR = SA_TEMP - SA_SP

    IF ABS(ERR) <= ECON_DB THEN
        D_MOD = 0
    ELSE
        D_MOD = ERR * ECON_GAIN
    ENDIF

    OA_DAMPER_CMD = OA_MIN_POS + D_MOD
    EA_DAMPER_CMD = EA_MIN_POS + D_MOD

    ' Clamp OA
    IF OA_DAMPER_CMD > OA_MAX_POS THEN OA_DAMPER_CMD = OA_MAX_POS
    IF OA_DAMPER_CMD < OA_MIN_POS THEN OA_DAMPER_CMD = OA_MIN_POS

    ' Clamp EA
    IF EA_DAMPER_CMD > EA_MAX_POS THEN EA_DAMPER_CMD = EA_MAX_POS
    IF EA_DAMPER_CMD < EA_MIN_POS THEN EA_DAMPER_CMD = EA_MIN_POS

ENDIF

'=========================================================
' ENERGY RECOVERY BYPASS DAMPERS
'
' RECOVERY_ENABLE = 1 ? force air through wheel
' RECOVERY_ENABLE = 0 ? bypass wheel
'=========================================================

IF (SAFETY_OK = 0) OR (FREEZE_LATCH = 1) OR (DOAS_MODE = 0) THEN
    OA_BYPASS_CMD = 100     ' Fully open bypass
    EA_BYPASS_CMD = 100
ELSE
    IF RECOVERY_ENABLE = 1 THEN
        OA_BYPASS_CMD = 0   ' Close bypass ? force recovery
        EA_BYPASS_CMD = 0
    ELSE
        OA_BYPASS_CMD = 100 ' Open bypass ? no recovery
        EA_BYPASS_CMD = 100
    ENDIF
ENDIF

WAIT 1
GOTO MAIN
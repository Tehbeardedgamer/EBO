NUMERIC INPUT P_1A_CMD, P_1B_CMD, P_1C_CMD, P_1D_CMD, P_1E_CMD, P_1F_CMD, P_1G_CMD, P_2A_CMD, P_2B_CMD, P_2C_CMD, P_2D_CMD, P_2E_CMD, P_2F_CMD
NUMERIC INPUT P_1A_STATUS, P_1B_STATUS, P_1C_STATUS, P_1D_STATUS, P_1E_STATUS, P_1F_STATUS, P_1G_STATUS, P_2A_STATUS, P_2B_STATUS, P_2C_STATUS, P_2D_STATUS, P_2E_STATUS, P_2F_STATUS
NUMERIC G1CMD[7], G1STATUS[7], G2CMD[3], G2STATUS[3], G3CMD[3], G3STATUS[3]
NUMERIC OUTPUT G1_ALARM, G2_ALARM, G3_ALARM

GOTO WATCHING

WATCHING:
G1CMD[1] = P_1A_CMD
G1CMD[2] = P_1B_CMD
G1CMD[3] = P_1C_CMD
G1CMD[4] = P_1D_CMD
G1CMD[5] = P_1E_CMD
G1CMD[6] = P_1F_CMD
G1CMD[7] = P_1G_CMD
G1STATUS[1] = P_1A_STATUS
G1STATUS[2] = P_1B_STATUS
G1STATUS[3] = P_1C_STATUS
G1STATUS[4] = P_1D_STATUS
G1STATUS[5] = P_1E_STATUS
G1STATUS[6] = P_1F_STATUS
G1STATUS[7] = P_1G_STATUS

G2CMD[1] = P_2A_CMD
G2CMD[2] = P_2B_CMD
G2CMD[3] = P_2C_CMD
G3CMD[1] = P_2D_CMD
G3CMD[2] = P_2E_CMD
G3CMD[3] = P_2F_CMD

G2STATUS[1] = P_2A_STATUS
G2STATUS[2] = P_2B_STATUS
G2STATUS[3] = P_2C_STATUS
G3STATUS[1] = P_2D_STATUS
G3STATUS[2] = P_2E_STATUS
G3STATUS[3] = P_2F_STATUS

'Initialize Alarms to 0
G1_ALARM = 0
G2_ALARM = 0
G3_ALARM = 0

' Check if ALL pumps in G1 have status mismatching command
IF ( (G1CMD[1] ! G1STATUS[1]) & (G1CMD[2] <> G1STATUS[2]) & (G1CMD[3] <> G1STATUS[3]) & (G1CMD[4] <> G1STATUS[4]) & (G1CMD[5] <> G1STATUS[5]) & (G1CMD[6] <> G1STATUS[6]) & (G1CMD[7] <> G1STATUS[7]) ) THEN
    G1_ALARM = 1
ENDIF

' Check if ALL pumps in G2 have status mismatching command
IF ( (G2CMD[1] <> G2STATUS[1]) & (G2CMD[2] <> G2STATUS[2]) & (G2CMD[3] <> G2STATUS[3]) ) THEN
    G2_ALARM = 1
ENDIF

' Check if ALL pumps in G3 have status mismatching command
IF ( (G3CMD[1] <> G3STATUS[1]) & (G3CMD[2] <> G3STATUS[2]) & (G3CMD[3] <> G3STATUS[3]) ) THEN
    G3_ALARM = 1
ENDIF

' Variable Declarations
NUMERIC INPUT HEATING_SP, SPACE_TEMP, OCCUPANCY, RTU_STATUS
NUMERIC OUTPUT SCR_CALC
NUMERIC OLDERR, I_VALVE, PK, IK, DK

FUNCTION PID_VALVE
GOTO INI

INI:
' Initialization
I_VALVE = 0
OLDERR = 0
PK = 1
IK = 0.1
DK = 0.01

GOTO CONTROL_LOOP

CONTROL_LOOP:
' Control Loop
IF (SPACE_TEMP < HEATING_SP) AND OCCUPANCY = 1 AND RTU_STATUS = 1 THEN 
SCR_CALC = PID_VALVE(0, SPACE_TEMP, HEATING_SP, I_VALVE, PK, IK, DK, OLDERR)
ELSE
SCR_CALC = 0
I_VALVE = 0
OLDERR = 0
ENDIF
WAIT 10       



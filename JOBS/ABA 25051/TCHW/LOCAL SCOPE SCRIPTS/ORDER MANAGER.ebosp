'==============================================================================
' ORDER MANAGER - DATE-BASED WEEKLY SEED ROTATION
'
' Responsibilities:
' - Assign pump order 1/2/3 for Pump A/B/C
' - Eligibility = DOWN=0, FAIL=0, INHIBIT=0
' - Preserve running pump order when IGNORE_RUNNING=1
' - Rotate ROTATE_SEED by date every ROTATE_DAYS, default 7 days
' - Optional ROTATE_PULSE remains as a manual one-shot rotation input
'
' Notes:
' - This follows the same Date / LastRotateDT / Difftime(WKD, ...) pattern used
'   in the MAU lead/lag program.
' - ROTATE_SEED only changes the deterministic bias. If IGNORE_RUNNING=1,
'   running pumps keep their current order and the new seed applies to available
'   non-running pumps until the next non-live reorder opportunity.
'==============================================================================

'-----------------------------
' INPUTS
'-----------------------------
NUMERIC INPUT DOWN_A, DOWN_B, DOWN_C
NUMERIC INPUT FAIL_A, FAIL_B, FAIL_C
NUMERIC INPUT INHIBIT_A, INHIBIT_B, INHIBIT_C
NUMERIC INPUT STS_A, STS_B, STS_C
NUMERIC INPUT RT_A, RT_B, RT_C
NUMERIC INPUT ROTATE_PULSE          ' Optional manual one-shot rotation pulse

'-----------------------------
' OUTPUTS
'-----------------------------
NUMERIC OUTPUT PUMP_1
NUMERIC OUTPUT PUMP_2
NUMERIC OUTPUT PUMP_3
NUMERIC OUTPUT PUMPS_AVAIL

'-----------------------------
' PUBLICS
'-----------------------------
NUMERIC PUBLIC IGNORE_RUNNING       ' 1 = do not reshuffle live pumps; default 1
NUMERIC PUBLIC AUTO_ROTATE_ENABLE   ' 1 = use date-based auto seed rotation
NUMERIC PUBLIC ROTATE_DAYS          ' default 7 days
NUMERIC PUBLIC ROTATE_SEED          ' 0..2 bias seed
NUMERIC PUBLIC ROTATE_EVENT         ' 1 for one scan when seed rotates
NUMERIC PUBLIC DAYS_SINCE_ROTATE    ' diagnostic date delta
DATETIME PUBLIC LastRotateDT

'-----------------------------
' INTERNAL ARRAYS/VARS
'-----------------------------
NUMERIC DOWN[3]
NUMERIC FAIL[3]
NUMERIC INH[3]
NUMERIC STS[3]
NUMERIC RT[3]

NUMERIC ELIGIBLE[3]
NUMERIC isLocked[3]
NUMERIC USED[4]
NUMERIC BIAS[3]
NUMERIC PRIORITY[3]
NUMERIC ORDER[3]
NUMERIC ORDER_PREV[3]

NUMERIC FIRST_INIT_DONE
NUMERIC BIG
NUMERIC i
NUMERIC MIN_IDX
NUMERIC MIN_VAL
NUMERIC AVAILABLE_COUNT
NUMERIC NEXT_ORDER
NUMERIC ROTATE_PULSE_LAST

GOTO INIT

'==============================================================================
INIT:
'==============================================================================

    IF FIRST_INIT_DONE = 0 THEN
        IF ROTATE_SEED < 0 THEN ROTATE_SEED = 0
        IF ROTATE_SEED > 2 THEN ROTATE_SEED = 0
        IF IGNORE_RUNNING <= 0 THEN IGNORE_RUNNING = 1
        IF AUTO_ROTATE_ENABLE <= 0 THEN AUTO_ROTATE_ENABLE = 1
        IF ROTATE_DAYS <= 0 THEN ROTATE_DAYS = 7

        LastRotateDT = Date
        DAYS_SINCE_ROTATE = 0
        ROTATE_EVENT = 0
        ROTATE_PULSE_LAST = 0

        PUMP_1 = 0
        PUMP_2 = 0
        PUMP_3 = 0
        PUMPS_AVAIL = 0

        FOR i = 1 TO 3
            ORDER_PREV[i] = 0
        NEXT i

        FIRST_INIT_DONE = 1
    ENDIF

    GOTO LOOP

'==============================================================================
LOOP:
'==============================================================================

    '-----------------------------
    ' Load inputs: 1=A, 2=B, 3=C
    '-----------------------------
    DOWN[1] = DOWN_A
    DOWN[2] = DOWN_B
    DOWN[3] = DOWN_C

    FAIL[1] = FAIL_A
    FAIL[2] = FAIL_B
    FAIL[3] = FAIL_C

    INH[1] = INHIBIT_A
    INH[2] = INHIBIT_B
    INH[3] = INHIBIT_C

    STS[1] = STS_A
    STS[2] = STS_B
    STS[3] = STS_C

    RT[1] = RT_A
    RT[2] = RT_B
    RT[3] = RT_C

    '-----------------------------
    ' Date-based seed rotation
    '-----------------------------
    IF ROTATE_DAYS <= 0 THEN ROTATE_DAYS = 7

    ROTATE_EVENT = 0
    DAYS_SINCE_ROTATE = Difftime(WKD, LastRotateDT, Date)

    IF AUTO_ROTATE_ENABLE is ON THEN
        IF DAYS_SINCE_ROTATE >= ROTATE_DAYS THEN
            ROTATE_EVENT = 1
            LastRotateDT = Date
            DAYS_SINCE_ROTATE = 0
        ENDIF
    ENDIF

    ' Optional manual pulse. Edge-detected so a stuck ON pulse does not rotate
    ' the seed every scan.
    IF ROTATE_PULSE = 1 THEN
        IF ROTATE_PULSE_LAST = 0 THEN
            ROTATE_EVENT = 1
            LastRotateDT = Date
            DAYS_SINCE_ROTATE = 0
        ENDIF
    ENDIF

    ROTATE_PULSE_LAST = ROTATE_PULSE

    IF ROTATE_EVENT = 1 THEN
        ROTATE_SEED = ROTATE_SEED + 1
        IF ROTATE_SEED > 2 THEN ROTATE_SEED = 0
    ENDIF

    IF ROTATE_SEED < 0 THEN ROTATE_SEED = 0
    IF ROTATE_SEED > 2 THEN ROTATE_SEED = 0

    '-----------------------------
    ' Deterministic seed bias
    '-----------------------------
    IF ROTATE_SEED = 0 THEN
        BIAS[1] = 0.000
        BIAS[2] = 0.001
        BIAS[3] = 0.002
    ELSE
        IF ROTATE_SEED = 1 THEN
            BIAS[1] = 0.001
            BIAS[2] = 0.002
            BIAS[3] = 0.000
        ELSE
            BIAS[1] = 0.002
            BIAS[2] = 0.000
            BIAS[3] = 0.001
        ENDIF
    ENDIF

    '-----------------------------
    ' Eligibility
    '-----------------------------
    AVAILABLE_COUNT = 0

    FOR i = 1 TO 3
        ELIGIBLE[i] = 1
        IF DOWN[i] = 1 THEN ELIGIBLE[i] = 0
        IF FAIL[i] = 1 THEN ELIGIBLE[i] = 0
        IF INH[i] = 1 THEN ELIGIBLE[i] = 0
        IF ELIGIBLE[i] = 1 THEN AVAILABLE_COUNT = AVAILABLE_COUNT + 1
    NEXT i

    PUMPS_AVAIL = AVAILABLE_COUNT

    '-----------------------------
    ' Clear working arrays
    '-----------------------------
    FOR i = 1 TO 3
        ORDER[i] = 0
        USED[i] = 0
        isLocked[i] = 0
    NEXT i

    USED[4] = 0

    '-----------------------------
    ' Lock current orders for eligible running pumps when requested
    '-----------------------------
    IF IGNORE_RUNNING = 1 THEN
        FOR i = 1 TO 3
            IF ELIGIBLE[i] = 1 THEN
                IF STS[i] = 1 THEN
                    isLocked[i] = 1
                    ORDER[i] = ORDER_PREV[i]
                    IF ORDER[i] < 1 THEN ORDER[i] = 1
                    IF ORDER[i] > 3 THEN ORDER[i] = 3
                    USED[ORDER[i]] = 1
                ENDIF
            ENDIF
        NEXT i
    ENDIF

    '-----------------------------
    ' Build priorities for eligible unlocked candidates
    '-----------------------------
    BIG = 9999999

    FOR i = 1 TO 3
        PRIORITY[i] = BIG
        IF ELIGIBLE[i] = 1 THEN
            IF isLocked[i] = 0 THEN
                IF IGNORE_RUNNING = 1 THEN
                    IF STS[i] = 0 THEN
                        PRIORITY[i] = RT[i] + BIAS[i]
                    ENDIF
                ELSE
                    PRIORITY[i] = RT[i] + BIAS[i]
                ENDIF
            ENDIF
        ENDIF
    NEXT i

    '-----------------------------
    ' Pick best unlocked candidate for next free order slot - pass 1
    '-----------------------------
    MIN_IDX = 0
    MIN_VAL = BIG

    FOR i = 1 TO 3
        IF PRIORITY[i] < MIN_VAL THEN
            MIN_VAL = PRIORITY[i]
            MIN_IDX = i
        ENDIF
    NEXT i

    IF MIN_IDX > 0 THEN
        NEXT_ORDER = 0
        IF USED[1] = 0 THEN NEXT_ORDER = 1
        IF NEXT_ORDER = 0 THEN
            IF USED[2] = 0 THEN NEXT_ORDER = 2
        ENDIF
        IF NEXT_ORDER = 0 THEN
            IF USED[3] = 0 THEN NEXT_ORDER = 3
        ENDIF
        IF NEXT_ORDER > 0 THEN
            ORDER[MIN_IDX] = NEXT_ORDER
            USED[NEXT_ORDER] = 1
            PRIORITY[MIN_IDX] = BIG
        ENDIF
    ENDIF

    '-----------------------------
    ' Pick best unlocked candidate for next free order slot - pass 2
    '-----------------------------
    MIN_IDX = 0
    MIN_VAL = BIG

    FOR i = 1 TO 3
        IF PRIORITY[i] < MIN_VAL THEN
            MIN_VAL = PRIORITY[i]
            MIN_IDX = i
        ENDIF
    NEXT i

    IF MIN_IDX > 0 THEN
        NEXT_ORDER = 0
        IF USED[1] = 0 THEN NEXT_ORDER = 1
        IF NEXT_ORDER = 0 THEN
            IF USED[2] = 0 THEN NEXT_ORDER = 2
        ENDIF
        IF NEXT_ORDER = 0 THEN
            IF USED[3] = 0 THEN NEXT_ORDER = 3
        ENDIF
        IF NEXT_ORDER > 0 THEN
            ORDER[MIN_IDX] = NEXT_ORDER
            USED[NEXT_ORDER] = 1
            PRIORITY[MIN_IDX] = BIG
        ENDIF
    ENDIF

    '-----------------------------
    ' Pick best unlocked candidate for next free order slot - pass 3
    '-----------------------------
    MIN_IDX = 0
    MIN_VAL = BIG

    FOR i = 1 TO 3
        IF PRIORITY[i] < MIN_VAL THEN
            MIN_VAL = PRIORITY[i]
            MIN_IDX = i
        ENDIF
    NEXT i

    IF MIN_IDX > 0 THEN
        NEXT_ORDER = 0
        IF USED[1] = 0 THEN NEXT_ORDER = 1
        IF NEXT_ORDER = 0 THEN
            IF USED[2] = 0 THEN NEXT_ORDER = 2
        ENDIF
        IF NEXT_ORDER = 0 THEN
            IF USED[3] = 0 THEN NEXT_ORDER = 3
        ENDIF
        IF NEXT_ORDER > 0 THEN
            ORDER[MIN_IDX] = NEXT_ORDER
            USED[NEXT_ORDER] = 1
            PRIORITY[MIN_IDX] = BIG
        ENDIF
    ENDIF

    '-----------------------------
    ' Push outputs
    '-----------------------------
    PUMP_1 = ORDER[1]
    PUMP_2 = ORDER[2]
    PUMP_3 = ORDER[3]

    '-----------------------------
    ' Remember for next scan
    '-----------------------------
    FOR i = 1 TO 3
        ORDER_PREV[i] = ORDER[i]
    NEXT i

    WAIT 2
    GOTO LOOP

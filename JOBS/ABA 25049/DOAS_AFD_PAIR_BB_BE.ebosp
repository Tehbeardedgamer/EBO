'==============================================================================
' DOAS_AFD_PAIR_BB_BE
'
' PURPOSE
'   Control one OA / EA airflow damper pair.
'
' PAIRING
'   AFD-N4BB -> AFD-N4BE
'
' SOO REQUIREMENTS COVERED
'   - OA AFD maintains worst-case CO2 or TVOC demand for the served area
'   - EA AFD tracks the paired OA airflow at adjustable ratio / offset
'   - Max ventilation override drives the pair to maximum airflow for 20 minutes
'   - Building pressure high limit forces EA tracking to relief ratio after delay
'   - If EA fan is at minimum and building pressure stays low for delay period,
'     this script requests exhaust stop
'
' NOTES
'   - Bind the correct area building pressure sensor to BLDG_PRS.
'   - Bind the correct zone exhaust-fan count to EXH_FAN_COUNT_ZONE if used.
'   - Unused future sensor inputs may remain at 0.
'   - Final authority remains in DOAS_MASTER_CONTROL.
'==============================================================================

NUMERIC INPUT UNIT_ENABLE
NUMERIC INPUT OCCUPIED_REQ
NUMERIC INPUT MAX_VENT_OVRD

NUMERIC INPUT BLDG_PRS
NUMERIC INPUT BLDG_PRS_SP
NUMERIC INPUT BLDG_PRS_DB
NUMERIC INPUT BLDG_PRS_DELAY

NUMERIC INPUT EA_FAN_AT_MIN
NUMERIC INPUT EXH_FAN_COUNT_ZONE

NUMERIC INPUT CO2_SP
NUMERIC INPUT TVOC_SP

NUMERIC INPUT EXH_RATIO_BASE
NUMERIC INPUT EXH_RATIO_MIN
NUMERIC INPUT EXH_RATIO_DECR_PER_FAN
NUMERIC INPUT EXH_RELIEF_RATIO

NUMERIC INPUT OA_AFD_MIN_CMD
NUMERIC INPUT OA_AFD_MAX_CMD
NUMERIC INPUT EA_AFD_MIN_CMD
NUMERIC INPUT EA_AFD_MAX_CMD

NUMERIC INPUT OA_AFD_KP
NUMERIC INPUT OA_AFD_KI
NUMERIC INPUT OA_AFD_KD

NUMERIC INPUT EA_AFD_KP
NUMERIC INPUT EA_AFD_KI
NUMERIC INPUT EA_AFD_KD

NUMERIC INPUT AFD_N4BB_CFM
NUMERIC INPUT AFD_N4BE_CFM

NUMERIC INPUT CO2_1
NUMERIC INPUT CO2_2
NUMERIC INPUT CO2_3
NUMERIC INPUT CO2_4
NUMERIC INPUT CO2_5

NUMERIC INPUT TVOC_1
NUMERIC INPUT TVOC_2
NUMERIC INPUT TVOC_3
NUMERIC INPUT TVOC_4
NUMERIC INPUT TVOC_5

NUMERIC OUTPUT AFD_N4BB_Damper_Cmd
NUMERIC OUTPUT AFD_N4BE_Damper_Cmd
NUMERIC OUTPUT EXH_STOP_REQ
NUMERIC OUTPUT MAX_VENT_ACTIVE

NUMERIC MAX_CO2
NUMERIC MAX_TVOC
NUMERIC CO2_PCT
NUMERIC TVOC_PCT
NUMERIC IAQ_PCT

NUMERIC TRACK_RATIO
NUMERIC EA_TRACK_CFM_SP

NUMERIC PRESSURE_HIGH
NUMERIC PRESSURE_LOW
NUMERIC T_HIGH
NUMERIC T_LOW
NUMERIC DONE_HIGH
NUMERIC DONE_LOW
NUMERIC T_MAX
NUMERIC DONE_MAX

NUMERIC OA_INT
NUMERIC OA_ERR
NUMERIC EA_INT
NUMERIC EA_ERR
NUMERIC OA_OUT
NUMERIC EA_OUT

FUNCTION PIDControl
FUNCTION Sectimer

INIT:
AFD_N4BB_Damper_Cmd = 0
AFD_N4BE_Damper_Cmd = 0
EXH_STOP_REQ = 0
MAX_VENT_ACTIVE = 0

OA_INT = 0
OA_ERR = 0
EA_INT = 0
EA_ERR = 0

GOTO MAIN

MAIN:
AFD_N4BB_Damper_Cmd = 0
AFD_N4BE_Damper_Cmd = 0
EXH_STOP_REQ = 0
MAX_VENT_ACTIVE = 0

IF UNIT_ENABLE = 0 OR OCCUPIED_REQ = 0 THEN
  WAIT 1
  GOTO MAIN
ENDIF

DONE_MAX = Sectimer(MAX_VENT_OVRD, 1200, T_MAX, 0)
IF MAX_VENT_OVRD = 1 THEN MAX_VENT_ACTIVE = 1
IF MAX_VENT_OVRD = 0 THEN
  IF DONE_MAX = 1 THEN
    T_MAX = 0
  ELSE
    IF T_MAX > 0 THEN MAX_VENT_ACTIVE = 1
  ENDIF
ENDIF

MAX_CO2 = CO2_1
IF CO2_2 > MAX_CO2 THEN MAX_CO2 = CO2_2
IF CO2_3 > MAX_CO2 THEN MAX_CO2 = CO2_3
IF CO2_4 > MAX_CO2 THEN MAX_CO2 = CO2_4
IF CO2_5 > MAX_CO2 THEN MAX_CO2 = CO2_5

MAX_TVOC = TVOC_1
IF TVOC_2 > MAX_TVOC THEN MAX_TVOC = TVOC_2
IF TVOC_3 > MAX_TVOC THEN MAX_TVOC = TVOC_3
IF TVOC_4 > MAX_TVOC THEN MAX_TVOC = TVOC_4
IF TVOC_5 > MAX_TVOC THEN MAX_TVOC = TVOC_5

CO2_PCT = 0
TVOC_PCT = 0
IAQ_PCT = 0

IF CO2_SP > 0 THEN CO2_PCT = (MAX_CO2 / CO2_SP) * 100
IF TVOC_SP > 0 THEN TVOC_PCT = (MAX_TVOC / TVOC_SP) * 100

IAQ_PCT = CO2_PCT
IF TVOC_PCT > IAQ_PCT THEN IAQ_PCT = TVOC_PCT

OA_OUT = PIDControl(0, IAQ_PCT, 100, OA_INT, OA_AFD_KP, OA_AFD_KI, OA_AFD_KD, OA_ERR)

IF OA_OUT < OA_AFD_MIN_CMD THEN OA_OUT = OA_AFD_MIN_CMD
IF OA_OUT > OA_AFD_MAX_CMD THEN OA_OUT = OA_AFD_MAX_CMD

IF MAX_VENT_ACTIVE = 1 THEN OA_OUT = OA_AFD_MAX_CMD

AFD_N4BB_Damper_Cmd = OA_OUT

TRACK_RATIO = EXH_RATIO_BASE - (EXH_FAN_COUNT_ZONE * EXH_RATIO_DECR_PER_FAN)
IF TRACK_RATIO < EXH_RATIO_MIN THEN TRACK_RATIO = EXH_RATIO_MIN

PRESSURE_HIGH = 0
PRESSURE_LOW = 0

IF BLDG_PRS > BLDG_PRS_SP + BLDG_PRS_DB THEN PRESSURE_HIGH = 1
IF BLDG_PRS < BLDG_PRS_SP - BLDG_PRS_DB THEN PRESSURE_LOW = 1

DONE_HIGH = Sectimer(PRESSURE_HIGH, BLDG_PRS_DELAY, T_HIGH, 0)
DONE_LOW = Sectimer(PRESSURE_LOW, BLDG_PRS_DELAY, T_LOW, 0)

IF DONE_HIGH = 1 THEN TRACK_RATIO = EXH_RELIEF_RATIO

IF DONE_LOW = 1 THEN
  IF EA_FAN_AT_MIN = 1 THEN
    EXH_STOP_REQ = 1
  ENDIF
ENDIF

EA_TRACK_CFM_SP = AFD_N4BB_CFM * TRACK_RATIO
IF MAX_VENT_ACTIVE = 1 THEN EA_TRACK_CFM_SP = AFD_N4BB_CFM * EXH_RELIEF_RATIO

EA_OUT = PIDControl(0, AFD_N4BE_CFM, EA_TRACK_CFM_SP, EA_INT, EA_AFD_KP, EA_AFD_KI, EA_AFD_KD, EA_ERR)

IF EA_OUT < EA_AFD_MIN_CMD THEN EA_OUT = EA_AFD_MIN_CMD
IF EA_OUT > EA_AFD_MAX_CMD THEN EA_OUT = EA_AFD_MAX_CMD

IF MAX_VENT_ACTIVE = 1 THEN EA_OUT = EA_AFD_MAX_CMD

AFD_N4BE_Damper_Cmd = EA_OUT

WAIT 1
GOTO MAIN

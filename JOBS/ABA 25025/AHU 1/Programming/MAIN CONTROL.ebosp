'==============================================================================
' AHU_FINAL_ARBITER
'
' PURPOSE:
'   Final authority script for AHU outputs and simplified startup sequencing.
'
' FUNCTION:
'   - Receives requested commands from all equipment scripts
'   - Applies final unit-level mode logic
'   - Coordinates startup in stages:
'       1. Command damper
'       2. Verify damper open
'       3. Release requested fan / valve commands
'       4. Release humidifier after additional delay
'   - Sends only final commands to physical outputs
'
' NOTES:
'   - Fixed safe/off values are hardcoded intentionally.
'   - This script does not own alarms.
'   - This script does not prove fans before allowing normal operation.
'   - Individual equipment scripts remain responsible for local clamps and
'     local control behavior.
'==============================================================================

'-----------------------------
' FUNCTIONS
'-----------------------------
FUNCTION SecTimer

'-----------------------------
' MODE INPUTS
'-----------------------------
NUMERIC INPUT UNIT_AVAILABLE
NUMERIC INPUT OCC_MODE
NUMERIC INPUT UNOCC_MODE
NUMERIC INPUT DEHUM_ENABLE
NUMERIC INPUT SMOKE_OVERRIDE
NUMERIC INPUT SAFETY_LOCKOUT
NUMERIC INPUT MAT_LOW

'-----------------------------
' REQUESTED COMMAND INPUTS
'-----------------------------
NUMERIC INPUT MIXING_DAMPER_REQ

NUMERIC INPUT CD_VALVE_REQ
NUMERIC INPUT HD_VALVE_REQ

NUMERIC INPUT HUMIDITY_VALVE_REQ
NUMERIC INPUT HUMIDIFIER_ENABLE_REQ

NUMERIC INPUT CD_FAN_SS_REQ
NUMERIC INPUT CD_FAN_SPEED_REQ

NUMERIC INPUT HD_FAN_SS_REQ
NUMERIC INPUT HD_FAN_SPEED_REQ

NUMERIC INPUT RA_FAN_SS_REQ_1
NUMERIC INPUT RA_FAN_SS_REQ_2
NUMERIC INPUT RA_FAN_SPEED_REQ_1
NUMERIC INPUT RA_FAN_SPEED_REQ_2

'-----------------------------
' FEEDBACK INPUTS
'-----------------------------
NUMERIC INPUT MIXING_DAMPER_FB

'-----------------------------
' STARTUP ADJUSTABLE INPUTS
'-----------------------------
NUMERIC INPUT DAMPER_OPEN_MIN_POS
NUMERIC INPUT DAMPER_PROOF_DELAY_SEC
NUMERIC INPUT HUM_RELEASE_DELAY_SEC

'-----------------------------
' FINAL OUTPUTS
'-----------------------------
NUMERIC OUTPUT MIXING_DAMPER_CMD_FINAL

NUMERIC OUTPUT CD_VALVE_CMD_FINAL
NUMERIC OUTPUT HD_VALVE_CMD_FINAL

NUMERIC OUTPUT HUMIDITY_VALVE_CMD_FINAL
NUMERIC OUTPUT HUMIDIFIER_ENABLE_FINAL

NUMERIC OUTPUT CD_FAN_SS_FINAL
NUMERIC OUTPUT CD_FAN_SPEED_CMD_FINAL

NUMERIC OUTPUT HD_FAN_SS_FINAL
NUMERIC OUTPUT HD_FAN_SPEED_CMD_FINAL

NUMERIC OUTPUT RA_FAN_SS_FINAL_1
NUMERIC OUTPUT RA_FAN_SS_FINAL_2
NUMERIC OUTPUT RA_FAN_SPEED_CMD_FINAL_1
NUMERIC OUTPUT RA_FAN_SPEED_CMD_FINAL_2

NUMERIC OUTPUT ARBITER_MODE_CODE
STRING OUTPUT CURRENT_STAGE_TEXT
NUMERIC OUTPUT CURRENT_STAGE_CODE
NUMERIC OUTPUT STARTUP_ACTIVE
NUMERIC OUTPUT UNIT_STARTED_OUT

'-----------------------------
' INTERNAL VARIABLES
'-----------------------------
NUMERIC DAMPER_PROOF_COND
NUMERIC DAMPER_PROOF_TMR
NUMERIC DAMPER_PROOF_DONE

NUMERIC HUM_RELEASE_COND
NUMERIC HUM_RELEASE_TMR
NUMERIC HUM_RELEASE_DONE

NUMERIC UNIT_STARTED

GOTO INI

'-----------------------------
' INITIALIZATION
'-----------------------------
INI:
MIXING_DAMPER_CMD_FINAL = 0

CD_VALVE_CMD_FINAL = 0
HD_VALVE_CMD_FINAL = 0

HUMIDITY_VALVE_CMD_FINAL = 0
HUMIDIFIER_ENABLE_FINAL = 0

CD_FAN_SS_FINAL = 0
CD_FAN_SPEED_CMD_FINAL = 0

HD_FAN_SS_FINAL = 0
HD_FAN_SPEED_CMD_FINAL = 0

RA_FAN_SS_FINAL_1 = 0
RA_FAN_SS_FINAL_2 = 0
RA_FAN_SPEED_CMD_FINAL_1 = 0
RA_FAN_SPEED_CMD_FINAL_2 = 0

ARBITER_MODE_CODE = 0
CURRENT_STAGE_TEXT = "INIT"
CURRENT_STAGE_CODE = 0
STARTUP_ACTIVE = 0
UNIT_STARTED = 0
UNIT_STARTED_OUT = 0

GOTO MAIN

'==============================================================================
' MAIN DECISION TREE
'==============================================================================
MAIN:

IF SAFETY_LOCKOUT = 1 THEN
  GOTO OFF_STAGE
ENDIF

IF SMOKE_OVERRIDE = 1 THEN
  GOTO SMOKE_STAGE
ENDIF

IF MAT_LOW = 1 THEN
  GOTO FREEZE_STAGE
ENDIF

IF UNIT_AVAILABLE = 0 THEN
  GOTO OFF_STAGE
ENDIF

IF UNOCC_MODE = 1 THEN
  GOTO OFF_STAGE
ENDIF

IF OCC_MODE = 1 THEN

  IF UNIT_STARTED = 1 THEN
    GOTO RUN_STAGE
  ENDIF

  GOTO DAMPER_STAGE
ENDIF

GOTO OFF_STAGE

'==============================================================================
' OFF STAGE
'==============================================================================
OFF_STAGE:
MIXING_DAMPER_CMD_FINAL = 0

CD_VALVE_CMD_FINAL = 0
HD_VALVE_CMD_FINAL = 0

HUMIDITY_VALVE_CMD_FINAL = 0
HUMIDIFIER_ENABLE_FINAL = 0

CD_FAN_SS_FINAL = 0
CD_FAN_SPEED_CMD_FINAL = 0

HD_FAN_SS_FINAL = 0
HD_FAN_SPEED_CMD_FINAL = 0

RA_FAN_SS_FINAL_1 = 0
RA_FAN_SS_FINAL_2 = 0
RA_FAN_SPEED_CMD_FINAL_1 = 0
RA_FAN_SPEED_CMD_FINAL_2 = 0

ARBITER_MODE_CODE = 0
CURRENT_STAGE_TEXT = "OFF"
CURRENT_STAGE_CODE = 0
STARTUP_ACTIVE = 0
UNIT_STARTED = 0
UNIT_STARTED_OUT = 0

DAMPER_PROOF_TMR = 0
HUM_RELEASE_TMR = 0

GOTO FINALIZE

'==============================================================================
' SMOKE STAGE
'==============================================================================
SMOKE_STAGE:
MIXING_DAMPER_CMD_FINAL = 100

CD_VALVE_CMD_FINAL = 0
HD_VALVE_CMD_FINAL = 0

HUMIDITY_VALVE_CMD_FINAL = 0
HUMIDIFIER_ENABLE_FINAL = 0

CD_FAN_SS_FINAL = 0
CD_FAN_SPEED_CMD_FINAL = 0

HD_FAN_SS_FINAL = 1
HD_FAN_SPEED_CMD_FINAL = 100

RA_FAN_SS_FINAL_1 = 0
RA_FAN_SS_FINAL_2 = 0
RA_FAN_SPEED_CMD_FINAL_1 = 0
RA_FAN_SPEED_CMD_FINAL_2 = 0

ARBITER_MODE_CODE = 4
CURRENT_STAGE_TEXT = "SMOKE"
CURRENT_STAGE_CODE = 4
STARTUP_ACTIVE = 0
UNIT_STARTED = 0
UNIT_STARTED_OUT = 0

DAMPER_PROOF_TMR = 0
HUM_RELEASE_TMR = 0

GOTO FINALIZE

'==============================================================================
' FREEZE STAGE
'==============================================================================
FREEZE_STAGE:
MIXING_DAMPER_CMD_FINAL = MIXING_DAMPER_REQ

CD_VALVE_CMD_FINAL = CD_VALVE_REQ
HD_VALVE_CMD_FINAL = HD_VALVE_REQ

HUMIDITY_VALVE_CMD_FINAL = 0
HUMIDIFIER_ENABLE_FINAL = 0

CD_FAN_SS_FINAL = CD_FAN_SS_REQ
CD_FAN_SPEED_CMD_FINAL = CD_FAN_SPEED_REQ

HD_FAN_SS_FINAL = HD_FAN_SS_REQ
HD_FAN_SPEED_CMD_FINAL = HD_FAN_SPEED_REQ

RA_FAN_SS_FINAL_1 = RA_FAN_SS_REQ_1
RA_FAN_SS_FINAL_2 = RA_FAN_SS_REQ_2
RA_FAN_SPEED_CMD_FINAL_1 = RA_FAN_SPEED_REQ_1
RA_FAN_SPEED_CMD_FINAL_2 = RA_FAN_SPEED_REQ_2

ARBITER_MODE_CODE = 3
CURRENT_STAGE_TEXT = "FREEZE"
CURRENT_STAGE_CODE = 3
STARTUP_ACTIVE = 0
UNIT_STARTED = 0
UNIT_STARTED_OUT = 0

DAMPER_PROOF_TMR = 0
HUM_RELEASE_TMR = 0

GOTO FINALIZE

'==============================================================================
' DAMPER STAGE
'==============================================================================
DAMPER_STAGE:
MIXING_DAMPER_CMD_FINAL = MIXING_DAMPER_REQ

CD_VALVE_CMD_FINAL = 0
HD_VALVE_CMD_FINAL = 0

HUMIDITY_VALVE_CMD_FINAL = 0
HUMIDIFIER_ENABLE_FINAL = 0

CD_FAN_SS_FINAL = 0
CD_FAN_SPEED_CMD_FINAL = 0

HD_FAN_SS_FINAL = 0
HD_FAN_SPEED_CMD_FINAL = 0

RA_FAN_SS_FINAL_1 = 0
RA_FAN_SS_FINAL_2 = 0
RA_FAN_SPEED_CMD_FINAL_1 = 0
RA_FAN_SPEED_CMD_FINAL_2 = 0

ARBITER_MODE_CODE = 10
CURRENT_STAGE_TEXT = "DAMPER OPEN"
CURRENT_STAGE_CODE = 10
STARTUP_ACTIVE = 1
UNIT_STARTED_OUT = 0

DAMPER_PROOF_COND = 0

IF MIXING_DAMPER_FB >= DAMPER_OPEN_MIN_POS THEN
  DAMPER_PROOF_COND = 1
ENDIF

DAMPER_PROOF_DONE = SecTimer(DAMPER_PROOF_COND, DAMPER_PROOF_DELAY_SEC, DAMPER_PROOF_TMR)

IF DAMPER_PROOF_DONE = 1 THEN
  UNIT_STARTED = 1
  UNIT_STARTED_OUT = 1
  HUM_RELEASE_TMR = 0
  GOTO RUN_STAGE
ENDIF

GOTO FINALIZE

'==============================================================================
' RUN STAGE
'==============================================================================
RUN_STAGE:
MIXING_DAMPER_CMD_FINAL = MIXING_DAMPER_REQ

CD_VALVE_CMD_FINAL = CD_VALVE_REQ
HD_VALVE_CMD_FINAL = HD_VALVE_REQ

CD_FAN_SS_FINAL = CD_FAN_SS_REQ
CD_FAN_SPEED_CMD_FINAL = CD_FAN_SPEED_REQ

HD_FAN_SS_FINAL = HD_FAN_SS_REQ
HD_FAN_SPEED_CMD_FINAL = HD_FAN_SPEED_REQ

RA_FAN_SS_FINAL_1 = RA_FAN_SS_REQ_1
RA_FAN_SS_FINAL_2 = RA_FAN_SS_REQ_2
RA_FAN_SPEED_CMD_FINAL_1 = RA_FAN_SPEED_REQ_1
RA_FAN_SPEED_CMD_FINAL_2 = RA_FAN_SPEED_REQ_2

HUM_RELEASE_COND = UNIT_STARTED
HUM_RELEASE_DONE = SecTimer(HUM_RELEASE_COND, HUM_RELEASE_DELAY_SEC, HUM_RELEASE_TMR)

IF HUM_RELEASE_DONE = 1 THEN
  HUMIDITY_VALVE_CMD_FINAL = HUMIDITY_VALVE_REQ
  HUMIDIFIER_ENABLE_FINAL = HUMIDIFIER_ENABLE_REQ
ENDIF

IF HUM_RELEASE_DONE = 0 THEN
  HUMIDITY_VALVE_CMD_FINAL = 0
  HUMIDIFIER_ENABLE_FINAL = 0
ENDIF

IF DEHUM_ENABLE = 1 THEN
  ARBITER_MODE_CODE = 2
  
ENDIF

IF DEHUM_ENABLE = 0 THEN
  ARBITER_MODE_CODE = 6
  
ENDIF

CURRENT_STAGE_TEXT = "RUN"
CURRENT_STAGE_CODE = 6
STARTUP_ACTIVE = 0
UNIT_STARTED_OUT = UNIT_STARTED

GOTO FINALIZE

'==============================================================================
' FINALIZE
'==============================================================================
FINALIZE:

IF CD_FAN_SS_FINAL <> 0 THEN
  CD_FAN_SS_FINAL = 1
ENDIF

IF HD_FAN_SS_FINAL <> 0 THEN
  HD_FAN_SS_FINAL = 1
ENDIF

IF RA_FAN_SS_FINAL_1 <> 0 THEN
  RA_FAN_SS_FINAL_1 = 1
ENDIF

IF RA_FAN_SS_FINAL_2 <> 0 THEN
  RA_FAN_SS_FINAL_2 = 1
ENDIF

IF HUMIDIFIER_ENABLE_FINAL <> 0 THEN
  HUMIDIFIER_ENABLE_FINAL = 1
ENDIF

WAIT 1
GOTO MAIN
'===========================================================
' MODULE: RTU2_CONTROL_LOOP
' PURPOSE: Integrate module outputs, enforce sequence logic
'===========================================================

STRING INPUT MODE
NUMERIC INPUT RTU_SAFETY_OK, FREEZE_LATCH
STRING INPUT SAFETY_DESC
NUMERIC INPUT SAF_SPEED_CALC, RAF_SPEED_CALC, CHW_CMD_CALC
NUMERIC INPUT PH_VALVE_CALC, PH_PUMP_SS
NUMERIC INPUT OA_DAMPER_MIN, ECON_DAMPER_CALC
NUMERIC INPUT SMOKE_DPR_STROKE_TIME
NUMERIC OUTPUT SAF_SS, RAF_SS, SAF_SPEED_CMD, RAF_SPEED_CMD
NUMERIC OUTPUT CHW_VALVE_CMD, PH_VALVE_CMD, PH_PUMP_CMD, OA_DAMPER_CMD
STRING OUTPUT UNIT_STATE_TEXT

NUMERIC START_DELAY_S

GOTO INITIALIZE

INITIALIZE:
    START_DELAY_S = 0

    GOTO LOGIC
LOGIC:
    IF (RTU_SAFETY_OK = 0) OR (MODE = "FREEZE PROTECTION") OR (FREEZE_LATCH = 1) THEN
        SAF_SS = 0
        RAF_SS = 0
        SAF_SPEED_CMD = 0
        RAF_SPEED_CMD = 0
        OA_DAMPER_CMD = 0
        CHW_VALVE_CMD = 100
        PH_VALVE_CMD = 100
        PH_PUMP_CMD = 1
        UNIT_STATE_TEXT = "SAFETY/FREEZE: " & SAFETY_DESC
        GOTO ENDLOGIC
    ENDIF

    SELECT CASE MODE
    CASE "OFF"
        SAF_SS = 0
        RAF_SS = 0
        SAF_SPEED_CMD = 0
        RAF_SPEED_CMD = 0
        OA_DAMPER_CMD = 0
        CHW_VALVE_CMD = 0
        PH_VALVE_CMD = 0
        PH_PUMP_CMD = 0
        UNIT_STATE_TEXT = "OFF"

    CASE "HEATING", "COOLING"
        IF ECON_DAMPER_CALC > OA_DAMPER_MIN THEN
            OA_DAMPER_CMD = ECON_DAMPER_CALC
        ELSE
            OA_DAMPER_CMD = OA_DAMPER_MIN
        ENDIF

        START_DELAY_S = START_DELAY_S + SCAN
        IF START_DELAY_S < SMOKE_DPR_STROKE_TIME THEN
            SAF_SS = 0
            RAF_SS = 0
            SAF_SPEED_CMD = 0
            RAF_SPEED_CMD = 0
            UNIT_STATE_TEXT = "PRESTART: WAITING FOR DAMPERS/FSD"
            GOTO ENDLOGIC
        ENDIF

        SAF_SS = 1
        RAF_SS = 1
        SAF_SPEED_CMD = SAF_SPEED_CALC
        RAF_SPEED_CMD = RAF_SPEED_CALC
        CHW_VALVE_CMD = CHW_CMD_CALC
        PH_VALVE_CMD = PH_VALVE_CALC
        PH_PUMP_CMD = PH_PUMP_SS
        UNIT_STATE_TEXT = MODE & " RUN"

    CASE ELSE
        SAF_SS = 0
        RAF_SS = 0
        SAF_SPEED_CMD = 0
        RAF_SPEED_CMD = 0
        OA_DAMPER_CMD = 0
        CHW_VALVE_CMD = 0
        PH_VALVE_CMD = 0
        PH_PUMP_CMD = 0
        UNIT_STATE_TEXT = "UNKNOWN MODE"
    ENDSELECT

ENDLOGIC:
    IF (MODE = "OFF") OR (RTU_SAFETY_OK = 0) THEN START_DELAY_S = 0

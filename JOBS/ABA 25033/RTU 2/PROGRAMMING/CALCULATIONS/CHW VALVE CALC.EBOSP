'===========================================================
' MODULE: RTU2_CHW_VALVE_CALC
' PURPOSE: CHW valve control using SA temperature feedback
'===========================================================

NUMERIC INPUT SA_TEMP, SA_TEMP_SP
STRING  INPUT MODE
NUMERIC OUTPUT CHW_CMD_CALC

NUMERIC OLDERR, PK, IK, DK, I_VALVE
FUNCTION PID_CTRL

GOTO INITIALIZE

INITIALIZE:
OLDERR = 0
PK = 0.25
IK = 0.01
DK = 0.0
I_VALVE = 50

GOTO LOGIC

LOGIC:
SELECT CASE MODE
  CASE "FREEZE PROTECTION"
    CHW_CMD_CALC = 100

  CASE "HEATING", "OFF"
    CHW_CMD_CALC = 0

  CASE "COOLING"
    CHW_CMD_CALC = PID_CTRL(1, SA_TEMP, SA_TEMP_SP, I_VALVE, PK, IK, DK, OLDERR)
    IF CHW_CMD_CALC < 0 THEN CHW_CMD_CALC = 0
    IF CHW_CMD_CALC > 100 THEN CHW_CMD_CALC = 100

  CASE ELSE
    CHW_CMD_CALC = 0
ENDSELECT

'==============================================================================
' AHU_HOT_DECK_FAN_STATIC_CONTROL
'
' PURPOSE:
'   Start/stop the hot deck fan and modulate fan speed to maintain hot deck
'   duct static pressure.
'
' SEQUENCE:
'   - In occupied operation, hot deck fan is enabled and speed modulates to
'     maintain HD_STATIC_SP.
'   - In MAT low protection, fan remains enabled and continues static control.
'   - In smoke override, fan is enabled and speed goes to HD_FAN_SMOKE_SPEED.
'   - In safety shutdown, system disabled, or unoccupied mode, fan is commanded
'     off and speed goes to HD_FAN_OFF_SPEED.
'
' NOTES:
'   - This script does not own alarms.
'   - PIDControl function is assumed to already exist in the project.
'   - PID output is expected to be 0-100%.
'==============================================================================

'-----------------------------
' FUNCTIONS
'-----------------------------
FUNCTION PIDControl

'-----------------------------
' MODE INPUTS
'-----------------------------
NUMERIC INPUT UNIT_AVAILABLE
NUMERIC INPUT OCC_MODE
NUMERIC INPUT UNOCC_MODE
NUMERIC INPUT SMOKE_OVERRIDE
NUMERIC INPUT SAFETY_LOCKOUT
NUMERIC INPUT MAT_LOW

'-----------------------------
' PROCESS INPUTS
'-----------------------------
NUMERIC INPUT HD_DUCT_STATIC
NUMERIC INPUT HD_STATIC_SP

'-----------------------------
' HARDWARE INPUTS
'-----------------------------
NUMERIC INPUT HD_VFD_FAULT

'-----------------------------
' ADJUSTABLE INPUTS
'-----------------------------
NUMERIC INPUT HD_FAN_PID_P
NUMERIC INPUT HD_FAN_PID_I
NUMERIC INPUT HD_FAN_PID_D
NUMERIC INPUT HD_FAN_MIN_SPEED
NUMERIC INPUT HD_FAN_MAX_SPEED
NUMERIC INPUT HD_FAN_OFF_SPEED
NUMERIC INPUT HD_FAN_ON_CMD
NUMERIC INPUT HD_FAN_SMOKE_SPEED

'-----------------------------
' OUTPUTS
'-----------------------------
NUMERIC OUTPUT HD_FAN_SS
NUMERIC OUTPUT HD_FAN_SPEED_CMD
NUMERIC OUTPUT HD_FAN_PID_OUT
NUMERIC OUTPUT HD_FAN_MODE_CODE

'-----------------------------
' INTERNAL VARIABLES
'-----------------------------
NUMERIC HD_FAN_PID_I_TERM
NUMERIC HD_FAN_PID_OLD_ERR
NUMERIC HD_FAN_ACTIVE_SPEED
NUMERIC HD_FAN_ENABLE

'==============================================================================
' DEFAULTS EACH PASS
'==============================================================================

HD_FAN_ENABLE = 0
HD_FAN_ACTIVE_SPEED = HD_FAN_OFF_SPEED
HD_FAN_PID_OUT = 0
HD_FAN_MODE_CODE = 0

'==============================================================================
' MODE-BASED COMMAND SELECTION
' PRIORITY:
'   1. SAFETY LOCKOUT
'   2. SMOKE OVERRIDE
'   3. VFD FAULT
'   4. DISABLED / UNOCCUPIED
'   5. OCCUPIED / DEHUM / MAT LOW STATIC CONTROL
'==============================================================================

'-----------------------------
' PRIORITY 1 - SAFETY LOCKOUT
'-----------------------------
IF SAFETY_LOCKOUT = 1 THEN
  HD_FAN_ENABLE = 0
  HD_FAN_ACTIVE_SPEED = HD_FAN_OFF_SPEED
  HD_FAN_MODE_CODE = 5
ENDIF

IF SAFETY_LOCKOUT = 0 THEN

  '-----------------------------
  ' PRIORITY 2 - SMOKE OVERRIDE
  '-----------------------------
  IF SMOKE_OVERRIDE = 1 THEN
    HD_FAN_ENABLE = HD_FAN_ON_CMD
    HD_FAN_ACTIVE_SPEED = HD_FAN_SMOKE_SPEED
    HD_FAN_MODE_CODE = 6
  ENDIF

  IF SMOKE_OVERRIDE = 0 THEN

    '-----------------------------
    ' PRIORITY 3 - VFD FAULT
    '-----------------------------
    IF HD_VFD_FAULT = 1 THEN
      HD_FAN_ENABLE = 0
      HD_FAN_ACTIVE_SPEED = HD_FAN_OFF_SPEED
      HD_FAN_MODE_CODE = 7
    ENDIF

    IF HD_VFD_FAULT = 0 THEN

      '-----------------------------
      ' PRIORITY 4 - DISABLED / UNOCCUPIED
      '-----------------------------
      IF UNIT_AVAILABLE = 0 THEN
        HD_FAN_ENABLE = 0
        HD_FAN_ACTIVE_SPEED = HD_FAN_OFF_SPEED
        HD_FAN_MODE_CODE = 0
      ENDIF

      IF UNIT_AVAILABLE = 1 THEN

        IF UNOCC_MODE = 1 THEN
          HD_FAN_ENABLE = 0
          HD_FAN_ACTIVE_SPEED = HD_FAN_OFF_SPEED
          HD_FAN_MODE_CODE = 0
        ENDIF

        IF UNOCC_MODE = 0 THEN

          '-----------------------------
          ' PRIORITY 5 - OCCUPIED / DEHUM / MAT LOW
          '-----------------------------
          IF OCC_MODE = 1 THEN
            HD_FAN_ENABLE = HD_FAN_ON_CMD
            HD_FAN_PID_OUT = PIDControl(1, HD_DUCT_STATIC, HD_STATIC_SP, HD_FAN_PID_I_TERM, HD_FAN_PID_P, HD_FAN_PID_I, HD_FAN_PID_D, HD_FAN_PID_OLD_ERR)
            HD_FAN_ACTIVE_SPEED = HD_FAN_PID_OUT
            HD_FAN_MODE_CODE = 1
          ENDIF

          IF OCC_MODE = 0 THEN
            IF MAT_LOW = 1 THEN
              HD_FAN_ENABLE = HD_FAN_ON_CMD
              HD_FAN_PID_OUT = PIDControl(1, HD_DUCT_STATIC, HD_STATIC_SP, HD_FAN_PID_I_TERM, HD_FAN_PID_P, HD_FAN_PID_I, HD_FAN_PID_D, HD_FAN_PID_OLD_ERR)
              HD_FAN_ACTIVE_SPEED = HD_FAN_PID_OUT
              HD_FAN_MODE_CODE = 4
            ENDIF
          ENDIF

        ENDIF

      ENDIF

    ENDIF

  ENDIF

ENDIF

'==============================================================================
' NORMAL CONTROL CLAMPS
'==============================================================================

IF HD_FAN_MODE_CODE = 1 THEN

  IF HD_FAN_ACTIVE_SPEED < HD_FAN_MIN_SPEED THEN
    HD_FAN_ACTIVE_SPEED = HD_FAN_MIN_SPEED
  ENDIF

  IF HD_FAN_ACTIVE_SPEED > HD_FAN_MAX_SPEED THEN
    HD_FAN_ACTIVE_SPEED = HD_FAN_MAX_SPEED
  ENDIF

ENDIF

IF HD_FAN_MODE_CODE = 4 THEN

  IF HD_FAN_ACTIVE_SPEED < HD_FAN_MIN_SPEED THEN
    HD_FAN_ACTIVE_SPEED = HD_FAN_MIN_SPEED
  ENDIF

  IF HD_FAN_ACTIVE_SPEED > HD_FAN_MAX_SPEED THEN
    HD_FAN_ACTIVE_SPEED = HD_FAN_MAX_SPEED
  ENDIF

ENDIF

IF HD_FAN_MODE_CODE = 6 THEN

  IF HD_FAN_ACTIVE_SPEED < 0 THEN
    HD_FAN_ACTIVE_SPEED = 0
  ENDIF

  IF HD_FAN_ACTIVE_SPEED > 100 THEN
    HD_FAN_ACTIVE_SPEED = 100
  ENDIF

ENDIF

'==============================================================================
' FINAL OUTPUT CLAMPS
'==============================================================================

IF HD_FAN_ACTIVE_SPEED < 0 THEN
  HD_FAN_ACTIVE_SPEED = 0
ENDIF

IF HD_FAN_ACTIVE_SPEED > 100 THEN
  HD_FAN_ACTIVE_SPEED = 100
ENDIF

'==============================================================================
' FINAL OUTPUTS
'==============================================================================

HD_FAN_SS = HD_FAN_ENABLE
HD_FAN_SPEED_CMD = HD_FAN_ACTIVE_SPEED

WAIT 1
' RTU Discharge Air Temperature Reset Control (EBO-Compliant)
' Based on VAV group cooling CFM percentages and Return Air Humidity

' INPUTS
NUMERIC INPUT VAV1_CFM_1, VAV1_CFM_2, VAV1_CFM_3, VAV1_CFM_4, VAV1_CFM_5
NUMERIC INPUT VAV1_CFM_MAX_1, VAV1_CFM_MAX_2, VAV1_CFM_MAX_3, VAV1_CFM_MAX_4, VAV1_CFM_MAX_5
NUMERIC INPUT RA_HUMIDITY
NUMERIC INPUT DAT

' OUTPUT
NUMERIC OUTPUT DAT_RESET

' INTERNALS
NUMERIC VAV1_CFM[5], VAV1_CFM_MAX[5], VAV1_RATIO[5], i

' ADJUSTABLE PARAMETERS
NUMERIC INPUT DAT_MIN, DAT_MAX
NUMERIC INPUT COOL_HIGH_THRESHOLD, COOL_LOW_THRESHOLD
NUMERIC INPUT DAT_STEP, STEP_INTERVAL
NUMERIC INPUT HUMIDITY_LIMIT, HUMIDITY_HOLD_TIME

' TIMERS
NUMERIC PUBLIC HIGH_LOAD, LOW_LOAD
NUMERIC PUBLIC DAT_STAGE_TIMER, HUMIDITY_TIMER

GOTO START_CALC

START_CALC:

' --- Load VAV Inputs ---
VAV1_CFM[1] = VAV1_CFM_1
VAV1_CFM[2] = VAV1_CFM_2
VAV1_CFM[3] = VAV1_CFM_3
VAV1_CFM[4] = VAV1_CFM_4
VAV1_CFM[5] = VAV1_CFM_5

VAV1_CFM_MAX[1] = VAV1_CFM_MAX_1
VAV1_CFM_MAX[2] = VAV1_CFM_MAX_2
VAV1_CFM_MAX[3] = VAV1_CFM_MAX_3
VAV1_CFM_MAX[4] = VAV1_CFM_MAX_4
VAV1_CFM_MAX[5] = VAV1_CFM_MAX_5

' --- Evaluate CFM Load ---
HIGH_LOAD = 0
LOW_LOAD = 1

FOR i = 1 TO 5
    IF VAV1_CFM_MAX[i] > 0 THEN
        VAV1_RATIO[i] = (VAV1_CFM[i] / VAV1_CFM_MAX[i]) * 100

        IF VAV1_RATIO[i] >= COOL_HIGH_THRESHOLD THEN
            HIGH_LOAD = 1
        ENDIF

        IF VAV1_RATIO[i] >= COOL_LOW_THRESHOLD THEN
            LOW_LOAD = 0
        ENDIF
    ENDIF
NEXT i

' --- Humidity Override ---
IF RA_HUMIDITY > HUMIDITY_LIMIT THEN
    HUMIDITY_TIMER = HUMIDITY_TIMER + Scan
    DAT_RESET = DAT_MIN
ELSE
    HUMIDITY_TIMER = 0
ENDIF

IF HUMIDITY_TIMER > HUMIDITY_HOLD_TIME THEN
    HUMIDITY_TIMER = 0
ENDIF

' --- DAT Reset Control ---

' High Load → Decrease DAT
IF HIGH_LOAD = 1 THEN
    DAT_STAGE_TIMER = DAT_STAGE_TIMER + Scan

    IF DAT_STAGE_TIMER > STEP_INTERVAL THEN
        IF DAT_RESET > DAT_MIN THEN
            DAT_RESET = DAT_RESET - DAT_STEP
        ENDIF
        DAT_STAGE_TIMER = 0
    ENDIF
ENDIF
' Low Load → Increase DAT
IF LOW_LOAD = 1 THEN
    DAT_STAGE_TIMER = DAT_STAGE_TIMER + Scan

    IF DAT_STAGE_TIMER > STEP_INTERVAL THEN
        IF DAT_RESET < DAT_MAX THEN
            DAT_RESET = DAT_RESET + DAT_STEP
        ENDIF
        DAT_STAGE_TIMER = 0
    ENDIF

' Moderate Load → Hold DAT
ELSE
    DAT_STAGE_TIMER = 0
ENDIF


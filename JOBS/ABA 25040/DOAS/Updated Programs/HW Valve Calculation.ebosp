'=========================================================
' DOAS_HW_Valve_Module
' Direct-acting valve to maintain SA_SP in heating modes.
'=========================================================

NUMERIC INPUT DOAS_MODE, SAFETY_OK, FREEZE_LATCH
NUMERIC INPUT SA_TEMP
NUMERIC INPUT SA_SP

NUMERIC OUTPUT HW_CMD_CALC         ' 0–100%
NUMERIC OUTPUT HW_READY
NUMERIC OUTPUT HW_FAIL

' PID tunables
NUMERIC PUBLIC KP, KI, KD
NUMERIC PUBLIC I_TERM, OLD_ERR

' Deadband
NUMERIC PUBLIC DBAND               ' °F neutral band around SP

FUNCTION PID_LOOP

NUMERIC i

GOTO INI

INI:
  IF KP <= 0 THEN KP = 1.0
  IF KI < 0 THEN KI = 0.10
  IF KD < 0 THEN KD = 0.00
  IF DBAND < 0 THEN DBAND = 0.5
  I_TERM = 0 
  OLD_ERR = 0
  HW_CMD_CALC = 0 
  HW_READY = 1 
  HW_FAIL = 0
GOTO MAIN

'=========================================================
MAIN:
  HW_FAIL = 0

  ' ---- Global safety gates ----
  IF (SAFETY_OK = 0) OR (FREEZE_LATCH = 1) THEN
    HW_CMD_CALC = 0
    I_TERM = 0 
    OLD_ERR = 0
    WAIT 1 
    GOTO MAIN
  ENDIF

  ' ---- Mode enable ----
  ' Heating allowed in WARMUP (2) and OCCUPIED (4)
  IF (DOAS_MODE = 2) OR (DOAS_MODE = 4) THEN
    i = SA_SP - SA_TEMP
    IF ABS(i) <= DBAND THEN
    ' Hold current position (no new PID update)
      HW_CMD_CALC = HW_CMD_CALC
    ELSE
      ' Direct acting: colder than SP → open valve
      HW_CMD_CALC = PID_LOOP(0, SA_TEMP, SA_SP, I_TERM, KP, KI, KD, OLD_ERR)
    ENDIF
  ELSE
    ' All other modes → valve closed
    HW_CMD_CALC = 0
    I_TERM = 0 
    OLD_ERR = 0
  ENDIF

  ' Clamp 0–100 %
  IF HW_CMD_CALC < 0 THEN HW_CMD_CALC = 0
  IF HW_CMD_CALC > 100 THEN HW_CMD_CALC = 100

  HW_READY = 1
  WAIT 1
GOTO MAIN

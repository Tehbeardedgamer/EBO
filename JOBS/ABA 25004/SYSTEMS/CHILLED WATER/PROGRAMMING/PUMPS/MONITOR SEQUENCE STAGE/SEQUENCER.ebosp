'_____________________________________________________

'--- HEADER COMMENTS ---
' This script manages and sequences 2 PUMPs based on various criteria such as their status, failure rate,
' current runtime. It regularly checks for changes in PUMP availability and adjusts the
' sequencing accordingly.

'VARIABLES
NUMERIC INPUT STATUS_A, STATUS_B
NUMERIC INPUT DOWN_A, DOWN_B
NUMERIC INPUT RT_A, RT_B
NUMERIC INPUT FORCE_RESEQUENCE
NUMERIC OUTPUT PUMP_1, PUMP_2
NUMERIC PUMP_DOWN[2], PUMP_AVAIL[2], PUMP_STATUS[2], PUMP_RT[2], PUMP_SEQ[2], SCORE[2], RUNTIME[2], PREVIOUS_PUMP_AVAIL[2]
NUMERIC MAX_ORDER, i, PUMPS_AVAIL, PUMP_CHANGED, LAST_ROTATION

    INITALIZE:
    ' Initialize arrays using explicit assignments
    PUMP_DOWN[1] = DOWN_A
    PUMP_DOWN[2] = DOWN_B
    
    PUMP_STATUS[1] = STATUS_A
    PUMP_STATUS[2] = STATUS_B
    
    PUMP_RT[1] = RT_A
    PUMP_RT[2] = RT_B
    
    GOTO CHECK_PUMP_AVAIL

CHECK_PUMP_AVAIL:
    PUMPS_AVAIL = 0
    PUMP_CHANGED = FALSE

    FOR i = 1 TO 2
        PUMP_AVAIL[i] = MAXIMUM(1 - PUMP_DOWN[i], 0) * (PUMP_STATUS[i] > 0)
        IF PUMP_AVAIL[i] <> PREVIOUS_PUMP_AVAIL[i] THEN
            PUMP_CHANGED = TRUE
        ENDIF
        PREVIOUS_PUMP_AVAIL[i] = PUMP_AVAIL[i]
    NEXT i
    
    PUMPS_AVAIL = SUM(PUMP_AVAIL)
    
    IF PUMP_CHANGED THEN
        GOTO CHECK_RESEQUENCE
    ENDIF
    
    GOTO WAIT_LOOP

CHECK_RESEQUENCE:
    IF ((FORCE_RESEQUENCE = On) & ((DATE - 604800) > LAST_ROTATION)) THEN
        LAST_ROTATION = DATE
        GOTO RUNTIME_RESEQUENCE
    ENDIF
    GOTO SEQUENCE_RESET

SEQUENCE_RESET:
    FOR i = 1 TO 2
        IF (PUMP_AVAIL[i] = 0) & (PUMP_SEQ[i] > 0) THEN PUMP_SEQ[i] = 0
    NEXT i
    GOTO SEQUENCE_SCORE

SEQUENCE_SCORE:
    FOR i = 1 TO 2
        SCORE[i] = (PUMP_AVAIL[i] > 0) + ((PUMP_STATUS[i]) * (PUMP_AVAIL[i] > 0))
    NEXT i
    GOTO PUMP_ORDER

PUMP_ORDER:
    FOR i = 1 TO 2
        PUMP_SEQ[i] = 0
    NEXT i

    FOR i = 1 TO MINIMUM(PUMPS_AVAIL, 2)
        MAX_ORDER = MAXITEM(SCORE)
        PUMP_SEQ[MAX_ORDER] = i
        SCORE[MAX_ORDER] = 0
    NEXT i
    
    GOTO SET_SEQUENCE

RUNTIME_RESEQUENCE:
    FOR i = 1 TO 2
        RUNTIME[i] = MAXIMUM(PUMP_RT[i], 0.01) * (PUMP_AVAIL[i] > 0)
    NEXT i

    FOR i = 1 TO 2
        PUMP_SEQ[i] = 0
    NEXT i

    FOR i = 1 TO MINIMUM(PUMPS_AVAIL, 2)
        MAX_ORDER = MAXITEM(RUNTIME)
        PUMP_SEQ[MAX_ORDER] = ((PUMPS_AVAIL + 1) - i)
        RUNTIME[MAX_ORDER] = 0
    NEXT i

    GOTO SET_SEQUENCE

SET_SEQUENCE:
PUMP_1 = PUMP_SEQ[1]
PUMP_2 = PUMP_SEQ[2]

    GOTO WAIT_LOOP

WAIT_LOOP:
    WAIT 60
    GOTO INITALIZE

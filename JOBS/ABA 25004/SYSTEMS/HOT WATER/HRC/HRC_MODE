NUMERIC INPUT HW_SUPPLY_TEMP, HW_SUPPLY_TEMP_SP
NUMERIC PUBLIC HRC_SS



GOTO CHECK_HRC_MODE

CHECK_HRC_MODE:
IF (TS > 300) & (HW_SUPPLY_TEMP < HW_SUPPLY_TEMP_SP) THEN GOTO ENABLE_HRC
IF (HW_SUPPLY_TEMP > HW_SUPPLY_TEMP_SP) THEN GOTO DISABLE_HRC

ENABLE_HRC:
HRC_SS = TRUE
IF (HW_SUPPLY_TEMP > HW_SUPPLY_TEMP_SP)THEN GOTO WAIT_LOOP

DISABLE_HRC:
IF (TS > 3600) & (HW_SUPPLY_TEMP > HW_SUPPLY_TEMP_SP) THEN
HRC_SS = FALSE
GOTO WAIT_LOOP
ENDIF 

IF (HW_SUPPLY_TEMP < HW_SUPPLY_TEMP_SP)THEN GOTO WAIT_LOOP

WAIT_LOOP:
IF TS > 10 THEN GOTO CHECK_HRC_MODE
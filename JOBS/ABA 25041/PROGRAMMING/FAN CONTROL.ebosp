'============================
' Script: Fan_Control
' Purpose: Control supply fan enable & speed
'============================

NUMERIC INPUT MODE_COOL, MODE_HEAT, MODE_DEHUM
NUMERIC INPUT ZN_T, ZN_T_SP, MIN_FAN_SPEED, MAX_FAN_SPEED
NUMERIC OUTPUT FAN_CMD, FAN_SPD
FUNCTION FAN_PID
NUMERIC FAN_RELEASED, TIMER_HEAT

INI:
  FAN_CMD = 0
  FAN_SPD = 0
  FAN_RELEASED = 0
  TIMER_HEAT = 0
  GOTO CONTROL_LOOP

CONTROL_LOOP:

' Reset each cycle
FAN_CMD = 0
FAN_SPD = 0

IF MODE_COOL = 1 THEN GOTO COOLING
IF MODE_DEHUM = 1 THEN GOTO DEHUMID
IF MODE_HEAT = 1 THEN GOTO HEATING
GOTO NEUTRAL

'----------------------
COOLING:
IF MODE_COOL = 0 THEN GOTO ENDLOOP
  FAN_CMD = 1
  FAN_PID(ZN_T, ZN_T_SP, FAN_SPD, MIN_FAN_SPEED, MAX_FAN_SPEED)
  WAIT 10

DEHUMID:
IF MODE_DEHUM = 0 THEN GOTO ENDLOOP
  FAN_CMD = 1
  FAN_SPD = MIN_FAN_SPEED
WAIT 10

HEATING:
IF MODE_HEAT = 0 THEN GOTO ENDLOOP
  FAN_CMD = 1

  IF FAN_RELEASED = 0 THEN
     FAN_SPD = MIN_FAN_SPEED
     TIMER_HEAT = TIMER_HEAT + 10
     IF TIMER_HEAT >= 900 THEN
        FAN_RELEASED = 1
     ENDIF
  ELSE
     FAN_PID(ZN_T, ZN_T_SP, FAN_SPD, MIN_FAN_SPEED, MAX_FAN_SPEED)

     IF FAN_SPD = MIN_FAN_SPEED THEN
        TIMER_HEAT = TIMER_HEAT + 10
        IF TIMER_HEAT >= 900 THEN
           FAN_RELEASED = 0
        ENDIF
     ELSE
        TIMER_HEAT = 0
     ENDIF
  ENDIF
  WAIT 10

NEUTRAL:
  FAN_CMD = 0
  FAN_SPD = 0
  GOTO ENDLOOP

ENDLOOP:
WAIT 10
GOTO CONTROL_LOOP

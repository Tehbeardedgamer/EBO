NUMERIC INPUT VAV_DAMPER_1, VAV_DAMPER_2, VAV_DAMPER_3, VAV_DAMPER_4, VAV_DAMPER_5, VAV_DAMPER_6, VAV_DAMPER_7, VAV_DAMPER_8, VAV_DAMPER_9, VAV_DAMPER_10, VAV_DAMPER_11, VAV_DAMPER_12, VAV_DAMPER_13, VAV_DAMPER_14, VAV_DAMPER_15, VAV_DAMPER_16, VAV_DAMPER_17
Numeric Output VAV_DAMPER_POSITION, VAV_DAMPER_MAX
NUMERIC VAV_DAMPER[17], i

GOTO GET_POSITION

GET_POSITION:
VAV_DAMPER[1] = VAV_DAMPER_1
VAV_DAMPER[2] = VAV_DAMPER_2
VAV_DAMPER[3] = VAV_DAMPER_3
VAV_DAMPER[4] = VAV_DAMPER_4
VAV_DAMPER[5] = VAV_DAMPER_5
VAV_DAMPER[6] = VAV_DAMPER_6
VAV_DAMPER[7] = VAV_DAMPER_7
VAV_DAMPER[8] = VAV_DAMPER_8
VAV_DAMPER[9] = VAV_DAMPER_9
VAV_DAMPER[10] = VAV_DAMPER_10
VAV_DAMPER[11] = VAV_DAMPER_11
VAV_DAMPER[12] = VAV_DAMPER_12
VAV_DAMPER[13] = VAV_DAMPER_13
VAV_DAMPER[14] = VAV_DAMPER_14
VAV_DAMPER[15] = VAV_DAMPER_15
VAV_DAMPER[16] = VAV_DAMPER_16
VAV_DAMPER[17] = VAV_DAMPER_17

VAV_DAMPER_POSITION = max(VAV_DAMPER)

GOTO WAIT_LOOP

WAIT_LOOP:
If ts > 15 then GOTO GET_POSITION



For i = 1 to 17

    If VAV_DAMPER[i] = max(VAV_DAMPER) then
        VAV_DAMPER_MAX = VAV_DAMPER[i]
    Endif
    
 next i
    
    
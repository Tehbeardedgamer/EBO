'=========================================================
' DOAS_CHW_VALVE_CALC (GOLD)
'
' PURPOSE:
'   Calculates chilled water valve command for the DOAS
'
' SEQUENCE COVERAGE:
'   - Cooling to maintain SAT setpoint
'   - CHW is second-stage after economizer
'   - Valve closes when SAT < SP + deadband
'   - Dehumidification override when RH exceeds limit
'
' IMPORTANT:
'   - This script ONLY calculates CHW_CMD_CALC
'   - Main Orchestrator decides when the valve is enabled
'
'=========================================================


'---------------------- INPUTS -----------------------------
NUMERIC INPUT DOAS_MODE
' From: DETERMINE_MODE
' 0=OFF, 1=PRESTART, 2=WARMUP, 3=COOLDOWN, 4=OCC, 5=UNOCC-PROTECT

NUMERIC INPUT SAFETY_OK
' From: SAFETY CALC
' 1 = All safeties satisfied

NUMERIC INPUT FREEZE_LATCH
' From: DETERMINE_MODE (latched freezestat)

NUMERIC INPUT SA_TEMP
' From: Discharge Air Temperature sensor (EBO AI)

NUMERIC INPUT SA_SP
' From: SAT Trim / WU-CD Reset logic (°F)

NUMERIC INPUT OA_DAMPER_CMD
' From: Unified Damper Controller
' Used to determine if economizer is fully utilized

NUMERIC INPUT ECON_AVAILABLE
' From: DETERMINE_ECONOMIZER
' 1 = Economizer conditions satisfied

NUMERIC INPUT RETURN_RH
' From: Return Air Humidity sensor (EBO AI)

'---------------------- OUTPUTS ----------------------------
NUMERIC OUTPUT CHW_CMD_CALC
' To: MAIN_DOAS_ORCHESTRATOR
' 0–100% chilled water valve command (calculated only)

NUMERIC OUTPUT CHW_FAIL
' To: MAIN_DOAS_ORCHESTRATOR
' Non-latching diagnostic fail (always 0 in this script)

'---------------------- PUBLIC TUNABLES --------------------
NUMERIC DBAND
' Deadband above SA_SP where CHW remains closed (°F)

NUMERIC PUBLIC OA_MAX_POS
' Economizer fully-open threshold (%)

NUMERIC DEHUM_RH_START
' RH (%) above which dehumidification is required

NUMERIC INPUT KP
NUMERIC INPUT KI
NUMERIC INPUT KD
' PID gains for chilled water valve

'---------------------- INTERNALS --------------------------
NUMERIC ERR
NUMERIC PID_OUT
NUMERIC I_VlV
FUNCTION PID_LOOP

GOTO INIT


'=========================================================
INIT:
'---------------------------------------------------------
DBAND = 1.0
OA_MAX_POS = 95
DEHUM_RH_START = 60
I_VlV = 10

GOTO MAIN


'=========================================================
MAIN:
'---------------------------------------------------------
CHW_CMD_CALC = 0
CHW_FAIL = FALSE
'---------------- SAFETY / OFF -----------------------------
IF (SAFETY_OK = 0) OR (FREEZE_LATCH = 1) THEN
    CHW_CMD_CALC = 100
    WAIT 1
    GOTO MAIN
ENDIF

IF (DOAS_MODE = 0) OR (DOAS_MODE = 2) THEN
    ' OFF or WARMUP ? no cooling allowed
    CHW_CMD_CALC = 0
    WAIT 1
    GOTO MAIN
ENDIF


'---------------- DEADBAND CLOSE LOGIC --------------------
' Sequence:
' "When DAT drops below cooling setpoint PLUS deadband,
'  chilled water valve shall close."

IF SA_TEMP <= (SA_SP + DBAND) THEN
    CHW_CMD_CALC = 0
    WAIT 1
    GOTO MAIN
ENDIF


'---------------- ECONOMIZER PRIORITY ---------------------
' If economizer is available AND not fully open,
' CHW must remain closed (econ is first stage)

IF (ECON_AVAILABLE = 1) AND (OA_DAMPER_CMD < OA_MAX_POS) THEN
    CHW_CMD_CALC = 0
    WAIT 1
    GOTO MAIN
ENDIF


'---------------- DEHUMIDIFICATION OVERRIDE ----------------
' Sequence:
' If RH exceeds setpoint, CHW may open regardless of SAT

IF RETURN_RH >= DEHUM_RH_START THEN
    
    PID_OUT = PID_LOOP(1, SA_TEMP, SA_SP, I_VlV, KP, KI, KD,ERR)
    CHW_CMD_CALC = PID_OUT
    WAIT 1
    GOTO MAIN
ENDIF


'---------------- NORMAL COOLING PID ----------------------

PID_OUT = PID_LOOP(1, SA_TEMP, SA_SP,I_VlV, KP, KI, KD,ERR)


CHW_CMD_CALC = PID_OUT


WAIT 10
GOTO MAIN

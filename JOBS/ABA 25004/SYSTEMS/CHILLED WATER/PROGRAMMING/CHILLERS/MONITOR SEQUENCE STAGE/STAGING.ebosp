NUMERIC INPUT AVERAGE_PERCENT, CHW_SUPPLY_TEMP, CHW_SUPPLY_TEMP_SP, CHILLERS_AVAIL, REDUNDANT_TIMER,STAGE_UP_PCT, STAGE_DOWN_PCT,STAGE_TIMER
NUMERIC OUTPUT MAX_LOAD, STAGE
NUMERIC PUBLIC CHILLERS_REQUIRED

GOTO INITIALIZE

INITIALIZE:
    CHILLERS_REQUIRED = 1
    MAX_LOAD = STAGE_UP_PCT
    GOTO STAGE_CHECK

STAGE_CHECK:
    SELECT CASE CHILLERS_REQUIRED
    CASE 1
        GOTO STAGE_1
    CASE 2
        GOTO STAGE_3
    CASE 3
        GOTO STAGE_4
    CASE 4
        GOTO STAGE_5
    CASE 5
        GOTO STAGE_6
    CASE 6
        GOTO STAGE_7
    CASE 7
        GOTO STAGE_8
    CASE 8
        GOTO STAGE_9
    CASE 9
        GOTO STAGE_10
    CASE 10
        GOTO STAGE_11
    CASE 11
        GOTO STAGE_12
    CASE 12
        GOTO STAGE_13
    CASE 13
        GOTO STAGE_14
    CASE 14
        GOTO STAGE_15
    CASE 15
        GOTO STAGE_16
    CASE 16
        GOTO OPTIMAL_LOADING
    ENDSELECT

   

STAGE_1:
    STAGE = 1
    CHILLERS_REQUIRED = 1
    IF CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP AND TM > REDUNDANT_TIMER THEN GOTO STAGE_2
    IF CHILLERS_REQUIRED > 1 THEN GOTO STAGE_CHECK

STAGE_2:
    STAGE = 2
    CHILLERS_REQUIRED = 1
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_3
    IF (AVERAGE_PERCENT > 50)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_3
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 1 THEN GOTO STAGE_CHECK
 
STAGE_3:
    STAGE = 3
    CHILLERS_REQUIRED = 2
    IF (TM > REDUNDANT_TIMER & CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_4
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_4
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 2 THEN GOTO STAGE_CHECK
STAGE_4:
    STAGE = 4
    CHILLERS_REQUIRED = 3
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_5
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_5
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 3 THEN GOTO STAGE_CHECK
STAGE_5:
    STAGE = 5
    CHILLERS_REQUIRED = 4
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_6
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_6
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 4 THEN GOTO STAGE_CHECK
STAGE_6:
    STAGE = 6
    CHILLERS_REQUIRED = 5
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_7
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_7
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 5 THEN GOTO STAGE_CHECK
STAGE_7:
    STAGE = 7
    CHILLERS_REQUIRED = 6
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_8
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_8
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 6 THEN GOTO STAGE_CHECK
STAGE_8:
    STAGE = 8
    CHILLERS_REQUIRED = 7
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_9
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_9
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 7 THEN GOTO STAGE_CHECK

STAGE_9:
    STAGE = 9
    CHILLERS_REQUIRED = 8
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_10
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_10
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 8 THEN GOTO STAGE_CHECK

STAGE_10:
    STAGE = 10
    CHILLERS_REQUIRED = 9
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_11
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_11
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 9 THEN GOTO STAGE_CHECK

STAGE_11:
    STAGE = 11
    CHILLERS_REQUIRED = 10
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_12
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_12
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 10 THEN GOTO STAGE_CHECK

STAGE_12:
    STAGE = 12
    CHILLERS_REQUIRED = 11
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_13
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_13
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 11 THEN GOTO STAGE_CHECK

STAGE_13:
    STAGE = 13
    CHILLERS_REQUIRED = 12
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_14
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_14
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 12 THEN GOTO STAGE_CHECK

STAGE_14:
    STAGE = 14
    CHILLERS_REQUIRED = 13
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_15
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_15
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 13 THEN GOTO STAGE_CHECK

STAGE_15:
    STAGE = 15
    CHILLERS_REQUIRED = 14
    IF (TM > REDUNDANT_TIMER AND CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_16
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT > STAGE_UP_PCT)  AND (CHILLERS_AVAIL >= CHILLERS_REQUIRED) THEN GOTO STAGE_16
    IF (TS > STAGE_TIMER) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) OR (CHILLERS_AVAIL < CHILLERS_REQUIRED) THEN GOTO STAGE_DOWN
    IF CHILLERS_REQUIRED > 14 THEN GOTO STAGE_CHECK

STAGE_16:
    STAGE = 16
    CHILLERS_REQUIRED = 16
    GOTO OPTIMAL_LOADING

 

OPTIMAL_LOADING:
    IF AVERAGE_PERCENT < STAGE_UP_PCT THEN GOTO STAGE_DOWN
    IF (TS > 10) AND AVERAGE_PERCENT >= STAGE_UP_PCT THEN
        MAX_LOAD = minimum((MAX_LOAD + 5), 100)
        GOTO STAGE_DOWN
    ENDIF

STAGE_DOWN:
    IF ((AVERAGE_PERCENT >= STAGE_UP_PCT) AND (CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP)) THEN GOTO OPTIMAL_LOADING
    IF (TS > 60) AND (CHW_SUPPLY_TEMP > CHW_SUPPLY_TEMP_SP) THEN GOTO STAGE_CHECK
    IF (TS > 60) AND (AVERAGE_PERCENT <= STAGE_DOWN_PCT) AND (CHW_SUPPLY_TEMP <= CHW_SUPPLY_TEMP_SP + 1) THEN
        MAX_LOAD = maximum((MAX_LOAD - 5), 70)
        IF MAX_LOAD = 70 THEN
            CHILLERS_REQUIRED = maximum((CHILLERS_REQUIRED - 1), 1)
        ENDIF
        GOTO STAGE_CHECK
    ENDIF
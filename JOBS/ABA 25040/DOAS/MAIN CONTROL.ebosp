'=========================================================
' MAIN_DOAS_ORCHESTRATOR  (GOLD / SEQUENCE-CORRECT)
'
' PURPOSE:
'   Final arbitration layer for DOAS equipment.
'
' DESIGN RULES:
'   - Orchestrator NEVER calculates control values
'   - It only decides WHAT is allowed to run
'   - HW valve may operate with fans OFF (freeze / unocc)
'   - CHW valve only runs when unit is running
'   - No RA damper logic (hardware does not exist)
'
'=========================================================


' ------------------------- INPUTS -------------------------
NUMERIC INPUT DOAS_MODE
' From: DETERMINE_MODE
' 0=OFF,1=PRE,2=WARMUP,3=COOLDOWN,4=OCC,5=UNOCC-PROTECT

NUMERIC INPUT SAFETY_OK
' From: Safety aggregation (1=OK)

NUMERIC INPUT FREEZE_LATCH
' From: Freeze logic (1=freeze active)

' ---- Damper Calculations ----
NUMERIC INPUT OA_DAMPER_CMD_CALC
' From: Unified Damper Controller (%)

NUMERIC INPUT EA_DAMPER_CMD_CALC
' From: Unified Damper Controller (%)

NUMERIC INPUT OA_BYPASS_CMD_CALC
' From: Unified Damper Controller (%)

NUMERIC INPUT EA_BYPASS_CMD_CALC
' From: Unified Damper Controller (%)

' ---- Fan Calculations ----
NUMERIC INPUT SF_SS_CALC
NUMERIC INPUT SF_SPEED_CALC
NUMERIC INPUT SF_FAIL

NUMERIC INPUT EF_SS_CALC
NUMERIC INPUT EF_SPEED_CALC
NUMERIC INPUT EF_FAIL

' ---- ERW ----
NUMERIC INPUT ERW_SS_CALC
NUMERIC INPUT ERW_SPEED_CALC
NUMERIC INPUT ERW_FAIL

' ---- Valve Calculations ----
NUMERIC INPUT CHW_CMD_CALC
NUMERIC INPUT CHW_FAIL

NUMERIC INPUT HW_CMD_CALC
NUMERIC INPUT HW_FAIL


' ------------------------- OUTPUTS ------------------------
' ---- Dampers ----
NUMERIC OUTPUT OA_DAMPER_CMD
NUMERIC OUTPUT EA_DAMPER_CMD

NUMERIC OUTPUT OA_BYPASS_CMD
NUMERIC OUTPUT EA_BYPASS_CMD

' ---- Fans ----
NUMERIC OUTPUT SF_SS_CMD
NUMERIC OUTPUT SF_SPEED_CMD

NUMERIC OUTPUT EF_SS_CMD
NUMERIC OUTPUT EF_SPEED_CMD

' ---- ERW ----
NUMERIC OUTPUT ERW_SS_CMD
NUMERIC OUTPUT ERW_SPEED_CMD

' ---- Valves ----
NUMERIC OUTPUT CHW_VLV_CMD
NUMERIC OUTPUT HW_VLV_CMD

' ---- Unit Status ----
NUMERIC OUTPUT DOAS_RUN
NUMERIC OUTPUT DOAS_FAIL


' ------------------------- INTERNALS ----------------------
NUMERIC RUN_ALLOWED
NUMERIC ANY_FAIL


'=========================================================
GOTO INIT


'=========================================================
INIT:

    DOAS_RUN = 0
    DOAS_FAIL = 0

    OA_DAMPER_CMD = 0
    EA_DAMPER_CMD = 0
    OA_BYPASS_CMD = 0
    EA_BYPASS_CMD = 0

    SF_SS_CMD = 0
    SF_SPEED_CMD = 0

    EF_SS_CMD = 0
    EF_SPEED_CMD = 0

    ERW_SS_CMD = 0
    ERW_SPEED_CMD = 0

    CHW_VLV_CMD = 0
    HW_VLV_CMD = 0

    GOTO MAIN


    '=========================================================
MAIN:

    '---------------------------------------------------------
    ' 1) FAILURE AGGREGATION
    '---------------------------------------------------------
    ANY_FAIL = 0

    IF SF_FAIL = 1 THEN
        ANY_FAIL = 1
    ENDIF

    IF EF_FAIL = 1 THEN
        ANY_FAIL = 1
    ENDIF

    IF ERW_FAIL = 1 THEN
        ANY_FAIL = 1
    ENDIF

    IF CHW_FAIL = 1 THEN
        ANY_FAIL = 1
    ENDIF

    IF HW_FAIL = 1 THEN
        ANY_FAIL = 1
    ENDIF

    DOAS_FAIL = ANY_FAIL


    '---------------------------------------------------------
    ' 2) SAFETY / FREEZE OVERRIDE
    '---------------------------------------------------------
    IF SAFETY_OK = 0 THEN

        DOAS_RUN = 0

        SF_SS_CMD = 0
        SF_SPEED_CMD = 0

        EF_SS_CMD = 0
        EF_SPEED_CMD = 0

        ERW_SS_CMD = 0
        ERW_SPEED_CMD = 0

        OA_DAMPER_CMD = 0
        EA_DAMPER_CMD = 0
        OA_BYPASS_CMD = 0
        EA_BYPASS_CMD = 0

        CHW_VLV_CMD = CHW_CMD_CALC
        HW_VLV_CMD = HW_CMD_CALC   ' Allow freeze recovery heating

        WAIT 1
        GOTO MAIN
    ENDIF


    '---------------------------------------------------------
    ' 3) DETERMINE IF UNIT SHOULD RUN (FANS)
    '---------------------------------------------------------
    RUN_ALLOWED = 0

    IF DOAS_MODE = 2 THEN
        RUN_ALLOWED = 1
    ENDIF

    IF DOAS_MODE = 3 THEN
        RUN_ALLOWED = 1
    ENDIF

    IF DOAS_MODE = 4 THEN
        RUN_ALLOWED = 1
    ENDIF

    IF DOAS_MODE = 5 THEN
        RUN_ALLOWED = 0
    ENDIF

    IF DOAS_MODE = 0 THEN
        RUN_ALLOWED = 0
    ENDIF

    DOAS_RUN = RUN_ALLOWED


    '---------------------------------------------------------
    ' 4) UNIT NOT RUNNING (UNOCC / OFF)
    '---------------------------------------------------------
    IF RUN_ALLOWED = 0 THEN

        SF_SS_CMD = 0
        SF_SPEED_CMD = 0

        EF_SS_CMD = 0
        EF_SPEED_CMD = 0

        ERW_SS_CMD = 0
        ERW_SPEED_CMD = 0

        OA_DAMPER_CMD = 0
        EA_DAMPER_CMD = 0
        OA_BYPASS_CMD = 0
        EA_BYPASS_CMD = 0

        CHW_VLV_CMD = 0
        HW_VLV_CMD = HW_CMD_CALC   ' Allow unocc minimum heat

        WAIT 1
        GOTO MAIN
    ENDIF


    '---------------------------------------------------------
    ' 5) UNIT RUNNING (WARMUP / COOLDOWN / OCC)
    '---------------------------------------------------------
    SF_SS_CMD = SF_SS_CALC
    SF_SPEED_CMD = SF_SPEED_CALC

    EF_SS_CMD = EF_SS_CALC
    EF_SPEED_CMD = EF_SPEED_CALC

    ERW_SS_CMD = ERW_SS_CALC
    ERW_SPEED_CMD = ERW_SPEED_CALC

    OA_DAMPER_CMD = OA_DAMPER_CMD_CALC
    EA_DAMPER_CMD = EA_DAMPER_CMD_CALC

    OA_BYPASS_CMD = OA_BYPASS_CMD_CALC
    EA_BYPASS_CMD = EA_BYPASS_CMD_CALC

    CHW_VLV_CMD = CHW_CMD_CALC
    HW_VLV_CMD = HW_CMD_CALC


    WAIT 1
    GOTO MAIN

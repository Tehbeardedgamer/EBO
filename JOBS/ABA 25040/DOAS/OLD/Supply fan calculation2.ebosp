'=========================================================
' DOAS_SF_Module
' Supply Fan Start/Stop + PID Speed Control + Diagnostics
'
' • Provides SF_SS_CALC (start/stop proposal)
' • Provides SF_SPEED_CALC (0–100% speed proposal)
' • Includes:
'     - Mode-based minimum speeds
'     - PID with anti-windup
'     - Ramp rate limits (rate up/down)
'     - Deadband suppression
'     - Proof-of-flow monitoring
'     - Low-static alarm/fault logic
'
' Notes:
' - Main Orchestrator maps these to actual outputs.
' - If SF_STATUS or SF_FAULT not available, tie SF_STATUS=1 and SF_FAULT=0.
'=========================================================

' ------------------------- INPUTS -------------------------
NUMERIC INPUT DOAS_MODE
NUMERIC INPUT SAFETY_OK
NUMERIC INPUT FREEZE_STAT
NUMERIC INPUT DUCT_STATIC
NUMERIC INPUT DUCT_STATIC_SP
NUMERIC INPUT SF_STATUS
NUMERIC INPUT SF_FAULT

' ------------------------- OUTPUTS ------------------------
NUMERIC OUTPUT SF_SS_CALC
NUMERIC OUTPUT SF_SPEED_CALC
NUMERIC OUTPUT SF_READY
NUMERIC OUTPUT SF_FAIL
NUMERIC OUTPUT ALM_LOW_STATIC

' ------------------------- PUBLICS ------------------------
' PID
NUMERIC PUBLIC KP, KI, KD
NUMERIC PUBLIC I_TERM, OLD_ERR

' Speed limits
NUMERIC PUBLIC MIN_WARMUP
NUMERIC PUBLIC MIN_COOLDN
NUMERIC PUBLIC MIN_OCC
NUMERIC PUBLIC MIN_PROTECT
NUMERIC PUBLIC MAX_SPEED

' Ramp rules
NUMERIC PUBLIC RATE_UP_PCT_S
NUMERIC PUBLIC RATE_DN_PCT_S
NUMERIC PUBLIC CMD_DEADBAND

' Proof / Diagnostics
NUMERIC PUBLIC PROVE_TIMEOUT_S
NUMERIC PUBLIC LOW_STATIC_ERR_THR
NUMERIC PUBLIC LOW_STATIC_TIME_S

FUNCTION PID_LOOP

' ------------------------- INTERNALS ----------------------
NUMERIC last_cmd
NUMERIC t_prove
NUMERIC t_lowstatic
NUMERIC min_speed
NUMERIC SAF_CALC
NUMERIC e_sp

'=========================================================
GOTO INI

INI:
  ' PID defaults
  IF KP <= 0 THEN KP = 1
  IF KI < 0 THEN KI = 0.10
  IF KD < 0 THEN KD = 0

  ' Mode minimum speeds
  IF MIN_WARMUP <= 0 THEN MIN_WARMUP = 25
  IF MIN_COOLDN <= 0 THEN MIN_COOLDN = 25
  IF MIN_OCC <= 0 THEN MIN_OCC = 20
  IF MIN_PROTECT <= 0 THEN MIN_PROTECT = 15

  ' Speed cap
  IF MAX_SPEED <= 0 THEN MAX_SPEED = 100

  ' Ramp behavior
  IF RATE_UP_PCT_S <= 0 THEN RATE_UP_PCT_S = 10
  IF RATE_DN_PCT_S <= 0 THEN RATE_DN_PCT_S = 15
  IF CMD_DEADBAND < 0 THEN CMD_DEADBAND = 0.5

  ' Diagnostics
  IF PROVE_TIMEOUT_S <= 0 THEN PROVE_TIMEOUT_S = 20
  IF LOW_STATIC_ERR_THR <= 0 THEN LOW_STATIC_ERR_THR = 0.15
  IF LOW_STATIC_TIME_S <= 0 THEN LOW_STATIC_TIME_S = 60

  ' Initialize
  last_cmd = 0
  I_TERM = 0
  OLD_ERR = 0
  t_prove = 0
  t_lowstatic = 0

  SF_SS_CALC = 0
  SF_SPEED_CALC = 0
  SF_READY = 1
  SF_FAIL = 0
  ALM_LOW_STATIC = 0

  GOTO MAIN

  '=========================================================
MAIN:
  SF_FAIL = 0
  ALM_LOW_STATIC = 0
  SF_READY = 1

  ' ---------- SAFETY GATING ----------
  IF (SAFETY_OK = 0) OR (FREEZE_STAT = 1) THEN
    SF_SS_CALC = 0
    SF_SPEED_CALC = 0
    last_cmd = 0
    I_TERM = 0
    t_prove = 0
    t_lowstatic = 0
    WAIT 1
    GOTO MAIN
  ENDIF

  ' ---------- DETERMINE MODE MINIMUM SPEED ----------
  IF DOAS_MODE = 0 OR DOAS_MODE = 1 THEN
    ' OFF or PRESTART
    SF_SS_CALC = 0
    SF_SPEED_CALC = 0
    last_cmd = 0
    I_TERM = 0
    t_prove = 0
    t_lowstatic = 0
  ENDIF
  IF DOAS_MODE = 2 THEN min_speed = MIN_WARMUP
 
  IF DOAS_MODE = 3 THEN min_speed = MIN_COOLDN
 
  IF DOAS_MODE = 4 THEN min_speed = MIN_OCC
 
  IF DOAS_MODE = 5 THEN min_speed = MIN_PROTECT

  WAIT 1
  GOTO MAIN


  ' At this point: WARMUP / COOLDOWN / OCC / PROTECT
  SF_SS_CALC = 1

  ' ---------- PID CALCULATION ----------
  SAF_CALC = PID_LOOP(0, DUCT_STATIC, DUCT_STATIC_SP, I_TERM, KP, KI, KD, OLD_ERR)

  ' ----- Anti-windup & clamp -----
  IF SAF_CALC > MAX_SPEED THEN
    SAF_CALC = MAX_SPEED
    e_sp = (DUCT_STATIC_SP - DUCT_STATIC)
    IF e_sp > 0 THEN I_TERM = I_TERM - (KI * e_sp)
  ENDIF

  IF SAF_CALC < 0 THEN
    SAF_CALC = 0
    e_sp = (DUCT_STATIC_SP - DUCT_STATIC)
    IF e_sp < 0 THEN I_TERM = I_TERM - (KI * e_sp)
  ENDIF

  ' Enforce mode minimum
  IF SAF_CALC < min_speed THEN SAF_CALC = min_speed

  ' ---------- RAMP-LIMITING ----------
  IF SAF_CALC > last_cmd + RATE_UP_PCT_S THEN
    SF_SPEED_CALC = last_cmd + RATE_UP_PCT_S
  ENDIF
  IF SAF_CALC < last_cmd - RATE_DN_PCT_S THEN
    SF_SPEED_CALC = last_cmd - RATE_DN_PCT_S
  ENDIF
  IF (SAF_CALC <= last_cmd + RATE_UP_PCT_S) AND (SAF_CALC >= last_cmd - RATE_DN_PCT_S) THEN
    SF_SPEED_CALC = SAF_CALC
  ENDIF

  ' ---------- DEADBAND ----------
  IF ABS(SF_SPEED_CALC - last_cmd) < CMD_DEADBAND THEN
    SF_SPEED_CALC = last_cmd
  ENDIF

  last_cmd = SF_SPEED_CALC

  ' ---------- FAN PROOF LOGIC ----------
  IF SF_SS_CALC = 1 THEN
    IF SF_STATUS = 1 THEN
      t_prove = 0
    ELSE
      IF t_prove < PROVE_TIMEOUT_S THEN
        t_prove = t_prove + 1
      ELSE
        SF_FAIL = 1
      ENDIF
    ENDIF
  ELSE
    t_prove = 0
  ENDIF

  ' ---------- LOW STATIC DIAGNOSTIC ----------
  IF SF_SPEED_CALC >= (MAX_SPEED - 0.5) THEN
    IF (DUCT_STATIC_SP - DUCT_STATIC) >= LOW_STATIC_ERR_THR THEN
      IF t_lowstatic < LOW_STATIC_TIME_S THEN
        t_lowstatic = t_lowstatic + 1
      ELSE
        ALM_LOW_STATIC = 1
        SF_FAIL = 1
      ENDIF
    ELSE
      t_lowstatic = 0
    ENDIF
  ELSE
    t_lowstatic = 0
  ENDIF

  ' ---------- DRIVE FAULT ----------
  IF SF_FAULT = 1 THEN
    SF_FAIL = 1
  ENDIF

  WAIT 1
  GOTO MAIN

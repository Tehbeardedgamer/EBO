'==============================================================================
' AHU_SETPOINT_MANAGER
'
' PURPOSE:
'   Generate all active control setpoints for the AHU based on system mode.
'
' OUTPUT SETPOINTS:
'   - Cold Deck Discharge Air Temperature Setpoint
'   - Hot Deck Discharge Air Temperature Setpoint
'   - Cold Deck Static Pressure Setpoint
'   - Hot Deck Static Pressure Setpoint
'   - Building Pressure Setpoint
'   - Humidity Setpoint
'   - Minimum OA Damper Position Base Setpoint
'
' NOTES:
'   - Includes legacy Siemens-style static reset selection conditions:
'       OCC OR RAH high OR RAT outside band
'==============================================================================

'-----------------------------
' MODE / SENSOR INPUTS
'-----------------------------
NUMERIC INPUT OCC_MODE
NUMERIC INPUT UNOCC_MODE
NUMERIC INPUT DEHUM_ENABLE
NUMERIC INPUT MAT_LOW
NUMERIC INPUT OA_TEMP
NUMERIC INPUT RA_HUMIDITY
NUMERIC INPUT RA_TEMP

'-----------------------------
' ADJUSTABLE SETPOINT INPUTS
'-----------------------------
NUMERIC INPUT CD_DAT_SP_OCC_NORM
NUMERIC INPUT CD_DAT_SP_DEHUM

NUMERIC INPUT OA_WARM_RESET_PT
NUMERIC INPUT OA_COLD_RESET_PT
NUMERIC INPUT HD_DAT_SP_WARM_OA
NUMERIC INPUT HD_DAT_SP_COLD_OA

NUMERIC INPUT CD_STATIC_SP_OCC
NUMERIC INPUT CD_STATIC_SP_UNOCC
NUMERIC INPUT HD_STATIC_SP_OCC
NUMERIC INPUT HD_STATIC_SP_UNOCC

NUMERIC INPUT BLDG_PRESSURE_SP_OCC
NUMERIC INPUT BLDG_PRESSURE_SP_UNOCC

NUMERIC INPUT RH_SP_OCC
NUMERIC INPUT RH_SP_UNOCC

NUMERIC INPUT MIN_OA_POS_DEFAULT

'-----------------------------
' LEGACY CONDITION INPUTS
'-----------------------------
NUMERIC INPUT STATIC_RAH_HIGH_SP
NUMERIC INPUT STATIC_RAT_HIGH_SP
NUMERIC INPUT STATIC_RAT_LOW_SP

'-----------------------------
' OUTPUTS
'-----------------------------
NUMERIC OUTPUT CD_DAT_SP
NUMERIC OUTPUT HD_DAT_SP
NUMERIC OUTPUT CD_STATIC_SP
NUMERIC OUTPUT HD_STATIC_SP
NUMERIC OUTPUT BLDG_PRESSURE_SP
NUMERIC OUTPUT RH_SP
NUMERIC OUTPUT MIN_OA_POS_BASE
NUMERIC OUTPUT STATIC_OCC_SELECT

'-----------------------------
' INTERNAL VARIABLES
'-----------------------------
NUMERIC RESET_SLOPE

GOTO INI
'-----------------------------
' DEFAULT OUTPUTS
'-----------------------------
INI:
CD_DAT_SP = CD_DAT_SP_OCC_NORM
HD_DAT_SP = HD_DAT_SP_WARM_OA
CD_STATIC_SP = CD_STATIC_SP_UNOCC
HD_STATIC_SP = HD_STATIC_SP_UNOCC
BLDG_PRESSURE_SP = BLDG_PRESSURE_SP_UNOCC
RH_SP = RH_SP_UNOCC
MIN_OA_POS_BASE = MIN_OA_POS_DEFAULT
STATIC_OCC_SELECT = 0
GOTO MAIN
'==============================================================================
' COLD DECK DISCHARGE SETPOINT
'==============================================================================
MAIN:
IF DEHUM_ENABLE = 1 THEN
  CD_DAT_SP = CD_DAT_SP_DEHUM
ENDIF

IF DEHUM_ENABLE = 0 THEN
  CD_DAT_SP = CD_DAT_SP_OCC_NORM
ENDIF

'==============================================================================
' HOT DECK DISCHARGE SETPOINT RESET FROM OA TEMP
'==============================================================================

IF OA_WARM_RESET_PT <> OA_COLD_RESET_PT THEN
  RESET_SLOPE = (HD_DAT_SP_COLD_OA - HD_DAT_SP_WARM_OA) / (OA_COLD_RESET_PT - OA_WARM_RESET_PT)
ENDIF

IF OA_TEMP >= OA_WARM_RESET_PT THEN
  HD_DAT_SP = HD_DAT_SP_WARM_OA
ENDIF

IF OA_TEMP <= OA_COLD_RESET_PT THEN
  HD_DAT_SP = HD_DAT_SP_COLD_OA
ENDIF

IF OA_TEMP < OA_WARM_RESET_PT THEN
  IF OA_TEMP > OA_COLD_RESET_PT THEN
    HD_DAT_SP = HD_DAT_SP_WARM_OA + ((OA_TEMP - OA_WARM_RESET_PT) * RESET_SLOPE)
  ENDIF
ENDIF

'==============================================================================
' LEGACY STATIC RESET SELECTION
' Siemens:
'   OCC OR RAH high OR RAT >= high OR RAT <= low -> OCC static SPs
'   else -> UNOCC static SPs
'==============================================================================

STATIC_OCC_SELECT = 0

IF OCC_MODE = 1 THEN
  STATIC_OCC_SELECT = 1
ENDIF

IF RA_HUMIDITY >= STATIC_RAH_HIGH_SP THEN
  STATIC_OCC_SELECT = 1
ENDIF

IF RA_TEMP >= STATIC_RAT_HIGH_SP THEN
  STATIC_OCC_SELECT = 1
ENDIF

IF RA_TEMP <= STATIC_RAT_LOW_SP THEN
  STATIC_OCC_SELECT = 1
ENDIF

IF STATIC_OCC_SELECT = 1 THEN
  CD_STATIC_SP = CD_STATIC_SP_OCC
  HD_STATIC_SP = HD_STATIC_SP_OCC
  BLDG_PRESSURE_SP = BLDG_PRESSURE_SP_OCC
ENDIF

IF STATIC_OCC_SELECT = 0 THEN
  CD_STATIC_SP = CD_STATIC_SP_UNOCC
  HD_STATIC_SP = HD_STATIC_SP_UNOCC
  BLDG_PRESSURE_SP = BLDG_PRESSURE_SP_UNOCC
ENDIF

'==============================================================================
' RH SETPOINT SELECTION
'==============================================================================

IF OCC_MODE = 1 THEN
  RH_SP = RH_SP_OCC
ENDIF

IF OCC_MODE = 0 THEN
  RH_SP = RH_SP_UNOCC
ENDIF

IF MAT_LOW = 1 THEN
  RH_SP = 0
ENDIF

'==============================================================================
' MINIMUM OA POSITION BASE
'==============================================================================

MIN_OA_POS_BASE = MIN_OA_POS_DEFAULT

WAIT 1
' G1 Pump Startup / Per-Pump Controller (flow style, soft-stop on ramp-down)
' Uses SECTIMER(..., 0) for all timing, rate-limits every scan, no fall-through.

' --------- INPUTS ----------
NUMERIC INPUT PUMP_STATUS            ' 1=VFD proven
NUMERIC INPUT PUMPS_REQ              ' 0..3 required (from staging)
NUMERIC INPUT ORDER                  ' 1=Lead,2=Lag1,3=Lag2,0=out
NUMERIC INPUT CHWP_MASTER_SPEED_CMD  ' 0..100% (from DP PI)
NUMERIC INPUT CHWP_DOWN              ' 1=maintenance/locked out
NUMERIC INPUT CHWP_FAULT_RESET       ' momentary 1 clears failure
NUMERIC INPUT AUTO_ENABLE            ' 1=Auto enabled (tie to 1 if unused)

' --------- OUTPUTS ---------
NUMERIC OUTPUT CHWP_SPEED_CMD         ' 0..100% commanded speed
NUMERIC OUTPUT CHWP_SS                ' 1=start, 0=stop
NUMERIC PUBLIC CHWP_FAILED            ' 1=failed latch

' --------- PUBLICS ---------
' Timing / rate limits
NUMERIC PUBLIC START_TIMEOUT          ' s to prove on start (e.g., 180)
NUMERIC PUBLIC LOSS_TIMEOUT           ' s loss-of-proof debounce (e.g., 30)
NUMERIC PUBLIC DELTA_T                ' s per scan (must match WAIT)
NUMERIC PUBLIC RATE_UP                ' %/s up (e.g., 1.0)
NUMERIC PUBLIC RATE_DN                ' %/s down (e.g., 0.7)
NUMERIC PUBLIC STOP_AT_SPEED          ' % threshold to drop SS after ramp-down (e.g., 0..2%)

' --------- INTERNALS -------
NUMERIC FIRST_INIT_DONE
NUMERIC CMD_ON
NUMERIC TARGET
NUMERIC UP_STEP, DN_STEP
NUMERIC PREV_STATUS
NUMERIC WAS_RUNNING

' timers for SECTIMER (must persist)
NUMERIC T_START, T_LOSS
FUNCTION SECTIMER

GOTO INIT

INIT:
    IF DELTA_T <= 0 THEN DELTA_T = 2
    IF RATE_UP <= 0 THEN RATE_UP = 1.0
    IF RATE_DN <= 0 THEN RATE_DN = 0.7
    IF START_TIMEOUT <= 0 THEN START_TIMEOUT = 180
    IF LOSS_TIMEOUT <= 0 THEN LOSS_TIMEOUT = 30
    IF STOP_AT_SPEED < 0 THEN STOP_AT_SPEED = 0   ' 0..2% is typical

    IF FIRST_INIT_DONE = 0 THEN
        CHWP_SS = 0
        CHWP_SPEED_CMD = 0
        CHWP_FAILED = 0
        PREV_STATUS = PUMP_STATUS
        T_START = 0
        T_LOSS = 0
        FIRST_INIT_DONE = 1
    ENDIF
    GOTO CONTROL_LOOP

CONTROL_LOOP:
    ' --- compute common stuff EVERY scan (timers need this pass) ---
    ' commanded-on decision
    CMD_ON = 0
    IF ORDER > 0 THEN
        IF ORDER <= PUMPS_REQ THEN
            IF CHWP_DOWN = 0 THEN
                IF CHWP_FAILED = 0 THEN
                    IF AUTO_ENABLE = 1 THEN
                        CMD_ON = 1
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    ' rate-limit steps
    UP_STEP = RATE_UP * DELTA_T
    DN_STEP = RATE_DN * DELTA_T

    ' target for this scan
    TARGET = 0
    IF CMD_ON = 1 THEN
        TARGET = CHWP_MASTER_SPEED_CMD
    ENDIF

    ' running history
    WAS_RUNNING = 0
    IF PREV_STATUS = 1 THEN WAS_RUNNING = 1

    ' start-prove and loss-of-proof conditions (evaluated EVERY scan)
    IF SECTIMER((CMD_ON = 1) & (PUMP_STATUS = 0) & (WAS_RUNNING = 0), START_TIMEOUT, T_START, 0) THEN
        CHWP_FAILED = 1
    ENDIF

    IF SECTIMER((CMD_ON = 1) & (PUMP_STATUS = 0) & (WAS_RUNNING = 1), LOSS_TIMEOUT, T_LOSS, 0) THEN
        CHWP_FAILED = 1
    ENDIF

    ' manual reset (latching failure)
    IF CHWP_FAULT_RESET = 1 THEN
        CHWP_FAILED = 0
        T_START = 0
        T_LOSS = 0
    ENDIF

    ' branch to action blocks
    IF CHWP_FAILED = 1 THEN GOTO FAIL_ACTION
    IF CMD_ON = 1 THEN GOTO RUN_ACTION ELSE GOTO STOP_ACTION

RUN_ACTION:
    ' assert run while commanded on
    CHWP_SS = 1

    ' ramp toward target with rate limits
    IF TARGET > CHWP_SPEED_CMD THEN
        CHWP_SPEED_CMD = MINIMUM(TARGET, CHWP_SPEED_CMD + UP_STEP)
    ELSE
        CHWP_SPEED_CMD = MAXIMUM(TARGET, CHWP_SPEED_CMD - DN_STEP)
    ENDIF

    ' clamp
    IF CHWP_SPEED_CMD < 0 THEN CHWP_SPEED_CMD = 0
    IF CHWP_SPEED_CMD > 100 THEN CHWP_SPEED_CMD = 100

    GOTO END_SCAN

STOP_ACTION:
    ' commanded off: keep run asserted while we ramp down, then drop SS at low speed
    IF CHWP_SPEED_CMD > STOP_AT_SPEED THEN
        ' keep SS = 1 so VFD can decelerate under command
        CHWP_SS = 1
        CHWP_SPEED_CMD = MAXIMUM(0, CHWP_SPEED_CMD - DN_STEP)
    ELSE
        ' at/near zero -> now drop SS
        CHWP_SPEED_CMD = 0
        CHWP_SS = 0
    ENDIF
    GOTO END_SCAN

FAIL_ACTION:
    ' failed latch: prefer a controlled stop if pump is still proven running;
    ' otherwise ensure it's off
    IF PUMP_STATUS = 1 THEN
        ' ramp down with SS held until near zero
        IF CHWP_SPEED_CMD > STOP_AT_SPEED THEN
            CHWP_SS = 1
            CHWP_SPEED_CMD = MAXIMUM(0, CHWP_SPEED_CMD - DN_STEP)
        ELSE
            CHWP_SPEED_CMD = 0
            CHWP_SS = 0
        ENDIF
    ELSE
        ' not proven anyway: ensure stop, bleed the command to 0
        CHWP_SS = 0
        IF CHWP_SPEED_CMD > 0 THEN
            CHWP_SPEED_CMD = MAXIMUM(0, CHWP_SPEED_CMD - DN_STEP)
        ENDIF
    ENDIF
    GOTO END_SCAN

END_SCAN:
    PREV_STATUS = PUMP_STATUS
    WAIT 2
    GOTO CONTROL_LOOP

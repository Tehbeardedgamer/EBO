'==============================================================================
' AHU_VENTILATION_RESET
'
' PURPOSE:
'   Reset the minimum outside air position based on return air CO2 compared to
'   outdoor air CO2.
'
' SEQUENCE:
'   - If RA_CO2 >= OA_CO2 + CO2_DIFF_ENABLE, increase MIN_OA_POS_RESET by
'     OA_STEP every OA_STEP_DELAY seconds.
'   - If RA_CO2 < OA_CO2 + CO2_DIFF_ENABLE, decrease MIN_OA_POS_RESET by
'     OA_STEP every OA_STEP_DELAY seconds.
'   - Clamp output between MIN_OA_POS_BASE and MIN_OA_POS_MAX.
'
' NOTES:
'   - This script does not directly command the damper.
'   - It outputs the active minimum OA reset target for the mixing damper
'     control script.
'   - Reset is only active when the unit is available and occupied.
'   - Uses SecTimer for step timing.
'==============================================================================

'-----------------------------
' FUNCTIONS
'-----------------------------
FUNCTION SecTimer

'-----------------------------
' INPUTS
'-----------------------------
NUMERIC INPUT UNIT_AVAILABLE
NUMERIC INPUT OCC_MODE
NUMERIC INPUT UNOCC_MODE
NUMERIC INPUT SMOKE_OVERRIDE
NUMERIC INPUT SAFETY_LOCKOUT

NUMERIC INPUT RA_CO2
NUMERIC INPUT OA_CO2

NUMERIC INPUT MIN_OA_POS_BASE
NUMERIC INPUT MIN_OA_POS_MAX
NUMERIC INPUT CO2_DIFF_ENABLE
NUMERIC INPUT OA_STEP
NUMERIC INPUT OA_STEP_DELAY

'-----------------------------
' OUTPUTS
'-----------------------------
NUMERIC OUTPUT MIN_OA_POS_RESET
NUMERIC OUTPUT CO2_RESET_ACTIVE
NUMERIC OUTPUT CO2_HIGH_VENT_REQ
NUMERIC OUTPUT CO2_RESET_TIMER

'-----------------------------
' INTERNAL VARIABLES
'-----------------------------
NUMERIC CO2_ENABLE_THRESHOLD
NUMERIC STEP_TIMER_DONE
NUMERIC STEP_TIMER_COND

GOTO INI

'-----------------------------
' INITIALIZATION
'-----------------------------
INI:
MIN_OA_POS_RESET = MIN_OA_POS_BASE
CO2_RESET_ACTIVE = 0
CO2_HIGH_VENT_REQ = 0
CO2_RESET_TIMER = 0
CO2_ENABLE_THRESHOLD = 0
STEP_TIMER_DONE = 0
STEP_TIMER_COND = 0

GOTO MAIN

'==============================================================================
' MAIN
'==============================================================================
MAIN:

'-----------------------------
' DEFAULT STATUS EACH PASS
'-----------------------------
CO2_RESET_ACTIVE = 0
CO2_HIGH_VENT_REQ = 0
STEP_TIMER_COND = 0
STEP_TIMER_DONE = 0

'-----------------------------
' DETERMINE CURRENT CO2 THRESHOLD
'-----------------------------
CO2_ENABLE_THRESHOLD = OA_CO2 + CO2_DIFF_ENABLE

'-----------------------------
' DETERMINE WHETHER RESET LOGIC IS ACTIVE
'-----------------------------
IF UNIT_AVAILABLE = 1 THEN
  IF OCC_MODE = 1 THEN
    IF UNOCC_MODE = 0 THEN
      IF SMOKE_OVERRIDE = 0 THEN
        IF SAFETY_LOCKOUT = 0 THEN
          CO2_RESET_ACTIVE = 1
        ENDIF
      ENDIF
    ENDIF
  ENDIF
ENDIF

'-----------------------------
' IF RESET NOT ACTIVE, RETURN TO BASE MINIMUM
'-----------------------------
IF CO2_RESET_ACTIVE = 0 THEN
  MIN_OA_POS_RESET = MIN_OA_POS_BASE
  CO2_RESET_TIMER = 0
  CO2_HIGH_VENT_REQ = 0
  GOTO VENT_DONE
ENDIF

'-----------------------------
' DETERMINE WHETHER CO2 IS ABOVE THRESHOLD
'-----------------------------
IF RA_CO2 >= CO2_ENABLE_THRESHOLD THEN
  CO2_HIGH_VENT_REQ = 1
ENDIF

IF RA_CO2 < CO2_ENABLE_THRESHOLD THEN
  CO2_HIGH_VENT_REQ = 0
ENDIF

'-----------------------------
' STEP TIMER CONDITION
'-----------------------------
STEP_TIMER_COND = 1
STEP_TIMER_DONE = SecTimer(STEP_TIMER_COND, OA_STEP_DELAY, CO2_RESET_TIMER)

'-----------------------------
' APPLY OA RESET STEP
'-----------------------------
IF STEP_TIMER_DONE = 1 THEN

  IF CO2_HIGH_VENT_REQ = 1 THEN
    MIN_OA_POS_RESET = MIN_OA_POS_RESET + OA_STEP
  ENDIF

  IF CO2_HIGH_VENT_REQ = 0 THEN
    MIN_OA_POS_RESET = MIN_OA_POS_RESET - OA_STEP
  ENDIF

  CO2_RESET_TIMER = 0
ENDIF

'-----------------------------
' CLAMP OUTPUT
'-----------------------------
IF MIN_OA_POS_RESET < MIN_OA_POS_BASE THEN
  MIN_OA_POS_RESET = MIN_OA_POS_BASE
ENDIF

IF MIN_OA_POS_RESET > MIN_OA_POS_MAX THEN
  MIN_OA_POS_RESET = MIN_OA_POS_MAX
ENDIF

VENT_DONE:

WAIT 1
GOTO MAIN
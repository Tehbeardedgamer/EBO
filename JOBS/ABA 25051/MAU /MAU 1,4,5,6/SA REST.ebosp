'==============================================================================
' MAU_SYS_SAT_RESET  - PATCHED
'
' PURPOSE
' Compute SAT reset setpoint as a linear function of associated space sensible
' cooling valve aggregate position.
'
' PATCHED BEHAVIOR
' 1) Adds EXT_COMMS_OK input.
' 2) If external communication is lost, SmartSenseValvePos is ignored and
'    SAT_RESET_SP is forced to 55°F.
'
' REQUIRED NEW BINDING
' - EXT_COMMS_OK: 1 = external SmartSenseValvePos is valid
'                 0 = communication loss / value not reliable
'==============================================================================

'-----------------------------
' INPUTS (Bindings)
'-----------------------------
NUMERIC INPUT SmartSenseValvePos
NUMERIC INPUT SAT_RESET_MAX_SP
NUMERIC INPUT SAT_RESET_MIN_SP
NUMERIC INPUT EXT_COMMS_OK

'-----------------------------
' OUTPUTS (Bindings)
'-----------------------------
NUMERIC OUTPUT SAT_RESET_SP
NUMERIC OUTPUT COMM_LOSS_ACTIVE

'-----------------------------
' INTERNAL VARIABLES
'-----------------------------
NUMERIC ValvePct_Clamped
NUMERIC COMM_LOSS_SAT_SP


'==============================================================================
INIT:
'==============================================================================
SAT_RESET_SP = SAT_RESET_MAX_SP
COMM_LOSS_ACTIVE = 0
ValvePct_Clamped = 0
COMM_LOSS_SAT_SP = 55

Goto MAIN


'==============================================================================
MAIN:
'==============================================================================

COMM_LOSS_ACTIVE = 0
If EXT_COMMS_OK is OFF then
    COMM_LOSS_ACTIVE = 1
EndIf

If COMM_LOSS_ACTIVE is ON then
    SAT_RESET_SP = COMM_LOSS_SAT_SP

    Wait 1
    Goto MAIN
EndIf

ValvePct_Clamped = SmartSenseValvePos

If ValvePct_Clamped < 0 then ValvePct_Clamped = 0
If ValvePct_Clamped > 100 then ValvePct_Clamped = 100

' Linear interpolation:
' SAT_RESET_SP = MAX + (MIN - MAX) * (Pct/100)
SAT_RESET_SP = SAT_RESET_MAX_SP + (SAT_RESET_MIN_SP - SAT_RESET_MAX_SP) * (ValvePct_Clamped / 100)

Wait 1
Goto MAIN

'=========================================================
' DOAS_DETERMINE_MODE_GOLD  (REVISED - STABLE WU/CD + OCC HANDOFF)
'
' PURPOSE:
'   - Evaluate unit safeties
'   - Create FREEZE_LATCH that requires BMS manual reset
'   - Output DOAS_MODE used by all other modules
'
' KEY IMPROVEMENTS (vs original):
'   1) Warm-Up/Cool-Down are STARTUP-ONLY (WUCD_MAX_TIME_S window after OCC starts)
'   2) Hysteresis on WU/CD exit to prevent mode hunting
'   3) Stores MODE_STATE so exit thresholds work correctly
'
' DOAS_MODE CODES:
'   0=OFF, 1=PRESTART (unused here), 2=WARMUP, 3=COOLDOWN, 4=OCC, 5=UNOCC-PROTECT
'
' LINKING (Inputs):
'   SCHED_OCC            <- EBO schedule (0/1)
'   MAINTENANCE          <- EBO maintenance switch (0/1)
'   MANUAL_OCC_CMD       <- EBO HOA/override (0/1) (tie 0 if unused)
'   SMOKE_SUPPLY         <- Field DI (0/1)
'   SMOKE_RETURN         <- Field DI (0/1)
'   HIGH_DISCH_PRESS_SW  <- Field DI (0/1)
'   LOW_SUCTION_PRESS_SW <- Field DI (0/1)
'   FREEZE_STAT          <- Field DI (0/1)
'   FREEZE_RESET_CMD     <- EBO momentary command/button (0/1)   (PUBLIC so UI can write it)
'   LEAK_ALARM           <- Field DI (0/1)
'   RA_TEMP              <- EBO AI (°F)
'   SPACE_TEMP_MIN       <- From space/VAV aggregator (°F) (tie 0 if not available)
'   FREEZE_TEMP          <- From sensor-watch program (<38°F alarm etc.) (0/1)
'
' LINKING (Outputs):
'   DOAS_MODE            -> To all modules
'   SAFETY_OK            -> To all modules (general trips)
'   FREEZE_LATCH         -> To all modules (special freeze behavior)
'   OCC_REQUEST          -> Optional UI/monitoring
'
'=========================================================

NUMERIC INPUT SCHED_OCC
NUMERIC INPUT MAINTENANCE
NUMERIC INPUT MANUAL_OCC_CMD

NUMERIC INPUT FREEZE_TEMP
NUMERIC INPUT SMOKE_SUPPLY
NUMERIC INPUT SMOKE_RETURN
NUMERIC INPUT HIGH_DISCH_PRESS_SW
NUMERIC INPUT LOW_SUCTION_PRESS_SW
NUMERIC INPUT FREEZE_STAT
NUMERIC PUBLIC FREEZE_RESET_CMD
NUMERIC INPUT LEAK_ALARM

NUMERIC INPUT RA_TEMP
NUMERIC INPUT SPACE_TEMP_MIN

NUMERIC OUTPUT DOAS_MODE
NUMERIC OUTPUT SAFETY_OK
NUMERIC OUTPUT FREEZE_LATCH
NUMERIC OUTPUT OCC_REQUEST

NUMERIC INPUT WARMUP_START
NUMERIC INPUT COOLDN_START
NUMERIC INPUT UNOCC_LOW_START
NUMERIC INPUT UNOCC_HI_START

'---------------------- NEW TUNABLES ----------------------
NUMERIC INPUT WU_EXIT_DB
' Warmup exit hysteresis (°F). Example: 2.0 means exit warmup at WARMUP_START + 2°F

NUMERIC INPUT CD_EXIT_DB
' Cooldown exit hysteresis (°F). Example: 2.0 means exit cooldown at COOLDN_START - 2°F

NUMERIC INPUT WUCD_MAX_TIME_S
' Startup-only window (seconds) after OCC starts during which WU/CD is allowed.
' After this expires, mode is forced to OCC (4) until occupancy ends.

'---------------------- INTERNALS --------------------------
NUMERIC ANY_SMOKE
NUMERIC ANY_PRESS_TRIP
NUMERIC REF_TEMP
NUMERIC OCC_RAW
NUMERIC TRIP_ANY

NUMERIC LAST_OCC_REQUEST
NUMERIC OCC_TIMER
NUMERIC WUCD_ALLOWED
NUMERIC MODE_STATE

GOTO INIT

INIT:
    DOAS_MODE = 0
    SAFETY_OK = 1
    FREEZE_LATCH = 0
    OCC_REQUEST = 0

    ' Defaults (safe, typical; you can override in EBO)
   
    LAST_OCC_REQUEST = 0
    OCC_TIMER = 0
    MODE_STATE = 0

    GOTO MAIN

MAIN:
    '---------------- SAFETY INPUT AGGREGATION ----------------
    ANY_SMOKE = (SMOKE_SUPPLY OR SMOKE_RETURN)
    ANY_PRESS_TRIP = (HIGH_DISCH_PRESS_SW OR LOW_SUCTION_PRESS_SW)

    '---------------- FREEZE LATCH ----------------------------
    ' Latch on any freeze indication
    IF (FREEZE_STAT = 1) OR (FREEZE_TEMP = 1) THEN
        FREEZE_LATCH = 1
    ENDIF

    ' Clear only when BOTH freeze inputs are normal AND reset is pressed
    IF FREEZE_LATCH = 1 THEN
        IF (FREEZE_STAT = 0) AND (FREEZE_TEMP = 0) AND (FREEZE_RESET_CMD = 1) THEN
            FREEZE_LATCH = 0
        ENDIF
    ENDIF

    '---------------- SAFETY_OK -------------------------------
    TRIP_ANY = 0
    IF ANY_SMOKE = 1 THEN TRIP_ANY = 1
    IF ANY_PRESS_TRIP = 1 THEN TRIP_ANY = 1
    IF LEAK_ALARM = 1 THEN TRIP_ANY = 1
    IF FREEZE_LATCH = 1 THEN TRIP_ANY = 1

    IF TRIP_ANY = 1 THEN
        SAFETY_OK = 0
    ELSE
        SAFETY_OK = 1
    ENDIF

    '---------------- OCC REQUEST -----------------------------
    OCC_RAW = 0
    IF (SCHED_OCC = 1) OR (MANUAL_OCC_CMD = 1) THEN
        OCC_RAW = 1
    ENDIF

    IF MAINTENANCE = 1 THEN
        OCC_REQUEST = 0
    ELSE
        OCC_REQUEST = OCC_RAW
    ENDIF

    '---------------- MODE: SAFETY OVERRIDE -------------------
    IF SAFETY_OK = 0 THEN
        DOAS_MODE = 0
        MODE_STATE = 0
        OCC_TIMER = 0
        LAST_OCC_REQUEST = OCC_REQUEST
        WAIT 1
        GOTO MAIN
    ENDIF

    '=========================================================
    ' OCCUPIED PATH (STABLE WU/CD + OCC HANDOFF)
    '=========================================================
    IF OCC_REQUEST = 1 THEN

        ' Detect OCC start edge (0 -> 1)
        IF LAST_OCC_REQUEST = 0 THEN
            OCC_TIMER = 0
            ' Start in OCC, then allow immediate evaluation to WU/CD below
            MODE_STATE = 4
        ENDIF

        ' Startup timer accumulation (caps at WUCD_MAX_TIME_S)
        IF OCC_TIMER < WUCD_MAX_TIME_S THEN
            OCC_TIMER = OCC_TIMER + 1
        ENDIF

        ' Allow WU/CD only during the startup window
        IF OCC_TIMER < WUCD_MAX_TIME_S THEN
            WUCD_ALLOWED = 1
        ELSE
            WUCD_ALLOWED = 0
        ENDIF

        ' If startup window expired -> force OCC steady-state
        IF WUCD_ALLOWED = 0 THEN
            MODE_STATE = 4
            DOAS_MODE = 4
            LAST_OCC_REQUEST = OCC_REQUEST
            WAIT 1
            GOTO MAIN
        ENDIF

        '---------- HYSTERESIS STATE MACHINE ----------
        ' If currently WARMUP: stay WARMUP until RA_TEMP >= WARMUP_START + WU_EXIT_DB
        IF MODE_STATE = 2 THEN
            IF RA_TEMP >= (WARMUP_START + WU_EXIT_DB) THEN
                MODE_STATE = 4
            ELSE
                MODE_STATE = 2
            ENDIF

        ELSE
            ' If currently COOLDOWN: stay COOLDOWN until RA_TEMP <= COOLDN_START - CD_EXIT_DB
            IF MODE_STATE = 3 THEN
                IF RA_TEMP <= (COOLDN_START - CD_EXIT_DB) THEN
                    MODE_STATE = 4
                ELSE
                    MODE_STATE = 3
                ENDIF

            ELSE
                ' Otherwise (OCC or anything else): decide whether to ENTER WU/CD
                IF RA_TEMP < WARMUP_START THEN
                    MODE_STATE = 2
                ELSE
                    IF RA_TEMP > COOLDN_START THEN
                        MODE_STATE = 3
                    ELSE
                        MODE_STATE = 4
                    ENDIF
                ENDIF

            ENDIF
        ENDIF

        DOAS_MODE = MODE_STATE

    '=========================================================
    ' UNOCCUPIED PATH (PROTECT OR OFF)
    '=========================================================
    ELSE

        ' Reset occupied timer/state when not occupied
        OCC_TIMER = 0
        WUCD_ALLOWED = 0

        REF_TEMP = RA_TEMP
        IF SPACE_TEMP_MIN > 0 THEN REF_TEMP = SPACE_TEMP_MIN

        IF (REF_TEMP < UNOCC_LOW_START) OR (REF_TEMP > UNOCC_HI_START) THEN
            DOAS_MODE = 5
            MODE_STATE = 5
        ELSE
            DOAS_MODE = 0
            MODE_STATE = 0
        ENDIF

    ENDIF

    LAST_OCC_REQUEST = OCC_REQUEST

    WAIT 1
    GOTO MAIN

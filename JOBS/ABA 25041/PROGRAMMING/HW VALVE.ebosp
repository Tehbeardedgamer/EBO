'============================
' Script: HW_Valve_Control
' Purpose: Control hot water valve
'============================

NUMERIC INPUT MODE_HEAT, MODE_DEHUM
NUMERIC INPUT ZN_T, ZN_T_SP
NUMERIC OUTPUT HW_VALVE_CMD

' PID tuning & memory vars
NUMERIC I, OLDERR1, OLDERR2,PK, IK, DK
FUNCTION PIDLOOP

INI:
  HW_VALVE_CMD = 0
  I = 0
  OLDERR1= 0
  OLDERR2= 0
  PK = 0.5
  IK = 0.1
  DK = 0.01
  GOTO CONTROL_LOOP

CONTROL_LOOP:

HW_VALVE_CMD = 0

IF MODE_HEAT = 1 THEN GOTO HEATING
IF MODE_DEHUM = 1 THEN GOTO DEHUMID
GOTO NEUTRAL

'----------------------
HEATING:
  HW_VALVE_CMD = PIDLOOP(0, ZN_T, ZN_T_SP, I, PK, IK, DK, OLDERR1)
  OLDERR2 = 0
  GOTO ENDLOOP

DEHUMID:
  HW_VALVE_CMD = PIDLOOP(0, ZN_T, ZN_T_SP, I, PK, IK, DK, OLDERR2)
  OLDERR1 = 0
  GOTO ENDLOOP

NEUTRAL:
  HW_VALVE_CMD = 0
  GOTO ENDLOOP

ENDLOOP:
WAIT 10
GOTO CONTROL_LOOP

'==============================================================================
' AHU_COLD_DECK_FAN_REQUEST
'
' PURPOSE:
'   Generate requested cold deck fan enable and speed for normal AHU operation.
'
' FUNCTION:
'   - In occupied normal and dehumidification mode, fan modulates to maintain
'     CD_STATIC_SP.
'   - If VFD is faulted, request is forced off.
'   - In all other modes, request is off and PID is reset.
'
' NOTES:
'   - Arbiter owns smoke / freeze / startup / final override behavior.
'==============================================================================

FUNCTION PIDControl

'-----------------------------
' MODE INPUTS
'-----------------------------
NUMERIC INPUT NORMAL_ENABLE
NUMERIC INPUT MODE_CODE

'-----------------------------
' PROCESS INPUTS
'-----------------------------
NUMERIC INPUT CD_DUCT_STATIC
NUMERIC INPUT CD_STATIC_SP

'-----------------------------
' HARDWARE INPUTS
'-----------------------------
NUMERIC INPUT CD_VFD_FAULT

'-----------------------------
' ADJUSTABLE INPUTS
'-----------------------------
NUMERIC INPUT CD_FAN_PID_P
NUMERIC INPUT CD_FAN_PID_I
NUMERIC INPUT CD_FAN_PID_D
NUMERIC INPUT CD_FAN_OFF_SPEED

'-----------------------------
' OUTPUTS
'-----------------------------
NUMERIC OUTPUT CD_FAN_SS_REQ
NUMERIC OUTPUT CD_FAN_SPEED_REQ
NUMERIC OUTPUT CD_FAN_PID_OUT

'-----------------------------
' INTERNALS
'-----------------------------
NUMERIC CD_FAN_PID_I_TERM
NUMERIC CD_FAN_PID_OLD_ERR
NUMERIC CD_FAN_ACTIVE_SPEED
NUMERIC CD_FAN_ENABLE
NUMERIC CD_FAN_LOOP_PERMITTED

'==============================================================================
' DEFAULTS
'==============================================================================
CD_FAN_ENABLE = 0
CD_FAN_ACTIVE_SPEED = CD_FAN_OFF_SPEED
CD_FAN_PID_OUT = 0
CD_FAN_LOOP_PERMITTED = 0

'==============================================================================
' LOOP PERMIT
'   MODE_CODE 2 = OCCUPIED NORMAL
'   MODE_CODE 3 = DEHUMIDIFICATION
'==============================================================================
IF CD_VFD_FAULT = 0 THEN
  IF NORMAL_ENABLE = 1 THEN
    IF MODE_CODE = 2 OR MODE_CODE = 3 THEN
      CD_FAN_LOOP_PERMITTED = 1
      CD_FAN_ENABLE = 1
    ENDIF
  ENDIF
ENDIF

'==============================================================================
' PID CONTROL
'==============================================================================
IF CD_FAN_LOOP_PERMITTED = 1 THEN
  CD_FAN_PID_OUT = PIDControl(0, CD_DUCT_STATIC, CD_STATIC_SP, CD_FAN_PID_I_TERM, CD_FAN_PID_P, CD_FAN_PID_I, CD_FAN_PID_D, CD_FAN_PID_OLD_ERR)
  CD_FAN_ACTIVE_SPEED = CD_FAN_PID_OUT
ENDIF

'==============================================================================
' PID RESET WHEN NOT PERMITTED
'==============================================================================
IF CD_FAN_LOOP_PERMITTED = 0 THEN
  CD_FAN_PID_I_TERM = 0
  CD_FAN_PID_OLD_ERR = 0
  CD_FAN_ACTIVE_SPEED = CD_FAN_OFF_SPEED
  CD_FAN_PID_OUT = 0
ENDIF

'==============================================================================
' FINAL HARD CLAMPS
'==============================================================================
IF CD_FAN_ACTIVE_SPEED < 0 THEN
  CD_FAN_ACTIVE_SPEED = 0
ENDIF

IF CD_FAN_ACTIVE_SPEED > 100 THEN
  CD_FAN_ACTIVE_SPEED = 100
ENDIF

'==============================================================================
' FINAL OUTPUTS
'==============================================================================
CD_FAN_SS_REQ = CD_FAN_ENABLE
CD_FAN_SPEED_REQ = CD_FAN_ACTIVE_SPEED

WAIT 3
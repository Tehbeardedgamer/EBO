'=========================================================
' DOAS_SF_Module (FIXED - PID section now reachable)
'=========================================================

NUMERIC INPUT DOAS_MODE
NUMERIC INPUT SAFETY_OK
NUMERIC INPUT FREEZE_STAT
NUMERIC INPUT DUCT_STATIC
NUMERIC INPUT DUCT_STATIC_SP
NUMERIC INPUT SAF_STATUS_A,SAF_STATUS_B
NUMERIC INPUT SF_FAULT

NUMERIC OUTPUT SF_SS_CALC
NUMERIC OUTPUT SF_SPEED_CALC
NUMERIC OUTPUT SF_READY
NUMERIC OUTPUT SF_FAIL
NUMERIC OUTPUT ALM_LOW_STATIC

NUMERIC INPUT KP, KI, KD
NUMERIC PUBLIC I_TERM, OLD_ERR

NUMERIC PUBLIC MIN_WARMUP
NUMERIC PUBLIC MIN_COOLDN
NUMERIC PUBLIC MIN_OCC
NUMERIC PUBLIC MIN_PROTECT
NUMERIC PUBLIC MAX_SPEED

NUMERIC PUBLIC RATE_UP_PCT_S
NUMERIC PUBLIC RATE_DN_PCT_S
NUMERIC PUBLIC CMD_DEADBAND

NUMERIC PUBLIC PROVE_TIMEOUT_S
NUMERIC PUBLIC LOW_STATIC_ERR_THR
NUMERIC PUBLIC LOW_STATIC_TIME_S

FUNCTION PID_LOOP

NUMERIC last_cmd
NUMERIC t_prove
NUMERIC t_lowstatic
NUMERIC min_speed
NUMERIC SAF_CALC
NUMERIC e_sp

GOTO INI

INI:
  

   MIN_WARMUP = 25
   MIN_COOLDN = 25
   MIN_OCC = 20
   MIN_PROTECT = 15

   MAX_SPEED = 100

   RATE_UP_PCT_S = 10
   RATE_DN_PCT_S = 15
   CMD_DEADBAND = 0.5

   PROVE_TIMEOUT_S = 20
   LOW_STATIC_ERR_THR = 0.15
   LOW_STATIC_TIME_S = 60

    last_cmd = 0
    I_TERM = 0
    OLD_ERR = 0
    t_prove = 0
    t_lowstatic = 0

    
    SF_READY = 1
    SF_FAIL = 0
    ALM_LOW_STATIC = 0
    GOTO MAIN


MAIN:
    SF_FAIL = 0
    ALM_LOW_STATIC = 0
    SF_READY = 1

    ' ---------- SAFETY GATING ----------
    IF (SAFETY_OK = 0) OR (FREEZE_STAT = 1) THEN
        SF_SS_CALC = 0
        SF_SPEED_CALC = 0
        last_cmd = 0
        I_TERM = 0
        t_prove = 0
        t_lowstatic = 0
        WAIT 1
        GOTO MAIN
    ENDIF

    ' ---------- OFF / PRESTART ----------
    IF (DOAS_MODE = 0) OR (DOAS_MODE = 1) THEN
        SF_SS_CALC = 0
        SF_SPEED_CALC = 0
        last_cmd = 0
        I_TERM = 0
        t_prove = 0
        t_lowstatic = 0
        WAIT 1
        GOTO MAIN
    ENDIF

    ' ---------- DETERMINE MODE MINIMUM SPEED ----------
    IF DOAS_MODE = 2 THEN
        min_speed = MIN_WARMUP
    ELSE
        IF DOAS_MODE = 3 THEN
            min_speed = MIN_COOLDN
        ELSE
            IF DOAS_MODE = 4 THEN
                min_speed = MIN_OCC
            ELSE
                IF DOAS_MODE = 5 THEN
                    min_speed = MIN_PROTECT
                ELSE
                    min_speed = MIN_OCC
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    ' ---------- RUNNING MODES ----------
    SF_SS_CALC = 1

    ' ---------- PID ----------
    SAF_CALC = PID_LOOP(0, DUCT_STATIC, DUCT_STATIC_SP, I_TERM, KP, KI, KD, OLD_ERR)

    ' Clamp & anti-windup
    'IF SAF_CALC > MAX_SPEED THEN
    '    SAF_CALC = MAX_SPEED
    '    e_sp = (DUCT_STATIC_SP - DUCT_STATIC)
     '   IF e_sp > 0 THEN I_TERM = I_TERM - (KI * e_sp)
    'ENDIF

    'IF SAF_CALC < 0 THEN
    '    SAF_CALC = 0
     '   e_sp = (DUCT_STATIC_SP - DUCT_STATIC)
     '   IF e_sp < 0 THEN I_TERM = I_TERM - (KI * e_sp)
    'ENDIF

    IF SAF_CALC < min_speed THEN SAF_CALC = min_speed

    ' Ramp limit
   IF SAF_CALC > last_cmd + RATE_UP_PCT_S THEN
       SF_SPEED_CALC = last_cmd + RATE_UP_PCT_S
    ELSE
     IF SAF_CALC < last_cmd - RATE_DN_PCT_S THEN
           SF_SPEED_CALC = last_cmd - RATE_DN_PCT_S
       ELSE
           SF_SPEED_CALC = SAF_CALC
       ENDIF
    ENDIF

    ' Deadband
    IF ABS(SF_SPEED_CALC - last_cmd) < CMD_DEADBAND THEN
        SF_SPEED_CALC = last_cmd
    ENDIF
    last_cmd = SF_SPEED_CALC

    ' Proof
    IF SF_SS_CALC = 1 THEN
        IF SAF_STATUS_A = 1 OR SAF_STATUS_B = 1 THEN
            t_prove = 0
        ELSE
            IF t_prove < PROVE_TIMEOUT_S THEN
                t_prove = t_prove + 1
            ELSE
                SF_FAIL = 1
            ENDIF
        ENDIF
    ELSE
        t_prove = 0
    ENDIF

   
GOTO WAITLOOP
WAITLOOP:
    WAIT 1
    GOTO MAIN

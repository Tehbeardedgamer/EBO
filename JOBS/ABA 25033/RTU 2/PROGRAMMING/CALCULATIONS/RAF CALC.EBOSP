'===========================================================
' MODULE: RTU2_RAF_CALC
' PURPOSE: Maintain OA differential via Return Fan
'===========================================================

NUMERIC INPUT SA_FLOW, RA_FLOW, OA_DIFF_SP
NUMERIC INPUT RAF_MIN_SPEED, RAF_MAX_SPEED
NUMERIC OUTPUT RAF_SPEED_CALC
NUMERIC PUBLIC FLOW_DIFF

NUMERIC OLDERR, PK, IK, DK, I_FAN, OUT
FUNCTION PID_CTRL

GOTO INITIALIZE

INITIALIZE:
OLDERR = 0
PK = 0.01
IK = 0.001
DK = 0.0001
I_FAN = 50

GOTO LOGIC
LOGIC:
FLOW_DIFF = SA_FLOW - RA_FLOW
OUT = PID_CTRL(0, FLOW_DIFF, OA_DIFF_SP, I_FAN, PK, IK, DK, OLDERR)

IF OUT < RAF_MIN_SPEED THEN OUT = RAF_MIN_SPEED
IF OUT > RAF_MAX_SPEED THEN OUT = RAF_MAX_SPEED

RAF_SPEED_CALC = OUT

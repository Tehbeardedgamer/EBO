NUMERIC INPUT PW_RETURN_TEMP, HW_RETURN_TEMP,HW_SUPPLY_TEMP,HW_SUPPLY_TEMP_SP
NUMERIC OUTPUT BOILER_SS_A, BOILER_SS_B


GOTO WATCHING

WATCHING:

IF HW_SUPPLY_TEMP > HW_SUPPLY_TEMP_SP THEN
BOILER_SS_A =0
ENDIF
IF (TS > 300)& (HW_SUPPLY_TEMP < HW_SUPPLY_TEMP_SP) THEN GOTO BOILER_MODE

BOILER_MODE:
BOILER_SS_A = 1
BOILER_SS_B = 1

GOTO WAIT_LOOP

WAIT_LOOP:

IF TS > 10 THEN GOTO WATCHING
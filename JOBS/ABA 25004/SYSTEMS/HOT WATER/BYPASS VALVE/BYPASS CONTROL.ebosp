
NUMERIC INPUT HW_SUPPLY_TEMP, HW_SUPPLY_TEMP_SP
NUMERIC OUTPUT HW_VALVE_CMD_BYPASS_CALC
NUMERIC IK,PK,DK,OLDERR, I_VALVE
FUNCTION PID_V5
GOTO INITALIZE

INITALIZE:

IK = 0.2
PK = 1.0
DK = 0.0
OLDERR = 0
I_VALVE = 0

GOTO CONTROL_LOOP

CONTROL_LOOP:
HW_VALVE_CMD_BYPASS_CALC = PID_V5(0,HW_SUPPLY_TEMP,HW_SUPPLY_TEMP_SP,I_VALVE,PK,IK,DK,OLDERR)
WAIT 10
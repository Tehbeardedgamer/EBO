'==============================================================================
' MAU_SYS_LEAD_STANDBY
'
' Responsibilities (per SoO):
' - Weekly lead assignment rotation (N+1 lead/standby)
' - Enforce only one MAU enabled at a time under normal conditions
' - Maintenance Mode changeover (selected unit shuts down, standby starts)
' - Lead failure changeover
' - Standby coil Lead/purge: command standby HW preheat + CHW valves full open
'   for 2 minutes BEFORE starting standby; keep Lead until standby is proven running
' - Maintenance > 24h alarm (separate from unit alarm suppression handled elsewhere)
'
' NOTE:
' - Lead failure detection criteria are NOT defined in SoO; therefore this program
'   consumes MAU#_Failure inputs from IO/SAFETIES and does not invent timeouts.
' - If both units are unavailable (failed or both in maintenance), no unit is enabled.
'==============================================================================

'-----------------------------
' PUBLIC INPUTS (Bindings)
'-----------------------------
NUMERIC INPUT Sys_Enable
NUMERIC INPUT MAU1_Failure
NUMERIC INPUT MAU2_Failure
NUMERIC INPUT MAU1_RunningProof
NUMERIC INPUT MAU2_RunningProof
NUMERIC INPUT MAU1_MaintMode
NUMERIC INPUT MAU2_MaintMode
NUMERIC INPUT AutoRotateEnable
NUMERIC INPUT PurgeTimer ' in seconds (e.g., 120 for 2 minutes)
'-----------------------------
' OUTPUTS (Bindings)
'-----------------------------
NUMERIC OUTPUT MAU1_EnableCmd
NUMERIC OUTPUT MAU2_EnableCmd
NUMERIC OUTPUT MAU1_PrimeCmd
NUMERIC OUTPUT MAU2_PrimeCmd
NUMERIC OUTPUT MAU1_Lead
NUMERIC OUTPUT MAU2_Lead
NUMERIC OUTPUT LeadUnitNumber     ' 1 or 2
NUMERIC OUTPUT ActiveUnitNumber   ' 0, 1, or 2
NUMERIC OUTPUT LeadFailAlarm
NUMERIC OUTPUT MAU1_MaintOver24h_Alm
NUMERIC OUTPUT MAU2_MaintOver24h_Alm


'-----------------------------
' INTERNAL VARIABLES
'-----------------------------
NUMERIC DesiredActive
NUMERIC StandbyUnit
NUMERIC SwState
NUMERIC FromUnit
NUMERIC ToUnit
DATETIME PUBLIC LastRotateDT
NUMERIC T_Maint1
NUMERIC T_Maint2
NUMERIC Done_Maint1
NUMERIC Done_Maint2

'-----------------------------
' FUNCTIONS USED
'-----------------------------
FUNCTION Sectimer


'==============================================================================
INIT:
'==============================================================================

    LeadUnitNumber = 1
    LastRotateDT = Date
    SwState = 0
    FromUnit = 0
    ToUnit = 0
    MAU1_EnableCmd = 0
    MAU2_EnableCmd = 0
    MAU1_PrimeCmd = 0
    MAU2_PrimeCmd = 0
    MAU1_Lead = 0
    MAU2_Lead = 0
    ActiveUnitNumber = 0
    LeadFailAlarm = 0
    MAU1_MaintOver24h_Alm = 0
    MAU2_MaintOver24h_Alm = 0
    T_Maint1 = 0
    T_Maint2 = 0
    Done_Maint1 = 0
    Done_Maint2 = 0

    Goto MAIN


    '==============================================================================
MAIN:
    '==============================================================================

    '-----------------------------
    ' Weekly lead rotation (every 7 days)
    '-----------------------------
    If AutoRotateEnable is ON then
        If Difftime(WKD, LastRotateDT, Date) >= 7 then
            If LeadUnitNumber EQUALS 1 then
                LeadUnitNumber = 2
            Else
                LeadUnitNumber = 1
            EndIf
            LastRotateDT = Date
        EndIf
    EndIf


    '-----------------------------
    ' Compute StandbyUnit from LeadUnitNumber
    '-----------------------------
    If LeadUnitNumber EQUALS 1 then
        StandbyUnit = 2
    Else
        StandbyUnit = 1
    EndIf

    '-----------------------------
    ' Lead failure alarm (annunciate to BAS)
    '-----------------------------
    LeadFailAlarm = 0
    If LeadUnitNumber EQUALS 1 then
        If MAU1_Failure is ON then LeadFailAlarm = 1
    Else
        If MAU2_Failure is ON then LeadFailAlarm = 1
    EndIf

    '-----------------------------
    ' Maintenance >24h alarms (per-unit)
    '-----------------------------
    If MAU1_MaintMode is OFF then T_Maint1 = 0
    If MAU2_MaintMode is OFF then T_Maint2 = 0

    Done_Maint1 = Sectimer(MAU1_MaintMode, 86400, T_Maint1, 0)
    Done_Maint2 = Sectimer(MAU2_MaintMode, 86400, T_Maint2, 0)

    MAU1_MaintOver24h_Alm = 0
    MAU2_MaintOver24h_Alm = 0
    If Done_Maint1 is ON then MAU1_MaintOver24h_Alm = 1
    If Done_Maint2 is ON then MAU2_MaintOver24h_Alm = 1

    '-----------------------------
    ' Determine DesiredActive based on enable + priority constraints:
    ' - If Sys disabled -> none
    ' - Maintenance forces the other unit (if available)
    ' - Otherwise run Lead if available, else Standby if available, else none
    ' "Available" here means NOT failed and NOT in Maintenance Mode.
    '-----------------------------
    DesiredActive = 0

    If Sys_Enable is OFF then
        DesiredActive = 0
    Else
        ' Maintenance forced changeover
        If (MAU1_MaintMode is ON) AND (MAU2_MaintMode is OFF) AND (MAU2_Failure is OFF) then
            DesiredActive = 2
        Else
            If (MAU2_MaintMode is ON) AND (MAU1_MaintMode is OFF) AND (MAU1_Failure is OFF) then
                DesiredActive = 1
            Else
                ' Normal lead/standby
                If LeadUnitNumber EQUALS 1 then
                    If (MAU1_Failure is OFF) AND (MAU1_MaintMode is OFF) then
                        DesiredActive = 1
                    Else
                        If (MAU2_Failure is OFF) AND (MAU2_MaintMode is OFF) then
                            DesiredActive = 2
                        Else
                            DesiredActive = 0
                        EndIf
                    EndIf
                Else
                    If (MAU2_Failure is OFF) AND (MAU2_MaintMode is OFF) then
                        DesiredActive = 2
                    Else
                        If (MAU1_Failure is OFF) AND (MAU1_MaintMode is OFF) then
                            DesiredActive = 1
                        Else
                            DesiredActive = 0
                        EndIf
                    EndIf
                EndIf
            EndIf
        EndIf
    EndIf

    '-----------------------------
    ' State machine for changeover with 2-minute Lead before start
    '-----------------------------
    If SwState EQUALS 0 then
        ' If no change required, hold commands
        If ActiveUnitNumber EQUALS DesiredActive then
            Goto APPLY_OUTPUTS
        EndIf

        ' Begin changeover
        FromUnit = ActiveUnitNumber
        ToUnit = DesiredActive

        ' Stop everything first
        MAU1_EnableCmd = 0
        MAU2_EnableCmd = 0
        MAU1_PrimeCmd = 0
        MAU2_PrimeCmd = 0

        ' Clear Leads initially
        MAU1_Lead = 0
        MAU2_Lead = 0

        If ToUnit EQUALS 0 then
            ActiveUnitNumber = 0
            SwState = 0
            Goto APPLY_OUTPUTS
        EndIf

        ' Assert Lead on ToUnit (valves full open handled in IO/SAFETIES)
        If ToUnit EQUALS 1 then
            MAU1_Lead = 1
        Else
            MAU2_Lead = 1
        EndIf

        SwState = 10
        Goto Lead_WAIT
    EndIf

    ' If we are mid-changeover, keep running the correct state
    If SwState EQUALS 10 then Goto Lead_WAIT
    If SwState EQUALS 20 then Goto START_WAIT


    '==============================================================================
Lead_WAIT:
    '==============================================================================

    ' Keep only the ToUnit Lead asserted
    MAU1_Lead = 0
    MAU2_Lead = 0
    MAU1_PrimeCmd = 0
    MAU2_PrimeCmd = 0
    If ToUnit EQUALS 1 then
        MAU1_Lead = 1
        MAU1_PrimeCmd = 1
    Else
        If ToUnit EQUALS 2 then
            MAU2_Lead = 1
            MAU2_PrimeCmd = 1
        EndIf
    EndIf

    ' Wait the specified Lead time on this line (TS counts time on current line)
    If TS < PurgeTimer then
        Goto APPLY_OUTPUTS
    EndIf

    ' After Lead time elapsed, enable the ToUnit
    MAU1_EnableCmd = 0
    MAU2_EnableCmd = 0
    MAU1_PrimeCmd = 0
    MAU2_PrimeCmd = 0
    If ToUnit EQUALS 1 then
        MAU1_EnableCmd = 1
    Else
        If ToUnit EQUALS 2 then
            MAU2_EnableCmd = 1
        EndIf
    EndIf

    SwState = 20
    Goto START_WAIT


    '==============================================================================
START_WAIT:
    '==============================================================================

    ' Keep ToUnit enabled; keep ToUnit Lead asserted until RunningProof is confirmed
    MAU1_EnableCmd = 0
    MAU2_EnableCmd = 0
    MAU1_Lead = 0
    MAU2_Lead = 0
    MAU1_PrimeCmd = 0
    MAU2_PrimeCmd = 0

    If ToUnit EQUALS 1 then
        MAU1_EnableCmd = 1
        MAU1_Lead = 1
        If MAU1_RunningProof is ON then
            MAU1_Lead = 0
            ActiveUnitNumber = 1
            SwState = 0
        EndIf
    Else
        If ToUnit EQUALS 2 then
            MAU2_EnableCmd = 1
            MAU2_Lead = 1
            If MAU2_RunningProof is ON then
                MAU2_Lead = 0
                ActiveUnitNumber = 2
                SwState = 0
            EndIf
        EndIf
    EndIf

    Goto APPLY_OUTPUTS


    '==============================================================================
APPLY_OUTPUTS:
    '==============================================================================

    ' Ensure only one enable is asserted in steady state.
    If SwState EQUALS 0 then
        MAU1_Lead = 0
        MAU2_Lead = 0
        MAU1_PrimeCmd = 0
        MAU2_PrimeCmd = 0

        MAU1_EnableCmd = 0
        MAU2_EnableCmd = 0

        If ActiveUnitNumber EQUALS 1 then
            MAU1_EnableCmd = 1
        Else
            If ActiveUnitNumber EQUALS 2 then
                MAU2_EnableCmd = 1
            EndIf
        EndIf
    EndIf
    ' Simple loop delay; keep tight but non-zero to avoid thrash
    Wait 1
    Goto MAIN

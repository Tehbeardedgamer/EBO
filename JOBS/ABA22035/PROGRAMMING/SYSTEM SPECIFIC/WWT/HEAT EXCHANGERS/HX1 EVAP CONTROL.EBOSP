NUMERIC INPUT TEMP, COOLING_SP, HEATING_SP, ACTIVE_HX, HX_NUMBER,HEATING_ENABLED,COOLING_ENABLED
NUMERIC OUTPUT VALVE_CMD, VALVE_ENABLED
NUMERIC I_VALVE_COOL, I_VALVE_HEAT, OLDERR_COOL, OLDERR_HEAT,COOLING_HYST, HEATING_HYST
NUMERIC PK_COOL, IK_COOL, DK_COOL, PK_HEAT, IK_HEAT, DK_HEAT
FUNCTION PID_PUMP

GOTO INITIALIZE

INITIALIZE:
    ' Initialize PID parameters
    I_VALVE_COOL = 0
    OLDERR_COOL = 0
    PK_COOL = 1
    IK_COOL = 0.1
    DK_COOL = 0.01

    I_VALVE_HEAT = 0
    OLDERR_HEAT = 0
    PK_HEAT = 1
    IK_HEAT = 0.1
    DK_HEAT = 0.01

    COOLING_HYST = 1  ' Prevent rapid cooling activation
    HEATING_HYST = 1  ' Prevent rapid heating activation
    GOTO CHECK_IFACTIVE

 CHECK_IFACTIVE:
    ' Ensure only the active heat exchanger is enabled
    IF ACTIVE_HX <> HX_NUMBER THEN 
        VALVE_CMD = 0
        VALVE_ENABLED = 0
    ELSE 
        GOTO CONTROL_LOOP
    ENDIF
CONTROL_LOOP:   
    ' Check if cooling is needed
    IF TEMP > (COOLING_SP + COOLING_HYST) AND COOLING_ENABLED = 1 THEN
        VALVE_CMD = PID_PUMP(1, TEMP, COOLING_SP, I_VALVE_COOL, PK_COOL, IK_COOL, DK_COOL, OLDERR_COOL)
    ' Check if heating is needed
    ELSE
    IF TEMP < (HEATING_SP - HEATING_HYST) AND HEATING_ENABLED = 1 THEN
        VALVE_CMD = PID_PUMP(0, TEMP, HEATING_SP, I_VALVE_HEAT, PK_HEAT, IK_HEAT, DK_HEAT, OLDERR_HEAT)
    ELSE
        VALVE_CMD = VALVE_CMD
    ENDIF
    ENDIF

    ' Enable the valve if PID control output is above 5%
    IF VALVE_CMD > 5 THEN 
        VALVE_ENABLED = 1
    ELSE 
        VALVE_ENABLED = 0
    ENDIF

    GOTO WAIT_LOOP

    WAIT_LOOP:
    IF TS> 5 THEN GOTO CHECK_IFACTIVE

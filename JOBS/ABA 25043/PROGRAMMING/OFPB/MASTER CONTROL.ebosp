' =========================================================
' PROGRAM: FPB_IO_AND_SAFETIES
' PURPOSE:
'   - Final output authority for FPB fan, ECM speed, damper, electric reheat
'   - Interlocks reheat for safety
'   - Generates fan fail + reheat high limit alarms
' =========================================================

' ========================== INPUTS =========================
NUMERIC INPUT FPB_ENABLED
NUMERIC INPUT OCCUPIED_CMD

NUMERIC INPUT DAMPER_CMD           ' 0-100 from control module
NUMERIC INPUT REHEAT_CMD           ' 0-100 from control module

' Fan/airflow proofs (hardware dependent)
NUMERIC INPUT FPB_FAN_STATUS       ' 0/1 - fan proof (if available)
NUMERIC INPUT AIRFLOW_PROOF        ' 0/1 - airflow switch/proof for reheat (if available)

' Reheat safety
NUMERIC INPUT REHEAT_HIGH_LIMIT    ' 0/1 - high limit trip (1=tripped)
NUMERIC INPUT ALARM_RESET          ' 0/1 - manual reset momentary

NUMERIC INPUT FAN_FAIL_DELAY_MIN   ' Minutes
NUMERIC INPUT ECM_SPEED_PRESET     ' 0-100% preset speed from TAB/balancing

' ========================== OUTPUTS ========================
NUMERIC OUTPUT SAF_SS          ' 0/1 start command
NUMERIC OUTPUT SAF_SPEED_CMD       ' 0-100% (constant preset in occupied)
' NUMERIC OUTPUT DAMPER_OUT          ' 0-100%
NUMERIC OUTPUT REHEAT_SCR_OUT      ' 0-100%

NUMERIC OUTPUT ALM_FAN_FAIL        ' 0/1
NUMERIC OUTPUT ALM_REHEAT_HILIM    ' 0/1 (latched)

' ========================== INTERNALS ======================
NUMERIC fan_fail_timer
NUMERIC SCR_ENABLED

' ========================== PROGRAM ========================
GOTO INIT


INIT:
    SAF_SS = 0
    SAF_SPEED_CMD = 0
    ' DAMPER_OUT = 0
    REHEAT_SCR_OUT = 0

    ALM_FAN_FAIL = 0
    ALM_REHEAT_HILIM = 0

    fan_fail_timer = 0

    GOTO MAIN


MAIN:

    ' -------------------------
    ' High limit latch + reset
    ' -------------------------
    IF REHEAT_HIGH_LIMIT = 1 THEN
        ALM_REHEAT_HILIM = 1
    ENDIF

    IF ALARM_RESET = 1 THEN
        ALM_REHEAT_HILIM = 0
    ENDIF

    ' -------------------------
    ' HARD DISABLE
    ' -------------------------
    IF (FPB_ENABLED = 0) OR (OCCUPIED_CMD = 0) THEN
        SAF_SS = 0
        SAF_SPEED_CMD = 0
        ' DAMPER_OUT = 0
        REHEAT_SCR_OUT = 0
        fan_fail_timer = 0
        ALM_FAN_FAIL = 0
        GOTO WAITLOOP
    ENDIF

    ' -------------------------
    ' OCCUPIED: FAN CONTINUOUS + PRESET ECM SPEED
    ' -------------------------
    SAF_SS = 1
    SAF_SPEED_CMD = ECM_SPEED_PRESET
    IF SAF_SPEED_CMD < 0 THEN SAF_SPEED_CMD = 0
    IF SAF_SPEED_CMD > 100 THEN SAF_SPEED_CMD = 100

    ' -------------------------
    ' DAMPER OUTPUT
    ' -------------------------
    ' DAMPER_OUT = DAMPER_CMD
    ' IF DAMPER_OUT < 0 THEN DAMPER_OUT = 0
    ' IF DAMPER_OUT > 100 THEN DAMPER_OUT = 100

    ' -------------------------
    ' REHEAT INTERLOCKS (SAFETY)
    ' Allowed only when:
    '  - Fan commanded ON
    '  - Airflow proven (if used)
    '  - High limit not tripped AND not latched alarm
    ' -------------------------
    
    IF (SAF_SS = 1) AND (ALM_REHEAT_HILIM = 0) THEN
        ' If airflow proof is not wired, bind AIRFLOW_PROOF to 1
        IF AIRFLOW_PROOF = 1 THEN
            SCR_ENABLED = 1
        ENDIF
    ELSE
        SCR_ENABLED = 0
    ENDIF

    IF SCR_ENABLED = 1 THEN
        REHEAT_SCR_OUT = REHEAT_CMD
        IF REHEAT_SCR_OUT < 0 THEN REHEAT_SCR_OUT = 0
        IF REHEAT_SCR_OUT > 100 THEN REHEAT_SCR_OUT = 100
    ELSE
        REHEAT_SCR_OUT = 0
    ENDIF

    ' -------------------------
    ' FAN FAILURE ALARM
    ' -------------------------
    IF SAF_SS = 1 THEN
        IF FPB_FAN_STATUS = 0 THEN
            fan_fail_timer = fan_fail_timer + 1
        ELSE
            fan_fail_timer = 0
        ENDIF
    ELSE
        fan_fail_timer = 0
    ENDIF

    IF fan_fail_timer >= FAN_FAIL_DELAY_MIN THEN
        ALM_FAN_FAIL = 1
    ELSE
        ALM_FAN_FAIL = 0
    ENDIF

WAITLOOP:
    IF TS > 1 THEN GOTO MAIN

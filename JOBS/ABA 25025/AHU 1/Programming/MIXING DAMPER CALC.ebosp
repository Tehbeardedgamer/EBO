'==============================================================================
' AHU_MIXING_DAMPER_CONTROL
'
' PURPOSE:
'   Command the mixing / outside air damper based on system mode and minimum
'   outside air requirements.
'
' SEQUENCE:
'   - In occupied operation, damper opens to the active minimum OA target.
'   - Active minimum OA target is the higher of MIN_OA_POS_BASE and
'     MIN_OA_POS_RESET.
'   - In smoke override, damper opens to SMOKE_DAMPER_POS.
'   - In MAT low protection, damper closes.
'   - In safety shutdown, system disabled, or unoccupied mode, damper closes.
'
' NOTES:
'   - This script assumes one physical damper command that controls the mixed
'     air / outdoor air damper arrangement.
'   - There is no separate ventilation control output path in this version.
'==============================================================================

'-----------------------------
' MODE INPUTS
'-----------------------------
NUMERIC INPUT UNIT_AVAILABLE
NUMERIC INPUT OCC_MODE
NUMERIC INPUT UNOCC_MODE
NUMERIC INPUT SMOKE_OVERRIDE
NUMERIC INPUT SAFETY_LOCKOUT
NUMERIC INPUT MAT_LOW

'-----------------------------
' SETPOINT INPUTS
'-----------------------------
NUMERIC INPUT MIN_OA_POS_BASE
NUMERIC INPUT MIN_OA_POS_RESET
NUMERIC INPUT SMOKE_DAMPER_POS

'-----------------------------
' ADJUSTABLE INPUTS
'-----------------------------
NUMERIC INPUT DAMPER_MIN_POS
NUMERIC INPUT DAMPER_MAX_POS

'-----------------------------
' OUTPUTS
'-----------------------------
NUMERIC OUTPUT MIXING_DAMPER_CMD
NUMERIC OUTPUT ACTIVE_MIN_OA_TARGET
NUMERIC OUTPUT DAMPER_MODE_CODE

GOTO INI

'-----------------------------
' INITIALIZATION
'-----------------------------
INI:
MIXING_DAMPER_CMD = 0
ACTIVE_MIN_OA_TARGET = 0
DAMPER_MODE_CODE = 0

GOTO MAIN

'==============================================================================
' MAIN
'==============================================================================
MAIN:

'-----------------------------
' DETERMINE ACTIVE MINIMUM OA TARGET
'-----------------------------
IF MIN_OA_POS_RESET >= MIN_OA_POS_BASE THEN
  ACTIVE_MIN_OA_TARGET = MIN_OA_POS_RESET
ENDIF

IF MIN_OA_POS_RESET < MIN_OA_POS_BASE THEN
  ACTIVE_MIN_OA_TARGET = MIN_OA_POS_BASE
ENDIF

'-----------------------------
' MODE-BASED COMMAND
'-----------------------------
IF SAFETY_LOCKOUT = 1 THEN
  MIXING_DAMPER_CMD = 0
  DAMPER_MODE_CODE = 5
  GOTO DAMPER_DONE
ENDIF

IF SMOKE_OVERRIDE = 1 THEN
  MIXING_DAMPER_CMD = SMOKE_DAMPER_POS
  DAMPER_MODE_CODE = 3
  GOTO DAMPER_DONE
ENDIF

IF MAT_LOW = 1 THEN
  MIXING_DAMPER_CMD = 0
  DAMPER_MODE_CODE = 4
  GOTO DAMPER_DONE
ENDIF

IF UNIT_AVAILABLE = 0 THEN
  MIXING_DAMPER_CMD = 0
  DAMPER_MODE_CODE = 0
  GOTO DAMPER_DONE
ENDIF

IF UNOCC_MODE = 1 THEN
  MIXING_DAMPER_CMD = 0
  DAMPER_MODE_CODE = 0
  GOTO DAMPER_DONE
ENDIF

IF OCC_MODE = 1 THEN
  MIXING_DAMPER_CMD = ACTIVE_MIN_OA_TARGET
  DAMPER_MODE_CODE = 1
  GOTO DAMPER_DONE
ENDIF

MIXING_DAMPER_CMD = 0
DAMPER_MODE_CODE = 0

'-----------------------------
' FINAL COMMAND LIMITS
'-----------------------------
DAMPER_DONE:

IF DAMPER_MODE_CODE = 1 THEN
  IF MIXING_DAMPER_CMD < DAMPER_MIN_POS THEN
    MIXING_DAMPER_CMD = DAMPER_MIN_POS
  ENDIF
ENDIF

IF MIXING_DAMPER_CMD > DAMPER_MAX_POS THEN
  MIXING_DAMPER_CMD = DAMPER_MAX_POS
ENDIF

' Allow true zero during shutdown / freeze / safety
IF DAMPER_MODE_CODE = 0 THEN
  MIXING_DAMPER_CMD = 0
ENDIF

IF DAMPER_MODE_CODE = 4 THEN
  MIXING_DAMPER_CMD = 0
ENDIF

IF DAMPER_MODE_CODE = 5 THEN
  MIXING_DAMPER_CMD = 0
ENDIF

WAIT 1
GOTO MAIN
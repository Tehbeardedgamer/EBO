
NUMERIC INPUT SPACE_TEMP,SA_FLOW_MAX, SA_FLOW_MIN, SPACE_CO2, COOLING_SP, HEATING_SP, CO2_SP,SA_FLOW_HEATING_MIN
NUMERIC OUTPUT SA_FLOW_SP
NUMERIC PK,IK, DK, OLDERR, OLDERR2, I_DAMPER, I_DAMPER2
NUMERIC PUBLIC ZONE_TEMP, ZONE_CO2
STRING MODE_VAV
FUNCTION PID_CTRL, GET_MODE

goto INITALIZE

INITALIZE:
	SA_FLOW_SP = 0
  MODE_VAV = "IDLE"
	PK = 1
	IK = 0.1
	DK = 0
	OLDERR = 0
	OLDERR2 = 0
	
	I_DAMPER = 0
	I_DAMPER2 = 0
	
    GOTO CONTROL_LOOP

CONTROL_LOOP:
       
    SELECT CASE TRUE
        'CALCULATIONS FOR COMMAND SIGNAL TO VAV
   CASE MODE_VAV = "IDLE"
		SA_FLOW_SP = SA_FLOW_MIN 

   CASE MODE_VAV = "COOLING"
    SA_FLOW_SP = MAXIMUM(((ZONE_TEMP/100) * SA_FLOW_MAX),SA_FLOW_MIN) 
	
		CASE MODE_VAV = "HEATING"
    SA_FLOW_SP = SA_FLOW_HEATING_MIN

   CASE MODE_VAV = "CO2"
    SA_FLOW_SP =  MAXIMUM(((ZONE_CO2/100) * SA_FLOW_MAX),SA_FLOW_MIN) 

    ENDSELECT
  GOTO SET_MODE_VAV
SET_MODE_VAV:
    ' Function Script to Determine OVAV Mode
    ' Args: SPACE_TEMP, TEMP_SP, SPACE_CO2, CO2_SP
    ' Returns: MODE as a String
    MODE_VAV = GET_MODE(SPACE_TEMP, COOLING_SP, HEATING_SP, SPACE_CO2, CO2_SP)
GOTO CALCULATE_SETPOINT

		CALCULATE_SETPOINT:
IF MODE_VAV = "COOLING" THEN ZONE_TEMP = PID_CTRL(1, SPACE_TEMP, COOLING_SP, I_DAMPER, PK, IK, DK, OLDERR)
IF MODE_VAV = "CO2" THEN 	ZONE_CO2 = PID_CTRL(1, SPACE_CO2, CO2_SP, I_DAMPER2, PK, IK, DK, OLDERR2)
    GOTO WAIT_LOOP

WAIT_LOOP:
    IF TS > 10 THEN GOTO CONTROL_LOOP
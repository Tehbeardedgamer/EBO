'==============================================================================
' DOAS_MASTER_CONTROL
'
' PURPOSE
'   Final output authority and startup / shutdown sequencing for DOAS 4A.
'
' HARDWIRED SAFETIES ACCOUNTED FOR
'   - LOW_TEMP_SAFETY
'   - HIGH_PRESS_SAFETY
'   - LOW_PRESS_SAFETY
'   - FIRE_ALARM
'   - EPO_CMD (front-end commanded EPO)
'
' STARTUP SEQUENCE
'   1. Verify occupied request and hardwired safeties
'   2. Enable ERW as required
'   3. Open EA damper D-3 and prove
'   4. Start exhaust fan array and prove
'   5. Pre-open CHW valve when required by sequence
'   6. Open OA damper D-1 and prove
'   7. Start supply fan array and prove
'   8. Enter run mode
'
' RUN MODE
'   - D-3 open whenever EA fan is running
'   - D-1 open whenever SA fan is running
'   - If any pair requests exhaust stop:
'       EA fan off
'       D-3 closed
'       ERW off
'       D-4 and D-5 open
'       SA side continues to operate
'
' OFF MODE
'   - Fans off
'   - D-1 / D-3 closed
'   - ERW off
'   - CHW valve closed
'   - HW valve follows off-mode cabinet protection request
'
' SAFETY MODE
'   - Fans off
'   - D-1 / D-3 closed
'   - ERW off
'   - CHW valve closed
'   - HW valve closed
'==============================================================================

NUMERIC INPUT UNIT_ENABLE
NUMERIC INPUT OCCUPIED_REQ
NUMERIC INPUT EPO_CMD

NUMERIC INPUT LOW_TEMP_SAFETY
NUMERIC INPUT HIGH_PRESS_SAFETY
NUMERIC INPUT LOW_PRESS_SAFETY
NUMERIC INPUT FIRE_ALARM

NUMERIC INPUT ERW_ENABLE_REQ
NUMERIC INPUT OA_BYPASS_REQ
NUMERIC INPUT EA_BYPASS_REQ
NUMERIC INPUT CHW_VALVE_REQ
NUMERIC INPUT HW_VALVE_REQ
NUMERIC INPUT COOL_PREOPEN_REQ

NUMERIC INPUT SA_FAN_SPEED_REQ
NUMERIC INPUT EA_FAN_SPEED_REQ

NUMERIC INPUT EXH_STOP_REQ_BA_BD
NUMERIC INPUT EXH_STOP_REQ_BB_BE
NUMERIC INPUT EXH_STOP_REQ_BC_BF

NUMERIC INPUT OA_DAMPER_FBK
NUMERIC INPUT EA_DAMPER_FBK
NUMERIC INPUT SA_ARRAY_PROOF
NUMERIC INPUT EA_ARRAY_PROOF

NUMERIC INPUT DAMPER_STROKE_TIME
NUMERIC INPUT FAN_PROOF_TIME
NUMERIC INPUT CHW_PREOPEN_TIME

NUMERIC OUTPUT OA_DAMPER_CMD
NUMERIC OUTPUT EA_DAMPER_CMD
NUMERIC OUTPUT OA_BYPASS_DAMPER_CMD
NUMERIC OUTPUT EA_BYPASS_DAMPER_CMD
NUMERIC OUTPUT ERW_SS
NUMERIC OUTPUT SA_FAN_SS
NUMERIC OUTPUT EA_FAN_SS
NUMERIC OUTPUT SA_FAN_SPEED_CMD
NUMERIC OUTPUT EA_FAN_SPEED_CMD
NUMERIC OUTPUT CHW_VALVE_CMD
NUMERIC OUTPUT HW_VALVE_CMD
NUMERIC OUTPUT UNIT_RUNNING
STRING OUTPUT CURRENT_TASK

NUMERIC SAFETY_OK
NUMERIC START_STATE
NUMERIC EXH_STOP_REQUEST

NUMERIC T_DAMPER
NUMERIC DONE_DAMPER
NUMERIC T_FAN
NUMERIC DONE_FAN
NUMERIC T_CHW
NUMERIC DONE_CHW

FUNCTION Sectimer

INIT:
OA_DAMPER_CMD = 0
EA_DAMPER_CMD = 0
OA_BYPASS_DAMPER_CMD = 0
EA_BYPASS_DAMPER_CMD = 0
ERW_SS = 0
SA_FAN_SS = 0
EA_FAN_SS = 0
SA_FAN_SPEED_CMD = 0
EA_FAN_SPEED_CMD = 0
CHW_VALVE_CMD = 0
HW_VALVE_CMD = 0
UNIT_RUNNING = 0
CURRENT_TASK = "OFF"
START_STATE = 0
GOTO MAIN

MAIN:
EXH_STOP_REQUEST = 0
IF EXH_STOP_REQ_BA_BD = 1 THEN EXH_STOP_REQUEST = 1
IF EXH_STOP_REQ_BB_BE = 1 THEN EXH_STOP_REQUEST = 1
IF EXH_STOP_REQ_BC_BF = 1 THEN EXH_STOP_REQUEST = 1

SAFETY_OK = 1
IF LOW_TEMP_SAFETY = 0 THEN SAFETY_OK = 0
IF HIGH_PRESS_SAFETY = 0 THEN SAFETY_OK = 0
IF LOW_PRESS_SAFETY = 0 THEN SAFETY_OK = 0
IF FIRE_ALARM = 1 THEN SAFETY_OK = 0
IF EPO_CMD = 1 THEN SAFETY_OK = 0

IF SAFETY_OK = 0 THEN GOTO SAFETY_SHUTDOWN

IF UNIT_ENABLE = 0 THEN GOTO NORMAL_OFF
IF OCCUPIED_REQ = 0 THEN GOTO NORMAL_OFF

IF START_STATE = 0 THEN GOTO START_ERW
IF START_STATE = 1 THEN GOTO START_EA_DAMPER
IF START_STATE = 2 THEN GOTO VERIFY_EA_DAMPER
IF START_STATE = 3 THEN GOTO START_EA_FAN
IF START_STATE = 4 THEN GOTO VERIFY_EA_FAN
IF START_STATE = 5 THEN GOTO PREOPEN_CHW
IF START_STATE = 6 THEN GOTO START_OA_DAMPER
IF START_STATE = 7 THEN GOTO VERIFY_OA_DAMPER
IF START_STATE = 8 THEN GOTO START_SA_FAN
IF START_STATE = 9 THEN GOTO VERIFY_SA_FAN
IF START_STATE = 10 THEN GOTO RUN_MODE

START_ERW:
CURRENT_TASK = "START_ERW"
UNIT_RUNNING = 0

ERW_SS = ERW_ENABLE_REQ
OA_BYPASS_DAMPER_CMD = OA_BYPASS_REQ
EA_BYPASS_DAMPER_CMD = EA_BYPASS_REQ

OA_DAMPER_CMD = 0
EA_DAMPER_CMD = 0
SA_FAN_SS = 0
EA_FAN_SS = 0
SA_FAN_SPEED_CMD = 0
EA_FAN_SPEED_CMD = 0
CHW_VALVE_CMD = 0
HW_VALVE_CMD = 0

START_STATE = 1
WAIT 1
GOTO MAIN

START_EA_DAMPER:
CURRENT_TASK = "OPEN_EA_DAMPER"

EA_DAMPER_CMD = 1
ERW_SS = ERW_ENABLE_REQ
OA_BYPASS_DAMPER_CMD = OA_BYPASS_REQ
EA_BYPASS_DAMPER_CMD = EA_BYPASS_REQ

T_DAMPER = 0
DONE_DAMPER = 0
START_STATE = 2
WAIT 1
GOTO MAIN

VERIFY_EA_DAMPER:
CURRENT_TASK = "VERIFY_EA_DAMPER"

EA_DAMPER_CMD = 1
DONE_DAMPER = Sectimer(1, DAMPER_STROKE_TIME, T_DAMPER, 0)

IF EA_DAMPER_FBK = 1 THEN
  START_STATE = 3
  WAIT 1
  GOTO MAIN
ENDIF

IF DONE_DAMPER = 1 THEN
  START_STATE = 0
  GOTO NORMAL_OFF
ENDIF

WAIT 1
GOTO MAIN

START_EA_FAN:
CURRENT_TASK = "START_EA_FAN"

EA_DAMPER_CMD = 1
EA_FAN_SS = 1
EA_FAN_SPEED_CMD = EA_FAN_SPEED_REQ
ERW_SS = ERW_ENABLE_REQ
OA_BYPASS_DAMPER_CMD = OA_BYPASS_REQ
EA_BYPASS_DAMPER_CMD = EA_BYPASS_REQ

T_FAN = 0
DONE_FAN = 0
START_STATE = 4
WAIT 1
GOTO MAIN

VERIFY_EA_FAN:
CURRENT_TASK = "VERIFY_EA_FAN"

EA_DAMPER_CMD = 1
EA_FAN_SS = 1
EA_FAN_SPEED_CMD = EA_FAN_SPEED_REQ
DONE_FAN = Sectimer(1, FAN_PROOF_TIME, T_FAN, 0)

IF EA_ARRAY_PROOF = 1 THEN
  START_STATE = 5
  WAIT 1
  GOTO MAIN
ENDIF

IF DONE_FAN = 1 THEN
  START_STATE = 0
  GOTO NORMAL_OFF
ENDIF

WAIT 1
GOTO MAIN

PREOPEN_CHW:
CURRENT_TASK = "PREOPEN_CHW"

EA_DAMPER_CMD = 1
EA_FAN_SS = 1
EA_FAN_SPEED_CMD = EA_FAN_SPEED_REQ
ERW_SS = ERW_ENABLE_REQ
OA_BYPASS_DAMPER_CMD = OA_BYPASS_REQ
EA_BYPASS_DAMPER_CMD = EA_BYPASS_REQ

IF COOL_PREOPEN_REQ = 1 THEN
  CHW_VALVE_CMD = 100
  DONE_CHW = Sectimer(1, CHW_PREOPEN_TIME, T_CHW, 0)

  IF DONE_CHW = 0 THEN
    WAIT 1
    GOTO MAIN
  ENDIF
ENDIF

START_STATE = 6
WAIT 1
GOTO MAIN

START_OA_DAMPER:
CURRENT_TASK = "OPEN_OA_DAMPER"

OA_DAMPER_CMD = 1
EA_DAMPER_CMD = 1
EA_FAN_SS = 1
EA_FAN_SPEED_CMD = EA_FAN_SPEED_REQ
ERW_SS = ERW_ENABLE_REQ
OA_BYPASS_DAMPER_CMD = OA_BYPASS_REQ
EA_BYPASS_DAMPER_CMD = EA_BYPASS_REQ

T_DAMPER = 0
DONE_DAMPER = 0
START_STATE = 7
WAIT 1
GOTO MAIN

VERIFY_OA_DAMPER:
CURRENT_TASK = "VERIFY_OA_DAMPER"

OA_DAMPER_CMD = 1
EA_DAMPER_CMD = 1
EA_FAN_SS = 1
EA_FAN_SPEED_CMD = EA_FAN_SPEED_REQ
DONE_DAMPER = Sectimer(1, DAMPER_STROKE_TIME, T_DAMPER, 0)

IF OA_DAMPER_FBK = 1 THEN
  START_STATE = 8
  WAIT 1
  GOTO MAIN
ENDIF

IF DONE_DAMPER = 1 THEN
  START_STATE = 0
  GOTO NORMAL_OFF
ENDIF

WAIT 1
GOTO MAIN

START_SA_FAN:
CURRENT_TASK = "START_SA_FAN"

OA_DAMPER_CMD = 1
EA_DAMPER_CMD = 1
SA_FAN_SS = 1
EA_FAN_SS = 1
SA_FAN_SPEED_CMD = SA_FAN_SPEED_REQ
EA_FAN_SPEED_CMD = EA_FAN_SPEED_REQ
ERW_SS = ERW_ENABLE_REQ
OA_BYPASS_DAMPER_CMD = OA_BYPASS_REQ
EA_BYPASS_DAMPER_CMD = EA_BYPASS_REQ
CHW_VALVE_CMD = CHW_VALVE_REQ
HW_VALVE_CMD = HW_VALVE_REQ

T_FAN = 0
DONE_FAN = 0
START_STATE = 9
WAIT 1
GOTO MAIN

VERIFY_SA_FAN:
CURRENT_TASK = "VERIFY_SA_FAN"

OA_DAMPER_CMD = 1
EA_DAMPER_CMD = 1
SA_FAN_SS = 1
EA_FAN_SS = 1
SA_FAN_SPEED_CMD = SA_FAN_SPEED_REQ
EA_FAN_SPEED_CMD = EA_FAN_SPEED_REQ
ERW_SS = ERW_ENABLE_REQ
OA_BYPASS_DAMPER_CMD = OA_BYPASS_REQ
EA_BYPASS_DAMPER_CMD = EA_BYPASS_REQ
CHW_VALVE_CMD = CHW_VALVE_REQ
HW_VALVE_CMD = HW_VALVE_REQ

DONE_FAN = Sectimer(1, FAN_PROOF_TIME, T_FAN, 0)

IF SA_ARRAY_PROOF = 1 THEN
  START_STATE = 10
  WAIT 1
  GOTO MAIN
ENDIF

IF DONE_FAN = 1 THEN
  START_STATE = 0
  GOTO NORMAL_OFF
ENDIF

WAIT 1
GOTO MAIN

RUN_MODE:
CURRENT_TASK = "RUN"
UNIT_RUNNING = 1

OA_DAMPER_CMD = 1
EA_DAMPER_CMD = 1
OA_BYPASS_DAMPER_CMD = OA_BYPASS_REQ
EA_BYPASS_DAMPER_CMD = EA_BYPASS_REQ
ERW_SS = ERW_ENABLE_REQ
SA_FAN_SS = 1
EA_FAN_SS = 1
SA_FAN_SPEED_CMD = SA_FAN_SPEED_REQ
EA_FAN_SPEED_CMD = EA_FAN_SPEED_REQ
CHW_VALVE_CMD = CHW_VALVE_REQ
HW_VALVE_CMD = HW_VALVE_REQ

IF EXH_STOP_REQUEST = 1 THEN
  EA_DAMPER_CMD = 0
  EA_FAN_SS = 0
  EA_FAN_SPEED_CMD = 0
  ERW_SS = 0
  OA_BYPASS_DAMPER_CMD = 1
  EA_BYPASS_DAMPER_CMD = 1
ENDIF

WAIT 1
GOTO MAIN

NORMAL_OFF:
CURRENT_TASK = "OFF"
START_STATE = 0
UNIT_RUNNING = 0

OA_DAMPER_CMD = 0
EA_DAMPER_CMD = 0
OA_BYPASS_DAMPER_CMD = 0
EA_BYPASS_DAMPER_CMD = 0
ERW_SS = 0
SA_FAN_SS = 0
EA_FAN_SS = 0
SA_FAN_SPEED_CMD = 0
EA_FAN_SPEED_CMD = 0
CHW_VALVE_CMD = 0
HW_VALVE_CMD = HW_VALVE_REQ

WAIT 1
GOTO MAIN

SAFETY_SHUTDOWN:
CURRENT_TASK = "SAFETY_SHUTDOWN"
START_STATE = 0
UNIT_RUNNING = 0

OA_DAMPER_CMD = 0
EA_DAMPER_CMD = 0
OA_BYPASS_DAMPER_CMD = 0
EA_BYPASS_DAMPER_CMD = 0
ERW_SS = 0
SA_FAN_SS = 0
EA_FAN_SS = 0
SA_FAN_SPEED_CMD = 0
EA_FAN_SPEED_CMD = 0
CHW_VALVE_CMD = 0
HW_VALVE_CMD = 0

WAIT 1
GOTO MAIN

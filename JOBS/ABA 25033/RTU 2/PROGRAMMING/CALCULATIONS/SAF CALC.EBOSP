NUMERIC INPUT DUCT_PRESS, DUCT_PRESS_SP,BUILDING_PRESSURE_A, RTU_STATUS
NUMERIC OUTPUT SAF_SPEED_CALC,DP_A
NUMERIC OLDERR,PK,IK,DK,I_FAN
FUNCTION PID_CTRL

GOTO INITALIZE

INITALIZE:
OLDERR = 0
PK =1.0
IK = 0.10
DK = 0.01
I_FAN = 50

GOTO CONTROL_LOOP

CONTROL_LOOP:
IF RTU_STATUS = 1 THEN
DP_A = BUILDING_PRESSURE_A
SAF_SPEED_CALC = PID_CTRL(0,DUCT_PRESS, DUCT_PRESS_SP, I_FAN,PK,IK,DK,OLDERR)
Else
SAF_SPEED_CALC = 0
I_FAN = 0
ENDIF
Wait 3



'P-1A/B/C/D/E/F/G
NUMERIC INPUT FAILED_A,MAINTENANCE_A
NUMERIC INPUT FAILED_B,MAINTENANCE_B
NUMERIC INPUT FAILED_C,MAINTENANCE_C
NUMERIC INPUT FAILED_D,MAINTENANCE_D
NUMERIC INPUT FAILED_E,MAINTENANCE_E
NUMERIC INPUT FAILED_F,MAINTENANCE_F
NUMERIC INPUT FAILED_G,MAINTENANCE_G


NUMERIC PUMP_A[2], PUMP_B[2], PUMP_C[2], PUMP_D[2], PUMP_E[2], PUMP_F[2], PUMP_G[2]
NUMERIC DOWN[7]

NUMERIC OUTPUT DOWN_A, DOWN_B, DOWN_C, DOWN_D, DOWN_E, DOWN_F, DOWN_G
NUMERIC OUTPUT PUMPS_DOWN

GOTO CHECK_DOWNS

CHECK_DOWNS:
PUMP_A[1] = MAINTENANCE_A
PUMP_A[2] = FAILED_A


PUMP_B[1] = MAINTENANCE_B
PUMP_B[2] = FAILED_B


PUMP_C[1] = MAINTENANCE_C
PUMP_C[2] = FAILED_C


PUMP_D[1] = MAINTENANCE_D
PUMP_D[2] = FAILED_D


PUMP_E[1] = MAINTENANCE_E
PUMP_E[2] = FAILED_E


PUMP_F[1] = MAINTENANCE_F
PUMP_F[2] = FAILED_F


PUMP_G[1] = MAINTENANCE_G
PUMP_G[2] = FAILED_G




GOTO CALCULATE_AVAILABILITY

CALCULATE_AVAILABILITY:
IF SUM(PUMP_A) > 0 THEN DOWN_A = 1 ELSE DOWN_A = 0
IF SUM(PUMP_B) > 0 THEN DOWN_B = 1 ELSE DOWN_B = 0
IF SUM(PUMP_C) > 0 THEN DOWN_C = 1 ELSE DOWN_C = 0
IF SUM(PUMP_D) > 0 THEN DOWN_D = 1 ELSE DOWN_D = 0
IF SUM(PUMP_E) > 0 THEN DOWN_E = 1 ELSE DOWN_E = 0
IF SUM(PUMP_F) > 0 THEN DOWN_F = 1 ELSE DOWN_F = 0
IF SUM(PUMP_G) > 0 THEN DOWN_G = 1 ELSE DOWN_G = 0


DOWN[1] = DOWN_A
DOWN[2] = DOWN_B
DOWN[3] = DOWN_C
DOWN[4] = DOWN_D
DOWN[5] = DOWN_E
DOWN[6] = DOWN_F
DOWN[7] = DOWN_G


PUMPS_DOWN = SUM(DOWN)

GOTO WAIT_LOOP

WAIT_LOOP:
IF TS > 30 THEN GOTO CHECK_DOWNS
